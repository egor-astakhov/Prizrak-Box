// Shared UI state written by Rust (src/app/*.rs) — the Slint counterpart of
// the pinia stores the Vue app used.

export struct Toast {
    id: int,
    kind: string, // success | error | warning | info
    text: string,
}

export struct DdEntry {
    name: string,
    label: string,
    icon: image,
    has-icon: bool,
    tip: string,
    selected: bool,
    delay: int,
    delay-text: string,
    delay-tone: int,
}

export global App {
    // routing (menuStore.menu / settingTab / sub-pages)
    in-out property <string> menu: "Home";
    in-out property <string> setting-tab: "app";
    in-out property <string> setting-sub: ""; // "" | dns | shortcut
    callback navigate(string);
    callback set-setting-tab(string);
    callback open-sub(string);

    // brand
    in property <string> top-title: "Prizrak-Box";
    in property <image> top-logo;

    // mode pill (MyRule.vue)
    in property <string> rule: "rule";
    in property <bool> hide-mode-switch: false;
    in property <bool> show-direct: true;
    callback set-rule(string);

    // proxy / TUN switches (MyProxy.vue)
    in property <bool> proxy-on: false;
    in property <bool> tun-on: false;
    in property <int> proxy-pulse: 0;
    in property <int> tun-pulse: 0;
    callback toggle-proxy();
    callback toggle-tun();
    in-out property <bool> service-dialog: false;
    in-out property <bool> admin-choice-dialog: false;
    callback install-service();
    callback run-tun-without-service();

    // window controls (MyTitleBar.vue)
    in property <bool> maximized: false;
    callback win-hide();
    callback win-min();
    callback win-max();
    callback win-close();
    callback start-drag();
    callback start-resize(int);
    callback titlebar-double-click();

    // quit (Off.vue)
    in-out property <bool> quit-dialog: false;
    callback quit();

    // language (Language.vue)
    in property <string> language: "en";
    callback set-language(string);

    // toasts + blocking loading overlay (components/ui/services.ts)
    in property <[Toast]> toasts;
    callback dismiss-toast(int);
    in property <bool> loading: false;
    in property <string> loading-text;

    // confirm() dialog (UiConfirm.vue)
    in property <bool> confirm-open: false;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <image> confirm-icon;
    callback confirm-result(bool);

    // update notice (App.vue)
    in property <bool> update-dialog: false;
    in property <string> update-version;
    callback update-dismiss();
    callback update-open();

    // HWID dialogs
    in property <string> hwid-error: ""; // "" | not-supported | max-devices
    in property <string> hwid-support-url;
    callback hwid-close();
    callback hwid-open-support();

    // deep-link import overlay
    in property <bool> deeplink-importing: false;
    in property <string> deeplink-message;
    in property <string> deeplink-cancel;
    callback deeplink-cancel-clicked();

    // subscription alert modal
    in property <bool> sub-alert-open: false;
    in property <string> sub-alert-title;
    in property <string> sub-alert-text;
    in property <string> sub-alert-profile;
    in property <image> sub-alert-logo;
    in property <bool> sub-alert-renew: false;
    callback sub-alert-close();
    callback sub-alert-renew-clicked();

    // first profile info
    in-out property <bool> first-profile-info: false;
    callback first-profile-ok();

    // file drop / "open file" (MyDrop.vue)
    in-out property <bool> drop-open: false;
    callback pick-profile-file();

    in property <bool> backend-ready: false;
    in property <string> os-label;
    callback open-url(string);
}

// Header proxy selector (MySearch.vue)
export global Search {
    // Snapshot aid: bumping it opens the header proxy list.
    in property <int> debug-open-proxies: 0;
    in property <string> group;
    in property <image> group-icon;
    in property <bool> group-has-icon;
    in property <image> group-type-icon;
    in property <string> group-type-tip;
    in property <string> proxy;
    in property <int> proxy-tone;
    in property <[DdEntry]> groups;
    in property <[DdEntry]> proxies;
    callback open-groups();
    callback open-proxies();
    callback pick-group(string);
    callback pick-proxy(string);
}
