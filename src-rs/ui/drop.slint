// "Open file" overlay (MyDrop.vue) and the age key prompt for .age files.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { Icon, Btn, Modal, ModalBody, ModalFooter, Input, Backdrop, ScrimLayer } from "components.slint";

export global DropP {
    callback open-picker();
    in-out property <bool> age-open;
    in-out property <string> age-key;
    callback age-confirm();
    callback age-cancel();
}

export component DropOverlay inherits Rectangle {
    if App.drop-open: Rectangle {
        visible: dscrim.ready && !dscrim.hidden-for-capture;
        dscrim := ScrimLayer { }
        TouchArea { clicked => { App.drop-open = false; } }
        VerticalLayout {
            alignment: center;
            spacing: 20px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(400px, root.width - 40px);
                    height: zl.preferred-height;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: Theme.border;
                    background: Theme.dialog-bg;
                    drop-shadow-blur: 60px;
                    drop-shadow-offset-y: 24px;
                    drop-shadow-color: #00000066;
                    TouchArea { }
                    zl := VerticalLayout {
                        padding-top: 34px;
                        padding-bottom: 34px;
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 10px;
                        HorizontalLayout { alignment: center; Icon { source: Icons.cloud-upload; size: 32px; tint: Theme.text-3; } }
                        Text { text: T.t("drag.hear"); font-size: 14px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                        Text { text: T.t("drag.formats"); font-size: 12px; color: Theme.text-3; horizontal-alignment: center; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Btn {
                    text: T.t("drag.open");
                    icon: Icons.folder-open;
                    kind: "primary";
                    pill: true;
                    clicked => { DropP.open-picker(); }
                }
            }
        }
    }
    Modal {
        opened => { first-field.focus-input(); }
        open <=> DropP.age-open;
        title: T.t("age.file.title");
        icon: Icons.key;
        max-w: 420px;
        close-on-overlay: false;
        closed => { DropP.age-cancel(); }
        ModalBody {
            Text { text: T.t("age.file.hint"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
            first-field := Input {
                text <=> DropP.age-key;
                icon: Icons.key;
                placeholder: T.t("age.profile.keyPlaceholder");
                accepted => { DropP.age-confirm(); }
            }
        }
        ModalFooter {
            Btn { text: T.t("cancel"); clicked => { DropP.age-cancel(); } }
            Btn { text: T.t("confirm.label"); kind: "primary"; enabled: DropP.age-key != ""; clicked => { DropP.age-confirm(); } }
        }
    }
}
