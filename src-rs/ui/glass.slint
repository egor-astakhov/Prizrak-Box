// Backdrop blur emulation (CSS `backdrop-filter: blur()`): the background is a
// static `cover` image, so Rust pre-blurs it once (Theme.bg-blur) and every
// translucent surface paints its own window-aligned slice of that copy (plus
// the dimming overlay) under its fill.
import { Theme } from "theme.slint";

export component Glass inherits Rectangle {
    in property <bool> enabled: true;
    in property <color> fill: Theme.panel-bg;
    clip: true;
    background: self.fill;
    // The slice is clipped to the element's own rounded shape here, not by
    // the root: some glass elements turn clipping off (SearchPill for its
    // popups, ModeButton for the pulse), and an unclipped window-sized slice
    // would paint over everything drawn before it.
    if root.enabled && Theme.use-image && Theme.has-blur: Rectangle {
        clip: true;
        border-radius: root.border-radius;
        // Zero-size anchor: keeps the window-sized slice out of the element's
        // implicit layout constraints (a button would grow to the window).
        Rectangle {
            x: 0;
            y: 0;
            width: 0;
            height: 0;
            Rectangle {
                x: -root.absolute-position.x;
                y: -root.absolute-position.y;
                width: Theme.win-w;
                height: Theme.win-h;
                Image {
                    width: 100%;
                    height: 100%;
                    source: Theme.bg-blur;
                    image-fit: cover;
                }
                Rectangle {
                    background: Theme.overlay;
                }
            }
        }
    }
    if root.enabled && Theme.use-image && Theme.has-blur: Rectangle {
        background: root.fill;
        border-radius: root.border-radius;
    }
    @children
}
