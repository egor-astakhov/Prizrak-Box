import "../assets/fonts/TwemojiCountryFlags.ttf";
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App, Search, Toast, DdEntry } from "state.slint";
import { Glass } from "glass.slint";
import { TooltipLayer, Tip, SelectHelper, CodeHelper, Backdrop, PopupTip, SelectOption, PillOption } from "components.slint";
import { Sidebar, Header, ToastLayer, LoadingLayer, GlobalDialogs, DragZone, ThemeDialog } from "shell.slint";
import { HomePage, HomeP, AddProfile, AddProfileDialog, AnnounceLine, AnnounceSeg } from "home.slint";
import { ProxiesPage, ProxiesP, ProxyGroupView, ProxyNodeView } from "proxies.slint";
import { ProfilesPage, ProfilesDialogs, ProfilesP, ProfileView } from "profiles.slint";
import { SettingPage } from "setting_page.slint";
import { DropOverlay, DropP } from "drop.slint";
import { ThemeDialogView, ThemeP, BgTile } from "theme_dialog.slint";
import { RulesP, RuleRow, ProviderView, RulesDialogs } from "rules.slint";
import { ConnDialogs, ConnP, LogsP, ConnRow, ProcRow, LogKV, LogSection, TopoNode, TopoLink, LogLine } from "conn.slint";
import { SettingsP, TestUrlRow, DnsRecord, DashboardRow, DashboardsDialog, AgeDialog } from "settings.slint";

export { Theme, T, App, Search, HomeP, AddProfile, Tip, SelectHelper, CodeHelper, Backdrop, PopupTip, ThemeDialog, ProxiesP, ProfilesP, SettingsP, DropP, RulesP, ConnP, LogsP, ThemeP }
export { Toast, DdEntry, AnnounceLine, AnnounceSeg, SelectOption, PillOption, ProxyGroupView, ProxyNodeView, ProfileView, TestUrlRow, DnsRecord, DashboardRow, RuleRow, ProviderView, ConnRow, ProcRow, LogKV, LogSection, TopoNode, TopoLink, LogLine, BgTile }

export component AppWindow inherits Window {
    title: "Prizrak-Box";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 660px;
    no-frame: !Theme.is-mac;
    // The web shells' stack is `Twemoji, -apple-system, 'Segoe UI', …`:
    // - macOS: the system font (SF), as -apple-system; Slint's own default
    //   would be Helvetica (other metrics: text sat ~1.5px high in pills).
    //   Flags come from Apple Color Emoji (CoreText does not draw COLR).
    // - Windows / Linux: the bundled Twemoji subset first for country flags
    //   (Windows has no flag emoji), everything else falls through to the
    //   system UI font (Segoe UI via SLINT_FONT_PATH, see main.rs).
    default-font-family: Theme.is-mac ? ".SF NS" : "Twemoji Mozilla";
    background: Theme.app-bg;
    icon: @image-url("../assets/appicon.png");
    changed width => { Theme.win-w = self.width; }
    changed height => { Theme.win-h = self.height; }
    init => {
        Theme.win-w = self.width;
        Theme.win-h = self.height;
    }

    // background image + dimming overlay (App.vue .app-bg)
    if Theme.use-image: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        Image {
            width: 100%;
            height: 100%;
            source: Theme.bg-image;
            image-fit: cover;
        }
        Rectangle { background: Theme.overlay; }
    }

    Sidebar {
        x: 0;
        y: 0;
        width: 228px;
        height: root.height;
    }

    Header {
        x: 228px;
        y: 0;
        width: root.width - 228px;
        height: 64px;
    }

    main := Glass {
        x: 228px;
        y: 64px;
        width: root.width - 228px - 14px;
        height: root.height - 64px - 14px;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 50px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #00000040;
        fill: Theme.panel-bg;
        if App.menu == "Home": HomePage { }
        if App.menu == "Proxies": ProxiesPage { }
        if App.menu == "Profiles": ProfilesPage { }
        if App.menu == "Setting": SettingPage { }
    }

    // Page dialogs live at window level: the scrim covers the sidebar and the
    // header too and the card is centred on the window, as UiModal does.
    ProfilesDialogs { x: 0; y: 0; width: root.width; height: root.height; }
    RulesDialogs { x: 0; y: 0; width: root.width; height: root.height; }
    ConnDialogs { x: 0; y: 0; width: root.width; height: root.height; }
    DashboardsDialog { x: 0; y: 0; width: root.width; height: root.height; }
    AgeDialog { x: 0; y: 0; width: root.width; height: root.height; }

    // Overlays get explicit geometry so their own size limits (modal max-width…)
    // do not leak into the window's resize constraints.
    AddProfileDialog { x: 0; y: 0; width: root.width; height: root.height; }
    DropOverlay { x: 0; y: 0; width: root.width; height: root.height; }
    ThemeDialogView { x: 0; y: 0; width: root.width; height: root.height; }
    GlobalDialogs { x: 0; y: 0; width: root.width; height: root.height; }
    ToastLayer { x: 0; y: 0; width: root.width; height: root.height; }
    LoadingLayer { x: 0; y: 0; width: root.width; height: root.height; }
    TooltipLayer { x: 0; y: 0; width: root.width; height: root.height; }

    // frameless resize edges (Windows / Linux)
    if !Theme.is-mac: TouchArea { x: 0; y: 0; width: 6px; height: root.height; mouse-cursor: ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { App.start-resize(3); } } }
    if !Theme.is-mac: TouchArea { x: root.width - 6px; y: 0; width: 6px; height: root.height; mouse-cursor: ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { App.start-resize(4); } } }
    if !Theme.is-mac: TouchArea { x: 0; y: 0; width: root.width; height: 4px; mouse-cursor: ns-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { App.start-resize(1); } } }
    if !Theme.is-mac: TouchArea { x: 0; y: root.height - 6px; width: root.width; height: 6px; mouse-cursor: ns-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { App.start-resize(2); } } }
    if !Theme.is-mac: TouchArea { x: root.width - 10px; y: root.height - 10px; width: 10px; height: 10px; mouse-cursor: nwse-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { App.start-resize(8); } } }
    if !Theme.is-mac: TouchArea { x: 0; y: root.height - 10px; width: 10px; height: 10px; mouse-cursor: nesw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { App.start-resize(7); } } }
}
