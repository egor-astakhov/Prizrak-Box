// Settings page — port of views/Setting.vue, components/setting/*,
// views/setting/Dns.vue, views/setting/Shortcut.vue.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { Icon, IconButton, Btn, TipZone, Spinner, ScrollArea, Modal, ModalBody, ModalFooter, Divider, Input, Select, SelectOption, PillTabs, PillOption, Switch, Tag, Card, InfoTip, RowLabel, FieldLabel, FieldHint, Alert, TextArea, DdPanel, DdItem, DdSep } from "components.slint";

export struct TestUrlRow {
    name: string,
    url: string,
}

export struct DnsRecord {
    kind: string,
    data: string,
    ttl: string,
}

export struct DashboardRow {
    name: string,
    url: string,
}

export global SettingsP {
    // ---- Mihomo card (core) ----
    in property <string> core-version;
    in property <int> port;
    in property <string> bind;
    in-out property <bool> port-editing;
    in-out property <string> port-input;
    in-out property <bool> bind-editing;
    in-out property <string> bind-input;
    callback save-port();
    callback save-bind();
    in property <string> stack: "Mixed";
    callback set-stack(string);
    in property <string> api-url;
    in property <string> secret;
    in-out property <bool> secret-visible;
    callback copy(string);
    in property <[DashboardRow]> dashboards;
    callback open-dashboard(int);
    in property <bool> dns;
    callback set-dns(bool);
    in property <bool> ipv6;
    callback set-ipv6(bool);
    in property <bool> independent;
    callback set-independent(bool);
    in property <[TestUrlRow]> test-urls;
    callback test-url-edited(int, string, string);
    callback test-url-add();
    callback test-url-remove(int);
    in-out property <string> dns-query;
    in-out property <string> dns-type: "A";
    in property <bool> dns-loading;
    in property <string> dns-error;
    in property <[DnsRecord]> dns-results;
    callback run-dns-query();
    // ---- Prizrak-Box card (app) ----
    in property <string> update-text;
    in property <string> update-tone;
    in property <bool> update-checking;
    callback check-updates();
    callback open-releases();
    in property <string> service-text;
    in property <string> service-tone;
    in property <bool> service-installed;
    in property <bool> service-loading;
    callback service-install();
    callback service-uninstall();
    callback service-refresh();
    in property <bool> hwid;
    in property <string> hwid-tip;
    callback set-hwid(bool);
    in property <bool> startup;
    callback set-startup(bool);
    in property <bool> start-minimized;
    callback set-start-minimized(bool);
    in property <bool> system-proxy-mode;
    callback set-system-proxy-mode(bool);
    in property <bool> auth;
    callback set-auth(bool);
    in property <bool> shortcut;
    callback set-shortcut(bool);
    in property <bool> sub-alerts;
    callback set-sub-alerts(bool);
    callback open-config-dir();
    callback change-config-dir();
    callback import-file();
    // ---- dashboards dialog ----
    in-out property <bool> dash-open;
    in-out property <string> dash-name;
    in-out property <string> dash-url;
    in property <string> dash-error;
    in property <int> dash-editing: -1;
    in property <[DashboardRow]> custom-dashboards;
    callback dash-submit();
    callback dash-cancel();
    callback dash-edit(int);
    callback dash-remove(int);
    // ---- age keypair ----
    in-out property <bool> age-open;
    in property <string> age-type: "mlkem768-x25519";
    in property <bool> age-loading;
    in property <string> age-error;
    in property <string> age-public;
    in property <string> age-secret;
    in property <bool> age-copied-pub;
    in property <bool> age-copied-sec;
    callback age-set-type(string);
    callback age-regenerate();
    callback age-copy(bool);
    // ---- DNS editor (Setting/Dns) ----
    in-out property <string> dns-yaml;
    in property <bool> dns-dirty;
    in property <bool> dns-saving;
    in property <bool> dns-saved;
    callback dns-reload();
    callback dns-save();
    callback dns-edited(string);
    // ---- shortcut ----
    in property <string> hotkey;
    in-out property <bool> hotkey-recording;
    in property <bool> hotkey-mac-warning;
    callback hotkey-record(string, bool, bool, bool, bool);
    // ---- log level (Log tab header) ----
    in property <string> log-level: "info";
    callback set-log-level(string);
}

// ---- header with section pills (SettingsHeader.vue) ----
export component SettingsHeader inherits HorizontalLayout {
    in property <string> sub;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 24px;
    padding-bottom: 12px;
    spacing: 12px;
    if root.sub != "": VerticalLayout {
        alignment: center;
        IconButton {
            round: true;
            soft: true;
            size: 34px;
            icon: Icons.arrow-left;
            icon-size: 17px;
            tip: T.t("connections.back");
            clicked => {
                App.set-setting-tab(root.sub == "dns" ? "core" : "app");
            }
        }
    }
    VerticalLayout {
        alignment: center;
        PillTabs {
            options: [
                { value: "app", icon: Icons.settings, tip: T.t("setting.tab.app") },
                { value: "core", icon: Icons.cpu, tip: T.t("setting.tab.core") },
                { value: "rule", icon: Icons.git-branch, tip: T.t("sec-nav.rule") },
                { value: "connection", icon: Icons.wifi, tip: T.t("sec-nav.conn") },
                { value: "log", icon: Icons.file-text, tip: T.t("sec-nav.log") },
            ];
            current: root.sub != "" ? (root.sub == "dns" ? "core" : "app") : App.setting-tab;
            select(v) => { App.set-setting-tab(v); }
        }
    }
    Text {
        text: T.t("setting.section." + (root.sub != "" ? root.sub : App.setting-tab));
        font-size: 24px;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 0;
    }
    // The page's own controls follow the title (SettingsHeader <slot/>); the
    // free space stays at the end of the row.
    @children
    Rectangle { horizontal-stretch: 1; }
}

component Row inherits HorizontalLayout {
    spacing: 10px;
    min-height: 24px;
}

component RowValue inherits Text {
    font-size: 13px;
    color: Theme.text-2;
    vertical-alignment: center;
}

component EditInput inherits Input {
    width: 140px;
    small: true;
    accent-border: true;
    horizontal-stretch: 0;
    background: Theme.panel-soft;
}

component SectionCard inherits Card {
    in property <string> title;
    in property <string> tag;
    in property <string> tag-tone;
    in property <bool> tag-spinner;
    in property <string> tag-tip;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 18px;
        padding-bottom: 18px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 10px;
            Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
            if root.tag != "": VerticalLayout {
                alignment: center;
                Tag {
                    text: root.tag;
                    tone: root.tag-tone;
                    spinner: root.tag-spinner;
                    TipZone { tip: root.tag-tip; mouse-cursor: default; }
                }
            }
        }
        Rectangle { height: 12px; }
        Divider { }
        Rectangle { height: 12px; }
        VerticalLayout {
            spacing: 14px;
            @children
        }
    }
}

export component CoreSection inherits SectionCard {
    title: "Mihomo";
    tag: SettingsP.core-version;
    tag-tip: T.t("setting.mihomo.core-version-tip");
    // MyPort.vue
    Row {
        RowLabel { text: T.t("setting.mihomo.port"); }
        if SettingsP.port-editing: EditInput {
            text <=> SettingsP.port-input;
            accepted => { SettingsP.save-port(); }
            handles-escape: true;
            escape => { SettingsP.port-editing = false; }
        }
        if SettingsP.port-editing: VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.check; tint-override: Theme.success; tip: T.t("save"); clicked => { SettingsP.save-port(); } } }
        if SettingsP.port-editing: VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.x; tip: T.t("cancel"); clicked => { SettingsP.port-editing = false; } } }
        if !SettingsP.port-editing: RowValue { text: SettingsP.port; }
        if !SettingsP.port-editing: VerticalLayout {
            alignment: center;
            IconButton {
                size: 26px;
                icon: Icons.edit;
                icon-size: 14px;
                tip: T.t("edit");
                clicked => {
                    SettingsP.port-input = SettingsP.port;
                    SettingsP.port-editing = true;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // MyBind.vue
    Row {
        RowLabel { text: T.t("setting.mihomo.bindAddress"); }
        if SettingsP.bind-editing: EditInput {
            text <=> SettingsP.bind-input;
            accepted => { SettingsP.save-bind(); }
            handles-escape: true;
            escape => { SettingsP.bind-editing = false; }
        }
        if SettingsP.bind-editing: VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.check; tint-override: Theme.success; tip: T.t("save"); clicked => { SettingsP.save-bind(); } } }
        if SettingsP.bind-editing: VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.x; tip: T.t("cancel"); clicked => { SettingsP.bind-editing = false; } } }
        if !SettingsP.bind-editing: RowValue { text: SettingsP.bind; }
        if !SettingsP.bind-editing: VerticalLayout {
            alignment: center;
            IconButton {
                size: 26px;
                icon: Icons.edit;
                icon-size: 14px;
                tip: T.t("edit");
                clicked => {
                    SettingsP.bind-input = SettingsP.bind;
                    SettingsP.bind-editing = true;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // MyTun.vue
    Row {
        RowLabel { text: "Tun Stack"; }
        VerticalLayout {
            alignment: center;
            PillTabs {
                options: [{ value: "Mixed", label: "Mixed" }, { value: "gVisor", label: "gVisor" }, { value: "System", label: "System" }, { value: "Mips", label: "Mips" }];
                current: SettingsP.stack;
                select(v) => { SettingsP.set-stack(v); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // Api
    Row {
        RowLabel { text: "Api"; }
        RowValue { text: SettingsP.api-url; overflow: elide; horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Btn { text: T.t("copy.title"); kind: "soft"; small: true; clicked => { SettingsP.copy(SettingsP.api-url); } }
            db := Btn {
                text: T.t("setting.dashboard.open");
                icon: Icons.layout-dashboard;
                trail-icon: Icons.chevron-down;
                kind: "soft";
                small: true;
                clicked => { dp.show(); }
                dp := PopupWindow {
                    x: db.width - 220px;
                    y: db.height + 8px;
                    width: 220px;
                    height: dcol.preferred-height + 10px;
                    close-policy: close-on-click-outside;
                    DdPanel {
                        dcol := VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            for d[i] in SettingsP.dashboards: DdItem {
                                text: d.name;
                                trail-icon: Icons.external-link;
                                clicked => {
                                    dp.close();
                                    SettingsP.open-dashboard(i);
                                }
                            }
                            DdSep { }
                            DdItem {
                                text: T.t("setting.dashboard.manage");
                                icon: Icons.settings;
                                clicked => {
                                    dp.close();
                                    SettingsP.dash-open = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Secret
    Row {
        RowLabel { text: "Secret"; tip: T.t("setting.tips.secret"); }
        RowValue {
            text: SettingsP.secret-visible ? SettingsP.secret : "••••••••••••";
            font-family: Theme.mono;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                size: 26px;
                icon: SettingsP.secret-visible ? Icons.eye-off : Icons.eye;
                icon-size: 14px;
                tip: SettingsP.secret-visible ? T.t("ui.hide") : T.t("ui.show");
                clicked => { SettingsP.secret-visible = !SettingsP.secret-visible; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Btn { text: T.t("copy.title"); kind: "soft"; small: true; clicked => { SettingsP.copy(SettingsP.secret); } }
    }
    Row {
        RowLabel { text: T.t("setting.mihomo.dns"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.dns; toggled(v) => { SettingsP.set-dns(v); } } }
        VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.edit; icon-size: 14px; tip: T.t("setting.section.dns"); clicked => { App.open-sub("dns"); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: "IPv6"; }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.ipv6; toggled(v) => { SettingsP.set-ipv6(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.mihomo.independentDelayTest"); tip: T.t("setting.tips.independent-test"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.independent; toggled(v) => { SettingsP.set-independent(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if SettingsP.independent: Row {
        VerticalLayout {
            alignment: start;
            padding-top: 6px;
            RowLabel { text: T.t("setting.mihomo.groupTestUrls"); }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            for u[i] in SettingsP.test-urls: HorizontalLayout {
                spacing: 8px;
                // Both fields are passed as typed: the model row is not
                // rewritten on every keystroke, so `u` can be stale.
                name-in := Input {
                    small: true;
                    horizontal-stretch: 1;
                    text: u.name;
                    placeholder: T.t("setting.mihomo.groupName");
                    edited(t) => { SettingsP.test-url-edited(i, t, url-in.text); }
                }
                url-in := Input {
                    small: true;
                    horizontal-stretch: 2;
                    text: u.url;
                    placeholder: T.t("setting.mihomo.testUrlPlaceholder");
                    edited(t) => { SettingsP.test-url-edited(i, name-in.text, t); }
                }
                VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.x; icon-size: 14px; tip: T.t("delete"); clicked => { SettingsP.test-url-remove(i); } } }
            }
            HorizontalLayout {
                alignment: start;
                IconButton { size: 26px; icon: Icons.plus; icon-size: 14px; tip: T.t("setting.mihomo.addGroupUrl"); clicked => { SettingsP.test-url-add(); } }
            }
        }
    }
    Row {
        RowLabel { text: T.t("setting.mihomo.dnsQuery.queryTitle"); }
        Input {
            width: 170px;
            horizontal-stretch: 0;
            small: true;
            text <=> SettingsP.dns-query;
            placeholder: "example.com";
            accepted => { SettingsP.run-dns-query(); }
        }
        Select {
            width: 90px;
            small: true;
            options: [{ value: "A", label: "A" }, { value: "AAAA", label: "AAAA" }, { value: "CNAME", label: "CNAME" }, { value: "MX", label: "MX" }, { value: "TXT", label: "TXT" }, { value: "NS", label: "NS" }];
            current: SettingsP.dns-type;
            select(v) => { SettingsP.dns-type = v; }
        }
        Btn {
            text: T.t("setting.mihomo.dnsQuery.query");
            icon: Icons.search;
            icon-size: 13px;
            kind: "soft";
            small: true;
            loading: SettingsP.dns-loading;
            enabled: !SettingsP.dns-loading;
            clicked => { SettingsP.run-dns-query(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if SettingsP.dns-error != "" || SettingsP.dns-results.length > 0: HorizontalLayout {
        padding-left: 180px;
        VerticalLayout {
            spacing: 6px;
            if SettingsP.dns-error != "": Alert { tone: "error"; icon: Icons.alert-circle; text: SettingsP.dns-error; }
            for r in SettingsP.dns-results: HorizontalLayout {
                spacing: 8px;
                VerticalLayout { alignment: center; Tag { text: r.kind; tone: "accent"; } }
                Text { text: r.data; font-size: 12px; font-family: Theme.mono; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "TTL " + r.ttl; font-size: 12px; color: Theme.text-3; vertical-alignment: center; }
            }
        }
    }
    Row {
        RowLabel { text: T.t("age.settings.label"); }
        Btn { text: T.t("age.settings.generateBtn"); kind: "soft"; small: true; clicked => { SettingsP.age-open = true; SettingsP.age-regenerate(); } }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component AppSection inherits SectionCard {
    title: "Prizrak-Box";
    tag: SettingsP.update-text;
    tag-tone: SettingsP.update-tone;
    tag-spinner: SettingsP.update-checking;
    // MyService.vue
    Row {
        RowLabel { text: T.t("service.mode"); tip: T.t("setting.tips.service"); }
        VerticalLayout { alignment: center; Tag { text: SettingsP.service-text; tone: SettingsP.service-tone; } }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Btn { text: T.t("service.install-btn"); kind: "soft"; small: true; loading: SettingsP.service-loading; enabled: !SettingsP.service-loading; clicked => { SettingsP.service-install(); } }
            if SettingsP.service-installed: Btn { text: T.t("service.uninstall-btn"); kind: "danger-soft"; small: true; enabled: !SettingsP.service-loading; clicked => { SettingsP.service-uninstall(); } }
            VerticalLayout { alignment: center; IconButton { size: 28px; icon: Icons.refresh; tip: T.t("service.check-status"); enabled: !SettingsP.service-loading; clicked => { SettingsP.service-refresh(); } } }
        }
    }
    Divider { }
    Row {
        RowLabel { text: "HWID"; tip: SettingsP.hwid-tip; }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.hwid; toggled(v) => { SettingsP.set-hwid(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.px.startup"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.startup; toggled(v) => { SettingsP.set-startup(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.px.startMinimized"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.start-minimized; toggled(v) => { SettingsP.set-start-minimized(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.px.systemProxyMode"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.system-proxy-mode; toggled(v) => { SettingsP.set-system-proxy-mode(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.px.auth"); tip: T.t("setting.tips.auth"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.auth; toggled(v) => { SettingsP.set-auth(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Divider { }
    Row {
        RowLabel { text: T.t("setting.shortcut.title"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.shortcut; toggled(v) => { SettingsP.set-shortcut(v); } } }
        VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.edit; icon-size: 14px; tip: T.t("setting.shortcut.edit"); clicked => { App.open-sub("shortcut"); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.subscriptionAlerts.title"); tip: T.t("setting.subscriptionAlerts.tooltip"); }
        VerticalLayout { alignment: center; Switch { checked: SettingsP.sub-alerts; toggled(v) => { SettingsP.set-sub-alerts(v); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.px.dir"); }
        Btn { text: T.t("setting.px.open"); kind: "soft"; small: true; clicked => { SettingsP.open-config-dir(); } }
        Btn { text: T.t("setting.px.change"); kind: "soft"; small: true; clicked => { SettingsP.change-config-dir(); } }
        Btn { text: T.t("setting.px.import"); kind: "soft"; small: true; clicked => { SettingsP.import-file(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    Row {
        RowLabel { text: T.t("setting.px.update"); }
        Btn { text: T.t("updates.actions.open"); kind: "soft"; small: true; clicked => { SettingsP.open-releases(); } }
        Btn { text: T.t("updates.actions.check"); kind: "soft"; small: true; loading: SettingsP.update-checking; enabled: !SettingsP.update-checking; clicked => { SettingsP.check-updates(); } }
        Rectangle { horizontal-stretch: 1; }
    }
}

// ---- custom dashboards dialog ----
export component DashboardsDialog inherits Modal {
    opened => { first-field.focus-input(); }
    open <=> SettingsP.dash-open;
    title: T.t("setting.dashboard.custom-title");
    max-w: 520px;
    closed => { SettingsP.dash-cancel(); }
    ModalBody {
        padding-bottom: 20px;
        VerticalLayout { spacing: 6px; FieldLabel { text: T.t("setting.dashboard.name"); } first-field := Input { text <=> SettingsP.dash-name; placeholder: "Zashboard"; } }
        VerticalLayout { spacing: 6px; FieldLabel { text: T.t("setting.dashboard.url"); } Input { text <=> SettingsP.dash-url; placeholder: "https://example.com/?host=%host&port=%port&secret=%secret"; } }
        FieldHint { text: T.t("setting.dashboard.hint"); }
        if SettingsP.dash-error != "": Text { text: SettingsP.dash-error; font-size: 12px; color: Theme.error; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if SettingsP.dash-editing >= 0: Btn { text: T.t("setting.dashboard.cancel"); pill: true; clicked => { SettingsP.dash-cancel(); } }
            Btn {
                text: SettingsP.dash-editing >= 0 ? T.t("setting.dashboard.save") : T.t("setting.dashboard.add");
                icon: SettingsP.dash-editing >= 0 ? Icons.device-floppy : Icons.plus;
                kind: "primary";
                pill: true;
                clicked => { SettingsP.dash-submit(); }
            }
        }
        Divider { }
        if SettingsP.custom-dashboards.length == 0: Text {
            text: T.t("setting.dashboard.empty");
            font-size: 13px;
            color: Theme.text-3;
            horizontal-alignment: center;
            height: 52px;
            vertical-alignment: center;
        }
        for d[i] in SettingsP.custom-dashboards: Rectangle {
            height: 56px;
            border-radius: 12px;
            border-width: 1px;
            border-color: SettingsP.dash-editing == i ? Theme.accent : Theme.border;
            background: Theme.input-bg;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: d.name; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                    Text { text: d.url; font-size: 12px; color: Theme.text-2; overflow: elide; TipZone { tip: d.url; mouse-cursor: default; } }
                }
                VerticalLayout { alignment: center; IconButton { size: 30px; icon: Icons.edit; tip: T.t("setting.dashboard.edit"); clicked => { SettingsP.dash-edit(i); } } }
                VerticalLayout { alignment: center; IconButton { size: 30px; icon: Icons.trash; danger: true; tip: T.t("setting.dashboard.remove"); clicked => { SettingsP.dash-remove(i); } } }
            }
        }
    }
}

// ---- age keypair (MyAgeKeypair.vue) ----
component KeyBox inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> copied;
    callback copy();
    spacing: 5px;
    Text { text: root.label.to-uppercase(); font-size: 11px; font-weight: 700; color: Theme.text-3; letter-spacing: 0.55px; }
    Rectangle {
        height: 38px;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.input-bg;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 10px;
            Text { text: root.value; font-size: 12px; font-family: Theme.mono; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; TipZone { tip: root.value; mouse-cursor: text; } }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 24px;
                    width: ct.preferred-width + 24px;
                    border-radius: 12px;
                    border-width: 1.5px;
                    border-color: root.copied ? Theme.success : Theme.border;
                    ct := Text { text: root.copied ? T.t("age.keypair.copied") : T.t("age.keypair.copy"); font-size: 12px; font-weight: 600; color: root.copied ? Theme.success : Theme.text; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.copy(); } }
                }
            }
        }
    }
}

export component AgeDialog inherits Modal {
    open <=> SettingsP.age-open;
    title: T.t("age.keypair.title");
    icon: Icons.key;
    max-w: 480px;
    ModalBody {
        HorizontalLayout {
            spacing: 12px;
            Text { text: T.t("age.keypair.algorithm"); font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            PillTabs {
                options: [{ value: "mlkem768-x25519", label: "MLKEM768-X25519" }, { value: "x25519", label: "X25519" }];
                current: SettingsP.age-type;
                select(v) => { SettingsP.age-set-type(v); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if SettingsP.age-loading: HorizontalLayout {
            alignment: center;
            padding-top: 28px;
            padding-bottom: 28px;
            spacing: 8px;
            VerticalLayout { alignment: center; Spinner { tint: Theme.accent; } }
            Text { text: T.t("age.keypair.generating"); font-size: 13px; color: Theme.text-2; }
        }
        if !SettingsP.age-loading && SettingsP.age-error != "": Alert { tone: "error"; icon: Icons.alert-circle; text: SettingsP.age-error; }
        if !SettingsP.age-loading && SettingsP.age-error == "" && SettingsP.age-public != "": KeyBox {
            label: T.t("age.keypair.publicKey");
            value: SettingsP.age-public;
            copied: SettingsP.age-copied-pub;
            copy => { SettingsP.age-copy(true); }
        }
        if !SettingsP.age-loading && SettingsP.age-error == "" && SettingsP.age-secret != "": KeyBox {
            label: T.t("age.keypair.secretKey");
            value: SettingsP.age-secret;
            copied: SettingsP.age-copied-sec;
            copy => { SettingsP.age-copy(false); }
        }
    }
    ModalFooter {
        alignment: end;
        Btn { text: T.t("age.keypair.regenerate"); icon: Icons.refresh; pill: true; loading: SettingsP.age-loading; enabled: !SettingsP.age-loading; clicked => { SettingsP.age-regenerate(); } }
    }
}

// ---- Setting/Dns (Dns.vue + MyEditor.vue) ----
export component DnsPage inherits VerticalLayout {
    SettingsHeader { sub: "dns"; }
    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 28px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { source: Icons.info-circle; size: 16px; tint: Theme.info; } }
            Text { text: T.t("dns.hint"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; horizontal-stretch: 1; }
        }
        TextArea {
            vertical-stretch: 1;
            min-height: 360px;
            code: true;
            line-height: 1.7;
            text <=> SettingsP.dns-yaml;
            edited(t) => { SettingsP.dns-edited(t); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn { text: T.t("theme.reset"); pill: true; enabled: SettingsP.dns-dirty && !SettingsP.dns-saving; clicked => { SettingsP.dns-reload(); } }
            if !SettingsP.dns-saved: Btn {
                text: T.t("save");
                kind: "primary";
                pill: true;
                loading: SettingsP.dns-saving;
                enabled: SettingsP.dns-dirty && !SettingsP.dns-saving;
                clicked => { SettingsP.dns-save(); }
            }
            if SettingsP.dns-saved: Btn {
                text: T.t("ui.saved");
                icon: Icons.check;
                kind: "danger";
                background: Theme.success;
                pill: true;
            }
        }
    }
}

// ---- Setting/Shortcut (Shortcut.vue + MyHotkeyInput.vue) ----
export component ShortcutPage inherits VerticalLayout {
    SettingsHeader { sub: "shortcut"; }
    ScrollArea {
        vertical-stretch: 1;
        content-height: sc.preferred-height;
        sc := VerticalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-bottom: 28px;
            alignment: start;
            Card {
                height: cl.preferred-height;
                cl := VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 18px;
                    padding-bottom: 18px;
                    spacing: 14px;
                    Text { text: T.t("setting.shortcut.title"); font-size: 14px; font-weight: 700; color: Theme.text; }
                    Divider { }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 7px;
                            Text { width: 190px; text: T.t("setting.shortcut.showHide"); font-size: 13px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                        }
                        VerticalLayout {
                            alignment: start;
                            padding-top: 4px;
                            Switch { checked: SettingsP.shortcut; toggled(v) => { SettingsP.set-shortcut(v); } }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: start;
                                hk := Rectangle {
                                    width: max(190px, hl.preferred-width);
                                    height: 34px;
                                    border-radius: 17px;
                                    border-width: 1.5px;
                                    border-color: SettingsP.hotkey-recording ? Theme.accent : (ht.has-hover ? Theme.accent.mix(Theme.border, 0.6) : Theme.border);
                                    background: Theme.panel-soft;
                                    hl := HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        VerticalLayout { alignment: center; Icon { source: Icons.keyboard; size: 15px; tint: Theme.text-3; } }
                                        Text {
                                            text: SettingsP.hotkey-recording ? T.t("setting.shortcut.recording") : SettingsP.hotkey;
                                            font-size: 13px;
                                            font-family: Theme.mono;
                                            color: SettingsP.hotkey-recording ? Theme.accent : Theme.text;
                                            vertical-alignment: center;
                                        }
                                    }
                                    ht := TipZone {
                                        tip: T.t("setting.shortcut.edit");
                                        clicked => {
                                            SettingsP.hotkey-recording = true;
                                            fs.focus();
                                        }
                                    }
                                    fs := FocusScope {
                                        changed has-focus => {
                                            if (!self.has-focus) {
                                                SettingsP.hotkey-recording = false;
                                            }
                                        }
                                        key-pressed(e) => {
                                            if (!SettingsP.hotkey-recording) {
                                                if (e.text == Key.Return || e.text == " ") {
                                                    SettingsP.hotkey-recording = true;
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                            if (e.text == Key.Escape) {
                                                SettingsP.hotkey-recording = false;
                                                return accept;
                                            }
                                            SettingsP.hotkey-record(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                                            return accept;
                                        }
                                    }
                                }
                            }
                            Text { text: T.t("hotkey.record-hint"); font-size: 12px; color: Theme.text-3; wrap: word-wrap; }
                            if SettingsP.hotkey-mac-warning: Alert { tone: "warning"; text: T.t("setting.shortcut.macOptionWarning"); }
                        }
                    }
                }
            }
        }
    }
}
