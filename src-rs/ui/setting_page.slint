// Settings container — port of views/Setting.vue.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { ScrollArea, PillTabs, Select, TipZone, Icon } from "components.slint";
import { RulesTab, RulesP } from "rules.slint";
import { ConnectionsTab, LogsTab, ConnP, LogsP } from "conn.slint";
import { SettingsP, SettingsHeader, CoreSection, AppSection, DnsPage, ShortcutPage } from "settings.slint";

export component SettingPage inherits Rectangle {
    if App.setting-sub == "dns": DnsPage { }
    if App.setting-sub == "shortcut": ShortcutPage { }
    if App.setting-sub == "": VerticalLayout {
        SettingsHeader {
            if App.setting-tab == "connection" && (ConnP.view == "list" || ConnP.view == "process"): VerticalLayout {
                alignment: center;
                PillTabs {
                    options: [{ value: "active", icon: Icons.bolt, tip: T.t("connections.active") }, { value: "closed", icon: Icons.history, tip: T.t("connections.closed") }];
                    current: ConnP.show-closed ? "closed" : "active";
                    select(v) => { ConnP.set-show-closed(v == "closed"); }
                }
            }
            if App.setting-tab == "log": VerticalLayout {
                alignment: center;
                Select {
                    width: 130px;
                    variant: "pill";
                    options: [{ value: "debug", label: "Debug" }, { value: "info", label: "Info" }, { value: "warning", label: "Warning" }, { value: "error", label: "Error" }, { value: "silent", label: "Silent" }];
                    current: SettingsP.log-level;
                    tip: T.t("logs.level");
                    select(v) => { SettingsP.set-log-level(v); }
                }
            }
        }
        if App.setting-tab == "app" || App.setting-tab == "core": ScrollArea {
            vertical-stretch: 1;
            content-height: body.preferred-height;
            body := VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 28px;
                spacing: 16px;
                alignment: start;
                if App.setting-tab == "core": CoreSection { }
                if App.setting-tab == "app": AppSection { }
            }
        }
        if App.setting-tab == "rule": RulesTab { vertical-stretch: 1; }
        if App.setting-tab == "connection": ConnectionsTab { vertical-stretch: 1; }
        if App.setting-tab == "log": LogsTab { vertical-stretch: 1; }
    }
}
