// Profiles page — port of views/Profiles.vue.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { AddProfile, AnnounceLine } from "home.slint";
import { Icon, IconButton, Btn, TipZone, Spinner, ScrollArea, Empty, Skel, Modal, ModalBody, ModalFooter, Divider, Input, Select, SelectOption, FieldLabel, FieldHint, Alert, VDivider } from "components.slint";

export struct ProfileView {
    id: string,
    title: string,
    selected: bool,
    order: int,
    remote: bool,
    used: string,
    available: string,
    expire: string,
    update: string,
    update-exact: string,
    can-tv: bool,
    has-announce: bool,
    has-renew: bool,
    has-support: bool,
    has-home: bool,
}

export global ProfilesP {
    in property <[ProfileView]> profiles;
    in property <bool> first-load: true;
    in property <bool> multi: false;
    callback toggle-multi();
    in-out property <bool> multi-info;
    callback multi-info-accept();
    callback multi-info-decline();
    callback switch(string);
    callback pick(string);
    callback refresh(string);
    callback tv(string);
    callback announce(string);
    callback renew(string);
    callback support(string);
    callback home(string);
    callback edit(string);
    callback delete(string);
    callback reorder(int, int);
    // grid rows are as tall as their tallest card (wrapped action icons);
    // computed by Rust from the card width
    in property <[length]> row-y;
    in property <[length]> row-h;
    callback relayout(length, int);
    // edit dialog
    in-out property <bool> edit-open;
    in-out property <string> edit-title;
    in-out property <string> edit-url;
    in-out property <string> edit-interval;
    in property <bool> edit-remote;
    in property <bool> edit-interval-locked;
    in property <bool> edit-interval-invalid;
    in-out property <string> edit-template;
    in property <[SelectOption]> templates;
    in property <bool> edit-template-locked;
    in-out property <bool> edit-show-age;
    in property <bool> edit-has-age;
    in-out property <string> edit-age;
    in property <bool> edit-hwid;
    in property <bool> edit-theme;
    in property <bool> edit-bell;
    in property <bool> edit-renew;
    in property <bool> edit-saving;
    callback edit-step(int);
    callback edit-interval-edited(string);
    callback edit-save();
    callback edit-renew-clicked();
    callback edit-bell-clicked();
    // subscription alert info
    in-out property <bool> alert-info-open;
    in property <[string]> alert-info-lines;
    in property <bool> alert-info-disabled;
    // TV
    in-out property <bool> tv-open;
    // profiles.tv-dialog.warning without its leading "⚠️" (the alert has an icon).
    in property <string> tv-warning;
    in-out property <string> tv-ip;
    in-out property <string> tv-port;
    in property <bool> tv-sending;
    callback tv-submit();
    // announce
    in-out property <bool> announce-open;
    in property <[AnnounceLine]> announce-lines;
    in property <bool> announce-has-url;
    callback announce-open-url();
}

component StatRow inherits HorizontalLayout {
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    in property <string> tip;
    spacing: 8px;
    HorizontalLayout {
        spacing: 6px;
        horizontal-stretch: 1;
        VerticalLayout { alignment: center; Icon { source: root.icon; size: 14px; tint: Theme.text-2; } }
        Text { text: root.label; font-size: 12px; color: Theme.text-2; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    Text {
        text: root.value;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        TipZone { tip: root.tip; mouse-cursor: default; }
    }
}

component ProfileCard inherits Rectangle {
    in property <ProfileView> p;
    in property <int> index;
    in property <bool> dragging;
    callback grip-down();
    callback grip-move(length, length);
    callback grip-up();
    border-width: 2px;
    border-radius: 12px;
    border-color: self.p.selected ? Theme.accent : (ta.has-hover ? Theme.accent.mix(Theme.border, 0.55) : Theme.border);
    background: self.p.selected ? Theme.accent.mix(Theme.input-bg, 0.10) : Theme.input-bg;
    opacity: self.dragging ? 0.85 : 1;
    drop-shadow-blur: self.dragging ? 24px : 0;
    drop-shadow-color: #00000040;
    animate border-color, background { duration: 150ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { ProfilesP.switch(root.p.id); }
    }
    // .profile-card: 2px border + 14px/16px padding
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 8px;
            height: 16px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    Icon { source: Icons.grip-vertical; size: 16px; tint: Theme.text-3; }
                    TouchArea {
                        mouse-cursor: grab;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.grip-down();
                            } else if (e.kind == PointerEventKind.up) {
                                root.grip-up();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.grip-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                            }
                        }
                    }
                }
            }
            Text {
                text: root.p.title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                TipZone { tip: root.p.title; clicked => { ProfilesP.switch(root.p.id); } }
            }
            if root.p.remote: Rectangle {
                width: 16px;
                IconButton {
                    x: -5px;
                    y: -5px;
                    size: 26px;
                    icon: Icons.refresh;
                    tip: T.t("refresh");
                    clicked => { ProfilesP.refresh(root.p.id); }
                }
            }
        }
        Rectangle { height: 10px; }
        Divider { }
        Rectangle { height: 10px; }
        VerticalLayout {
            spacing: 6px;
            min-height: 92px;
            vertical-stretch: 0;
            alignment: start;
            if root.p.used != "": StatRow { icon: Icons.activity; label: T.t("profiles.use"); value: root.p.used; }
            if root.p.available != "": StatRow { icon: Icons.database; label: T.t("profiles.available"); value: root.p.available; }
            if root.p.expire != "": StatRow { icon: Icons.calendar-due; label: T.t("profiles.expire"); value: root.p.expire; }
            if root.p.update != "": StatRow { icon: Icons.clock-check; label: T.t("profiles.update"); value: root.p.update; tip: root.p.update-exact; }
        }
        Rectangle { height: 10px; }
        // .card-bottom: select, spacer, then .card-actions with flex-wrap
        // (lines right-aligned, 4px gaps)
        bottom := Rectangle {
            property <int> n-tv: root.p.can-tv ? 1 : 0;
            property <int> n-ann: self.n-tv + (root.p.has-announce ? 1 : 0);
            property <int> n-renew: self.n-ann + (root.p.has-renew ? 1 : 0);
            property <int> n-support: self.n-renew + (root.p.has-support ? 1 : 0);
            property <int> n-home: self.n-support + (root.p.has-home ? 1 : 0);
            property <int> n: self.n-home + 2;
            property <length> sel-w: !ProfilesP.multi ? 0px : (root.p.selected && root.p.order > 0 ? 40px : 22px);
            property <length> avail: ProfilesP.multi ? self.width - self.sel-w - 8px : self.width - 4px;
            property <int> per: max(1, floor((self.avail + 4px) / 30px));
            property <int> lines: ceil(self.n / self.per);
            height: self.lines * 26px + (self.lines - 1) * 4px;
            pure function ax(j: int) -> length {
                let r = floor(j / self.per);
                let cnt = min(self.per, self.n - r * self.per);
                self.width - cnt * 30px + 4px + (j - r * self.per) * 30px
            }
            pure function ay(j: int) -> length {
                floor(j / self.per) * 30px
            }
            if ProfilesP.multi: Rectangle {
                x: 0;
                y: (parent.height - 22px) / 2;
                width: sel.preferred-width + 4px;
                height: 22px;
                border-radius: 11px;
                sel := HorizontalLayout {
                    x: 2px;
                    spacing: 2px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: root.p.selected ? Icons.circle-check : Icons.circle;
                            size: 18px;
                            tint: root.p.selected ? Theme.accent : Theme.text-3;
                        }
                    }
                    if root.p.selected && root.p.order > 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 16px;
                            width: max(16px, on.preferred-width + 8px);
                            border-radius: 8px;
                            background: Theme.accent;
                            on := Text { text: root.p.order; font-size: 11px; font-weight: 700; color: Theme.on-accent; }
                        }
                    }
                }
                TipZone {
                    tip: T.t("profiles.multi-select.pick");
                    clicked => { ProfilesP.pick(root.p.id); }
                }
            }
            if root.p.can-tv: IconButton { x: bottom.ax(0); y: bottom.ay(0); size: 26px; icon: Icons.device-tv; icon-size: 14px; tip: T.t("profiles.tv-send"); clicked => { ProfilesP.tv(root.p.id); } }
            if root.p.has-announce: IconButton { x: bottom.ax(bottom.n-tv); y: bottom.ay(bottom.n-tv); size: 26px; icon: Icons.speakerphone; icon-size: 14px; tip: T.t("profiles.announce"); clicked => { ProfilesP.announce(root.p.id); } }
            if root.p.has-renew: IconButton { x: bottom.ax(bottom.n-ann); y: bottom.ay(bottom.n-ann); size: 26px; icon: Icons.credit-card; icon-size: 14px; tip: T.t("profiles.renew"); clicked => { ProfilesP.renew(root.p.id); } }
            if root.p.has-support: IconButton { x: bottom.ax(bottom.n-renew); y: bottom.ay(bottom.n-renew); size: 26px; icon: Icons.headphones; icon-size: 14px; tip: T.t("profiles.support"); clicked => { ProfilesP.support(root.p.id); } }
            if root.p.has-home: IconButton { x: bottom.ax(bottom.n-support); y: bottom.ay(bottom.n-support); size: 26px; icon: Icons.home-link; icon-size: 14px; tip: T.t("profiles.home"); clicked => { ProfilesP.home(root.p.id); } }
            IconButton { x: bottom.ax(bottom.n-home); y: bottom.ay(bottom.n-home); size: 26px; icon: Icons.edit; icon-size: 14px; tip: T.t("edit"); clicked => { ProfilesP.edit(root.p.id); } }
            IconButton { x: bottom.ax(bottom.n-home + 1); y: bottom.ay(bottom.n-home + 1); size: 26px; icon: Icons.trash; icon-size: 14px; danger: true; tip: T.t("delete"); clicked => { ProfilesP.delete(root.p.id); } }
        }
        // a card stretched to its grid row keeps the extra space at the bottom
        Rectangle { vertical-stretch: 1; }
    }
}

export component ProfilesPage inherits Rectangle {
    VerticalLayout {
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 24px;
            padding-bottom: 12px;
            spacing: 12px;
            Text { text: T.t("profiles.title"); font-size: 24px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 6px;
                IconButton {
                    icon: ProfilesP.multi ? Icons.checkbox : Icons.square;
                    icon-size: 17px;
                    active: ProfilesP.multi;
                    tip: ProfilesP.multi ? T.t("profiles.multi-select.disable") : T.t("profiles.multi-select.enable");
                    clicked => { ProfilesP.toggle-multi(); }
                }
                IconButton { icon: Icons.info-circle; icon-size: 17px; tip: T.t("profiles.multi-select.info"); clicked => { ProfilesP.multi-info = true; } }
                VerticalLayout { alignment: center; VDivider { } }
                IconButton { icon: Icons.plus; icon-size: 17px; tip: T.t("profiles.add"); clicked => { AddProfile.open-manual(); } }
                IconButton { icon: Icons.clipboard; icon-size: 17px; tip: T.t("profiles.paste"); clicked => { AddProfile.paste(); } }
                IconButton { icon: Icons.folder-open; icon-size: 17px; tip: T.t("profiles.open"); clicked => { AddProfile.open-file(); } }
            }
        }
        body := ScrollArea {
            vertical-stretch: 1;
            property <length> gap: 14px;
            property <length> inner: self.width - 56px;
            property <int> cols: max(1, floor((self.inner + self.gap) / (240px + self.gap)));
            property <length> cw: (self.inner - (self.cols - 1) * self.gap) / self.cols;
            property <length> ch: 198px;
            changed cw => { ProfilesP.relayout(self.cw, self.cols); }
            init => { ProfilesP.relayout(self.cw, self.cols); }
            property <int> count: ProfilesP.first-load && ProfilesP.profiles.length == 0 ? 3 : ProfilesP.profiles.length;
            property <int> rows: ceil(self.count / self.cols);
            property <int> drag-from: -1;
            property <length> drag-dx;
            property <length> drag-dy;
            property <int> drag-to: self.drag-from < 0 ? -1 : max(0, min(ProfilesP.profiles.length - 1,
                round((mod(self.drag-from, self.cols) * (self.cw + self.gap) + self.drag-dx) / (self.cw + self.gap))
                + self.cols * round((floor(self.drag-from / self.cols) * (self.ch + self.gap) + self.drag-dy) / (self.ch + self.gap))));
            content-height: ProfilesP.profiles.length == 0 && !ProfilesP.first-load ? self.height
                : ProfilesP.row-y.length >= self.rows && self.rows > 0 ? 8px + ProfilesP.row-y[self.rows - 1] + ProfilesP.row-h[self.rows - 1] + self.gap + 28px
                : 8px + self.rows * (self.ch + self.gap) + 28px;
            if ProfilesP.first-load && ProfilesP.profiles.length == 0: Rectangle {
                for i in 3: Rectangle {
                    x: 28px + mod(i, body.cols) * (body.cw + body.gap);
                    y: 8px + floor(i / body.cols) * (body.ch + body.gap);
                    width: body.cw;
                    height: body.ch;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 12px;
                    background: Theme.input-bg;
                    Skel { x: 16px; y: 16px; width: (parent.width - 32px) * 0.55; height: 14px; }
                    Skel { x: 16px; y: 40px; width: (parent.width - 32px) * 0.35; height: 10px; }
                    Skel { x: 16px; y: parent.height - 76px; width: parent.width - 32px; height: 10px; }
                    Skel { x: 16px; y: parent.height - 56px; width: (parent.width - 32px) * 0.8; height: 10px; }
                    Skel { x: 16px; y: parent.height - 36px; width: (parent.width - 32px) * 0.6; height: 10px; }
                }
            }
            if !ProfilesP.first-load && ProfilesP.profiles.length == 0: Empty {
                y: 8px; // .px-page-body padding-top
                width: body.width;
                height: body.height - 8px;
                alignment: start; // UiEmpty is not stretched in .px-page-body
                icon: Icons.user-cog;
                title: T.t("empty.profiles.title");
                text: T.t("empty.profiles.text");
                action-label: T.t("profiles.add");
                action-icon: Icons.plus;
                action => { AddProfile.open-manual(); }
            }
            for p[i] in ProfilesP.profiles: ProfileCard {
                property <int> slot: body.drag-from < 0 || i == body.drag-from ? i
                    : (i > body.drag-from && i <= body.drag-to ? i - 1 : (i < body.drag-from && i >= body.drag-to ? i + 1 : i));
                x: 28px + mod(self.slot, body.cols) * (body.cw + body.gap) + (i == body.drag-from ? body.drag-dx : 0);
                property <int> grid-row: floor(self.slot / body.cols);
                y: 8px + (ProfilesP.row-y.length > self.grid-row ? ProfilesP.row-y[self.grid-row] : self.grid-row * (body.ch + body.gap)) + (i == body.drag-from ? body.drag-dy : 0);
                z: i == body.drag-from ? 10 : 0;
                width: body.cw;
                height: ProfilesP.row-h.length > self.grid-row ? ProfilesP.row-h[self.grid-row] : body.ch;
                p: p;
                index: i;
                dragging: i == body.drag-from;
                animate x, y { duration: i == body.drag-from ? 0ms : 150ms; }
                grip-down => {
                    body.drag-from = i;
                    body.drag-dx = 0;
                    body.drag-dy = 0;
                }
                grip-move(dx, dy) => {
                    body.drag-dx = dx;
                    body.drag-dy = dy;
                }
                grip-up => {
                    if (body.drag-from >= 0 && body.drag-to >= 0 && body.drag-to != body.drag-from) {
                        ProfilesP.reorder(body.drag-from, body.drag-to);
                    }
                    body.drag-from = -1;
                    body.drag-dx = 0;
                    body.drag-dy = 0;
                }
            }
        }
    }
}

// Page dialogs, placed at window level by app.slint so the scrim covers the
// whole window and the card is centred on it (UiModal teleports to <body>).
export component ProfilesDialogs inherits Rectangle {
    // ---- edit (UiModal divided) ----
    Modal {
        opened => { first-field-1.focus-input(); }
        open <=> ProfilesP.edit-open;
        title: T.t("edit");
        divided: true;
        ModalBody {
            divided: true;
            if ProfilesP.edit-renew: Btn {
                text: T.t("profiles.renew");
                icon: Icons.credit-card;
                kind: "soft";
                stretch: true;
                clicked => { ProfilesP.edit-renew-clicked(); }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: T.t("profiles.edit.title"); }
                first-field-1 := Input { text <=> ProfilesP.edit-title; }
            }
            if ProfilesP.edit-remote: VerticalLayout {
                spacing: 6px;
                FieldLabel { text: T.t("profiles.edit.url"); }
                Input { text <=> ProfilesP.edit-url; }
            }
            if ProfilesP.edit-remote: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    FieldLabel { text: T.t("profiles.edit.update"); vertical-alignment: center; }
                    if ProfilesP.edit-interval-locked: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 13px;
                            height: 13px;
                            Icon { source: Icons.lock; size: 13px; tint: Theme.text-3; }
                            TipZone { tip: T.t("profiles.edit.interval-locked"); mouse-cursor: help; }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 176px;
                        height: 38px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: iv.has-focus ? Theme.accent : Theme.border;
                        background: Theme.input-bg;
                        opacity: ProfilesP.edit-interval-locked ? 0.55 : 1;
                        // .stepper: 4px padding inside the 1px border (border-box)
                        HorizontalLayout {
                            padding: 5px;
                            spacing: 4px;
                            IconButton { size: 28px; soft: true; icon: Icons.minus; icon-size: 14px; enabled: !ProfilesP.edit-interval-locked; tip: T.t("ui.decrease"); clicked => { ProfilesP.edit-step(-1); } }
                            iv := Input {
                                border-width: 0;
                                background: transparent;
                                text-size: 14px;
                                text-weight: 600;
                                text-align: center;
                                text <=> ProfilesP.edit-interval;
                                enabled: !ProfilesP.edit-interval-locked;
                                edited(t) => { ProfilesP.edit-interval-edited(t); }
                            }
                            Text { text: T.t("ui.hours-short"); font-size: 12px; color: Theme.text-3; vertical-alignment: center; }
                            IconButton { size: 28px; soft: true; icon: Icons.plus; icon-size: 14px; enabled: !ProfilesP.edit-interval-locked; tip: T.t("ui.increase"); clicked => { ProfilesP.edit-step(1); } }
                        }
                    }
                }
                if ProfilesP.edit-interval-locked: FieldHint { text: T.t("profiles.edit.interval-locked"); }
                if !ProfilesP.edit-interval-locked && ProfilesP.edit-interval-invalid: Text { text: T.t("profiles.edit.update-tip"); font-size: 12px; color: Theme.error; }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: T.t("profiles.edit.template"); }
                Select {
                    options: ProfilesP.templates;
                    current: ProfilesP.edit-template;
                    enabled: !ProfilesP.edit-template-locked;
                    select(v) => { ProfilesP.edit-template = v; }
                }
            }
            if ProfilesP.edit-show-age: VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "age-secret-key"; }
                Input { text <=> ProfilesP.edit-age; placeholder: T.t("age.profile.keyPlaceholder"); }
            }
        }
        Divider { }
        HorizontalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 8px;
            if ProfilesP.edit-hwid: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    Icon { source: Icons.shield-check; size: 18px; tint: Theme.accent; }
                    TipZone { tip: T.t("hwid.active.tooltip"); mouse-cursor: default; }
                }
            }
            if ProfilesP.edit-theme: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    Icon { source: Icons.palette; size: 18px; tint: Theme.accent; }
                    TipZone { tip: T.t("profiles.has-theme"); mouse-cursor: default; }
                }
            }
            if ProfilesP.edit-bell: IconButton {
                size: 30px;
                icon: Icons.bell;
                icon-size: 18px;
                tint-override: Theme.warning;
                tip: T.t("subscriptionAlert.bellTooltip");
                clicked => { ProfilesP.edit-bell-clicked(); }
            }
            if ProfilesP.edit-remote || ProfilesP.edit-has-age: IconButton {
                size: 30px;
                icon: Icons.key;
                icon-size: 18px;
                active: ProfilesP.edit-show-age;
                tip: ProfilesP.edit-has-age ? T.t("age.profile.replaceHint") : T.t("age.profile.toggleOff");
                clicked => { ProfilesP.edit-show-age = !ProfilesP.edit-show-age; }
            }
            Rectangle { horizontal-stretch: 1; }
            Btn { text: T.t("cancel"); clicked => { ProfilesP.edit-open = false; } }
            Btn { text: T.t("save"); kind: "primary"; loading: ProfilesP.edit-saving; enabled: !ProfilesP.edit-saving; clicked => { ProfilesP.edit-save(); } }
        }
    }

    // ---- subscription reminders info ----
    Modal {
        open <=> ProfilesP.alert-info-open;
        title: T.t("subscriptionAlert.infoTitle");
        icon: Icons.bell;
        tone: "warning";
        max-w: 460px;
        ModalBody {
            for line[i] in ProfilesP.alert-info-lines: Rectangle {
                property <bool> warn: ProfilesP.alert-info-disabled && i == ProfilesP.alert-info-lines.length - 1;
                height: lt.preferred-height + (i == 0 || self.warn ? 0px : 16px);
                background: i == 0 || self.warn ? transparent : Theme.panel-soft;
                border-radius: 8px;
                lt := Text {
                    x: i == 0 || parent.warn ? 0px : 12px;
                    width: parent.width - self.x * 2;
                    text: line;
                    font-size: 13px;
                    font-weight: parent.warn ? 600 : 400;
                    color: parent.warn ? Theme.warning : (i == 0 ? Theme.text-2 : Theme.text);
                    wrap: word-wrap;
                    y: i == 0 || parent.warn ? 0px : 8px;
                    line-height-factor: 1.6 / 1.19; // .info-line line-height: 1.6
                }
            }
        }
        ModalFooter {
            Btn { text: T.t("close"); kind: "primary"; clicked => { ProfilesP.alert-info-open = false; } }
        }
    }

    // ---- multi-profile warning (must be answered) ----
    Modal {
        open <=> ProfilesP.multi-info;
        title: T.t("profiles.multi-select.title");
        icon: Icons.copy-check;
        tone: "warning";
        max-w: 520px;
        close-on-overlay: false;
        close-on-esc: false;
        show-close: false;
        ModalBody {
            Text { text: T.t("profiles.multi-select.description"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
            Text { text: T.t("profiles.multi-select.description-secondary"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
            Text { text: T.t("profiles.multi-select.description-tertiary"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
            Alert { tone: "warning"; text: T.t("profiles.multi-select.description-warning"); }
            Text { text: T.t("profiles.multi-select.question"); font-size: 14px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
        }
        ModalFooter {
            Btn { text: T.t("profiles.multi-select.decline"); clicked => { ProfilesP.multi-info-decline(); } }
            Btn { text: T.t("profiles.multi-select.accept"); kind: "primary"; clicked => { ProfilesP.multi-info-accept(); } }
        }
    }

    // ---- send to Android TV ----
    Modal {
        opened => { first-field-2.focus-input(); }
        open <=> ProfilesP.tv-open;
        title: T.t("profiles.tv-dialog.title");
        max-w: 380px;
        divided: true;
        ModalBody {
            divided: true;
            Alert { tone: "warning"; text: ProfilesP.tv-warning; }
            VerticalLayout { spacing: 6px; FieldLabel { text: T.t("profiles.tv-dialog.ip"); } first-field-2 := Input { text <=> ProfilesP.tv-ip; placeholder: "192.168.1.100"; } }
            VerticalLayout { spacing: 6px; FieldLabel { text: T.t("profiles.tv-dialog.port"); } Input { text <=> ProfilesP.tv-port; placeholder: "8080"; } }
        }
        Divider { }
        ModalFooter {
            divided: true;
            Btn { text: T.t("cancel"); clicked => { ProfilesP.tv-open = false; } }
            Btn { text: T.t("profiles.tv-dialog.submit"); icon: Icons.device-tv; kind: "primary"; loading: ProfilesP.tv-sending; clicked => { ProfilesP.tv-submit(); } }
        }
    }

    // ---- announce ----
    Modal {
        open <=> ProfilesP.announce-open;
        title: T.t("profiles.announce");
        icon: Icons.speakerphone;
        max-w: 520px;
        ModalBody {
            Rectangle {
                height: ab.preferred-height;
                border-radius: 12px;
                background: Theme.panel-soft;
                ab := VerticalLayout {
                    padding: 16px;
                    spacing: 2px;
                    for line in ProfilesP.announce-lines: HorizontalLayout {
                        alignment: center;
                        for seg in line.segs: Text {
                            text: seg.text;
                            color: seg.colored ? seg.color : Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
        ModalFooter {
            Btn { text: T.t("close"); clicked => { ProfilesP.announce-open = false; } }
            if ProfilesP.announce-has-url: Btn { text: T.t("profiles.announce-url"); icon: Icons.external-link; kind: "primary"; clicked => { ProfilesP.announce-open-url(); } }
        }
    }
}
