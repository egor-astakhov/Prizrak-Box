// Design tokens — port of src/styles/tokens.css + composables/useAppTheme.ts.
// Rust (src/theme.rs) resolves the effective theme (mode, accent from the
// background image, panel opacity, blur, dimming) and writes it here.

export global Theme {
    in property <bool> dark: true;
    in property <bool> is-mac: false;
    in property <bool> is-windows: false;
    in property <bool> is-linux: false;

    in property <color> accent: #5b67e8;
    in property <color> on-accent: #fff;
    in property <color> panel-bg: dark ? #14151bbd : #ffffffd1;
    in property <color> side-bg: dark ? #ffffff12 : #0000000b;
    in property <color> panel-soft: dark ? #ffffff12 : #0000000b;
    in property <color> dialog-bg: dark ? #1b1c23 : #ffffff;
    in property <color> input-bg: dark ? #ffffff0f : #0000000a;
    in property <color> hover-bg: dark ? #ffffff17 : #0000000d;
    in property <color> border: dark ? #ffffff1a : #00000017;
    in property <color> text: dark ? #f3f4f6 : #1f2329;
    in property <color> text-2: dark ? #f3f4f6a3 : #1f2329a3;
    in property <color> text-3: dark ? #f3f4f666 : #1f23296b;
    in property <color> success: dark ? #63e2b7 : #18a058;
    in property <color> warning: dark ? #f2c97d : #f0a020;
    in property <color> error: dark ? #e88080 : #d03050;
    in property <color> info: dark ? #70c0e8 : #2080f0;
    in property <color> app-bg: dark ? #0b0c10 : #e9ebee;
    in property <color> tip-bg: dark ? #1e1e24f7 : #1e1e24f7;
    in property <color> upload-color: dark ? #f59e0b : #c77700;
    in property <color> download-color: dark ? #10b981 : #0e8a62;
    in property <color> scrim: #00000080;
    in property <color> title-bg: transparent;

    // Background image layer
    in property <bool> use-image: false;
    in property <image> bg-image;
    in property <image> bg-blur;
    in property <bool> has-blur: false;
    in property <brush> overlay: dark ? @linear-gradient(180deg, #06070b73 0%, #06070bd1 100%) : @linear-gradient(180deg, #ffffff66 0%, #ffffffb8 100%);
    in property <bool> side-glass: false;

    // window size (kept in sync by the root so backdrop images can align)
    in-out property <length> win-w: 1100px;
    in-out property <length> win-h: 760px;

    // typography
    out property <length> fs-11: 11px;
    out property <length> fs-12: 12px;
    out property <length> fs-13: 13px;
    out property <length> fs-14: 14px;
    out property <length> fs-16: 16px;
    out property <length> fs-24: 24px;
    out property <string> mono: is-mac ? "Menlo" : (is-windows ? "Consolas" : "monospace");

    // delay / weight tones: 0 none, 1 good, 2 fair, 3 slow, 4 accent
    pure public function tone(t: int) -> color {
        return t == 1 ? self.success : t == 2 ? self.warning : t == 3 ? self.error : t == 4 ? self.accent : self.text-3;
    }

    pure public function mix(c: color, a: float) -> color {
        return c.with-alpha(a);
    }
}

// Translator: Rust supplies the tables (src/locales/*.yaml).
export global T {
    in-out property <string> lang: "en";
    pure callback translate(string, string) -> string;
    pure callback translate1(string, string, string, string) -> string;

    pure public function t(key: string) -> string {
        return self.translate(self.lang, key);
    }
    pure public function t1(key: string, name: string, value: string) -> string {
        return self.translate1(self.lang, key, name, value);
    }
}
