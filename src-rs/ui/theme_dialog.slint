// Theme dialog — port of components/menu/Skin.vue.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Btn, TipZone, Modal, ModalBody, ModalFooter, Divider, Switch, PillTabs, PillOption, Alert, Backdrop } from "components.slint";
import { ThemeDialog } from "shell.slint";

export struct BgTile {
    id: string,
    label: string,
    icon: image,
    custom: bool,
    uploaded: bool,
    on: bool,
}

export global ThemeP {
    in property <bool> has-profile-theme;
    in property <string> profile-desc;
    in property <bool> use-profile-theme;
    callback set-use-profile-theme(bool);
    in property <string> mode: "auto";
    in property <bool> mode-locked;
    callback set-mode(string);
    in property <bool> use-image: true;
    in property <bool> image-locked;
    callback set-use-image(bool);
    in property <[BgTile]> tiles;
    callback pick-tile(string);
    callback upload(string);
    in property <string> bg-error;
    in property <int> trans;
    in property <int> blur;
    in property <int> dim;
    in property <bool> trans-locked;
    in property <bool> blur-locked;
    in property <bool> dim-locked;
    callback set-slider(string, int);
    in property <string> accent-note;
    in property <bool> accent-locked;
    in property <string> accent-value;
    callback set-accent(string);
    callback reset();
    callback opened();
}

component Slider inherits Rectangle {
    in property <int> lo;
    in property <int> hi;
    in property <int> value;
    in property <bool> enabled: true;
    callback changed-value(int);
    height: 20px;
    opacity: self.enabled ? 1 : 0.6;
    property <float> frac: (self.value - self.lo) / max(1, self.hi - self.lo);
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: parent.width * root.frac;
        height: 4px;
        border-radius: 2px;
        // A disabled <input type=range> is drawn grey whatever accent-color says.
        background: root.enabled ? Theme.accent : Theme.text-3;
    }
    Rectangle {
        x: (parent.width - 16px) * root.frac;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? Theme.accent : Theme.text-3;
        border-width: root.enabled ? 2px : 0px;
        border-color: #fff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000059;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : not-allowed;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.changed-value(round(root.lo + (root.hi - root.lo) * max(0, min(1, self.mouse-x / root.width))));
            }
        }
        moved => {
            if (self.pressed) {
                root.changed-value(round(root.lo + (root.hi - root.lo) * max(0, min(1, self.mouse-x / root.width))));
            }
        }
    }
}

component SliderRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> key;
    in property <int> lo;
    in property <int> hi;
    in property <int> value;
    in property <string> unit;
    in property <bool> locked;
    spacing: 12px;
    Text { width: 200px; text: root.label; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
    Slider {
        horizontal-stretch: 1;
        lo: root.lo;
        hi: root.hi;
        value: root.value;
        enabled: !root.locked;
        changed-value(v) => { ThemeP.set-slider(root.key, v); }
    }
    HorizontalLayout {
        width: 64px;
        spacing: 4px;
        alignment: end;
        Text { text: root.value + root.unit; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
        if root.locked: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                Icon { source: Icons.lock; size: 12px; tint: Theme.text-2; }
                TipZone { tip: T.t("theme.profile.locked-value"); mouse-cursor: default; }
            }
        }
    }
}

component AccentNote inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: Theme.border;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: Theme.dialog-bg;
                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: Theme.accent; }
            }
        }
    }
    Text { text: root.text; font-size: 13px; color: Theme.text-2; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
}

export component ThemeDialogView inherits Modal {
    open <=> ThemeDialog.open;
    refresh-key: Backdrop.refresh-tick;
    max-w: 580px;
    changed open => {
        if (self.open) {
            ThemeP.opened();
        }
    }
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 16px;
        padding-top: 18px;
        padding-bottom: 4px;
        spacing: 12px;
        VerticalLayout { alignment: center; Icon { source: Icons.palette; size: 18px; tint: Theme.accent; } }
        Text { text: T.t("theme.label"); font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        VerticalLayout { alignment: center; IconButton { size: 32px; round: true; icon: Icons.x; icon-size: 16px; tip: T.t("close"); clicked => { ThemeDialog.open = false; } } }
    }
    VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        // Skin.vue's :deep(.theme-body) never reaches the teleported modal
        // body, so Wails renders the stock .px-modal__body spacing.
        padding-top: 14px;
        padding-bottom: 4px;
        spacing: 12px;
        if ThemeP.has-profile-theme: Rectangle {
            height: pl.preferred-height;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.accent.mix(Theme.border, 0.35);
            background: Theme.accent.mix(Theme.panel-soft, 0.08);
            pl := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;
                VerticalLayout { alignment: center; Icon { source: Icons.photo-star; size: 18px; tint: Theme.accent; } }
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: T.t("theme.profile.title"); font-size: 13px; font-weight: 600; color: Theme.text; }
                    Text { text: ThemeP.profile-desc; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
                }
                VerticalLayout { alignment: center; Switch { checked: ThemeP.use-profile-theme; toggled(v) => { ThemeP.set-use-profile-theme(v); } } }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Text { width: 170px; text: T.t("theme.mode"); font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            PillTabs {
                width: 340px;
                md: true;
                stretch: true;
                enabled: !ThemeP.mode-locked;
                options: [
                    { value: "auto", label: T.t("theme.auto"), icon: Icons.circle-half-2, tip: T.t("theme.auto-tip") },
                    { value: "light", label: T.t("theme.light"), icon: Icons.sun },
                    { value: "dark", label: T.t("theme.dark"), icon: Icons.moon },
                ];
                current: ThemeP.mode;
                select(v) => { ThemeP.set-mode(v); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Divider { }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: T.t("theme.use-image"); font-size: 13px; font-weight: 600; color: Theme.text; }
                Text { text: T.t("theme.use-image-desc"); font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
            }
            VerticalLayout { alignment: center; Switch { checked: ThemeP.use-image; enabled: !ThemeP.image-locked; toggled(v) => { ThemeP.set-use-image(v); } } }
        }
        if ThemeP.use-image: tiles := Rectangle {
            property <length> gap: 8px;
            property <length> tw: (self.width - 3 * self.gap) / 4;
            height: ceil(ThemeP.tiles.length / 4) * (52px + self.gap) - self.gap;
            opacity: ThemeP.image-locked ? 0.45 : 1;
            for t[i] in ThemeP.tiles: Rectangle {
                x: mod(i, 4) * (tiles.tw + tiles.gap);
                y: floor(i / 4) * (52px + tiles.gap);
                width: tiles.tw;
                height: 52px;
                border-radius: 8px;
                background: Theme.panel-soft;
                border-width: t.on ? 2px : (t.custom && !t.uploaded ? 1.5px : 1px);
                border-color: t.on ? Theme.accent : Theme.border;
                tt := TipZone {
                    tip: t.label;
                    enabled: !ThemeP.image-locked;
                    clicked => { ThemeP.pick-tile(t.id); }
                }
                Icon {
                    y: (parent.height - 18px) / 2 - 6px;
                    source: t.icon;
                    size: 18px;
                    tint: t.on ? Theme.accent : (tt.has-hover ? Theme.text : Theme.text-2);
                }
                Text {
                    y: parent.height - self.height - 4px;
                    x: 6px;
                    width: parent.width - 12px;
                    text: t.label;
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                if t.custom: Rectangle {
                    x: parent.width - 26px;
                    y: 4px;
                    width: 22px;
                    height: 22px;
                    border-radius: 8px;
                    background: ut.has-hover ? Theme.accent : Theme.hover-bg;
                    Icon { source: Icons.upload; size: 13px; tint: ut.has-hover ? Theme.on-accent : Theme.text-2; }
                    ut := TipZone {
                        tip: T.t("bg.upload");
                        enabled: !ThemeP.image-locked;
                        clicked => { ThemeP.upload(t.id); }
                    }
                }
            }
        }
        if ThemeP.use-image && ThemeP.image-locked: Alert { tone: "info"; icon: Icons.info-circle; text: T.t("theme.profile.locked"); }
        if ThemeP.use-image && ThemeP.bg-error != "": Text { text: ThemeP.bg-error; font-size: 12px; font-weight: 600; color: Theme.error; wrap: word-wrap; }
        if ThemeP.use-image: Rectangle {
            height: sl.preferred-height;
            border-radius: 12px;
            background: Theme.panel-soft;
            sl := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 12px;
                SliderRow { label: T.t("theme.transparency"); key: "uiTrans"; lo: 5; hi: 85; value: ThemeP.trans; unit: "%"; locked: ThemeP.trans-locked; }
                SliderRow { label: T.t("theme.blur"); key: "uiBlur"; lo: 0; hi: 30; value: ThemeP.blur; unit: " px"; locked: ThemeP.blur-locked; }
                SliderRow { label: T.t("theme.dim"); key: "bgDim"; lo: 0; hi: 80; value: ThemeP.dim; unit: "%"; locked: ThemeP.dim-locked; }
            }
        }
        if ThemeP.use-image: AccentNote { text: ThemeP.accent-note; }
        if !ThemeP.use-image: HorizontalLayout {
            spacing: 12px;
            Text { width: 170px; text: T.t("theme.accent"); font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            if ThemeP.accent-locked: AccentNote { text: T.t("theme.accent-from-profile"); }
            if !ThemeP.accent-locked: HorizontalLayout {
                spacing: 8px;
                for c in ["#5b67e8", "#1f9e7a", "#c9484f", "#c98a2e", "#2f7fbf"]: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: c == "#5b67e8" ? #5b67e8 : c == "#1f9e7a" ? #1f9e7a : c == "#c9484f" ? #c9484f : c == "#c98a2e" ? #c98a2e : #2f7fbf;
                    border-width: ThemeP.accent-value == c ? 2px : 1px;
                    border-color: ThemeP.accent-value == c ? Theme.text : Theme.border;
                    TouchArea { mouse-cursor: pointer; clicked => { ThemeP.set-accent(c); } }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    ModalFooter {
        alignment: end;
        Btn { text: T.t("theme.reset"); pill: true; clicked => { ThemeP.reset(); } }
        Btn { text: T.t("theme.done"); kind: "primary"; pill: true; clicked => { ThemeDialog.open = false; } }
    }
}
