// Settings → Connections and Log tabs — port of ConnectionTab.vue,
// ConnectionRow.vue, topology/ConnectionTopology.vue and LogTab.vue.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { ListView } from "std-widgets.slint";
import { Icon, IconButton, Btn, TipZone, Spinner, ScrollArea, Modal, ModalBody, Divider, Input, Select, SelectOption, PillTabs, PillOption, Tag, Empty, DdPanel, DdItem } from "components.slint";

export struct ConnRow {
    id: string,
    host: string,
    conn-type: string,
    process: string,
    route: string,
    upload: string,
    download: string,
    up-speed: string,
    down-speed: string,
    live: bool,
    age: string,
    age-exact: string,
}

export struct ProcRow {
    key: string,
    name: string,
    count: int,
    download: string,
    upload: string,
    has-icon: bool,
    icon: image,
    core: bool,
}

export struct LogKV {
    label: string,
    value: string,
    kind: string, // text | ip | host | process | path
    path: string,
}

export struct LogSection {
    title: string,
    rows: [LogKV],
}

export struct TopoNode {
    x: length,
    y: length,
    w: length,
    h: length,
    color: color,
    label: string,
    tip: string,
}

export struct TopoLink {
    path: string,
    color: color,
    tip: string,
}

export struct LogLine {
    id: int, // LogEntry sequence: lets the list append/trim instead of rebuilding
    time: string,
    kind: string,
    tone: int, // 0 info, 1 warning, 2 error, 3 debug
    payload: string,
    // payload with every search match marked (.log-hit); empty when no search
    marked: styled-text,
    has-marks: bool,
}

export global ConnP {
    in-out property <string> view: "topology";
    callback set-view(string);
    in property <[ConnRow]> rows;
    in property <int> count;
    in-out property <string> search;
    callback search-edited(string);
    in property <[SelectOption]> sort-options;
    in property <string> sort-key: "time";
    in property <bool> sort-desc: true;
    callback set-sort(string);
    callback toggle-dir();
    in property <bool> paused;
    callback toggle-pause();
    callback close-all();
    callback open-log(string);
    callback copy-log(string);
    in property <bool> show-closed;
    callback set-show-closed(bool);
    // processes
    in property <[ProcRow]> procs;
    in property <string> selected-proc;
    in property <string> selected-proc-name;
    callback select-proc(string);
    // topology
    in property <[TopoNode]> topo-nodes;
    in property <[TopoLink]> topo-links;
    in property <bool> topo-paused;
    callback topo-toggle-pause();
    callback topo-size(length, length);
    // log dialog
    in-out property <bool> log-open;
    in property <string> log-title;
    in property <[LogSection]> log-sections;
    callback log-copy();
    callback kv-copy(string);
    callback kv-open(string);
    callback kv-folder(string);
}

export global LogsP {
    in property <[LogLine]> lines;
    // bumped on every update: a full 1000-line ring trims and appends without
    // changing the content height, so autoscroll cannot rely on that alone
    in property <int> lines-tick;
    in property <bool> has-any;
    in-out property <string> search;
    callback search-edited(string);
    in property <bool> paused;
    callback toggle-pause();
    in property <bool> autoscroll: true;
    callback toggle-autoscroll();
    callback copy-all();
    callback export();
    callback clear();
    in property <int> scroll-seq;
}

component ConnLine inherits Rectangle {
    in property <ConnRow> c;
    height: 58px;
    background: hov.has-hover ? Theme.hover-bg : transparent;
    hov := TouchArea { }
    if root.c.live: Rectangle { x: 0; width: 3px; background: Theme.accent; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            IconButton { size: 26px; icon: Icons.info-circle; icon-size: 16px; tip: T.t("connections.view-log"); clicked => { ConnP.open-log(root.c.id); } }
            IconButton { size: 26px; icon: Icons.copy; icon-size: 15px; tip: T.t("connections.copy-log"); clicked => { ConnP.copy-log(root.c.id); } }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0;
            Text { text: root.c.host; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; TipZone { tip: root.c.host.character-count > 40 ? root.c.host : ""; mouse-cursor: default; } }
            HorizontalLayout {
                spacing: 5px;
                Text { text: root.c.conn-type; font-size: 12px; color: Theme.text-2; letter-spacing: 0.2px; }
                if root.c.process != "": Text { text: "·"; font-size: 12px; color: Theme.text-2.with-alpha(0.5); }
                if root.c.process != "": Text { text: root.c.process; font-size: 12px; color: Theme.text-2; overflow: elide; max-width: 160px; TipZone { tip: root.c.process; mouse-cursor: default; } }
                if root.c.route != "": Text { text: "·"; font-size: 12px; color: Theme.text-2.with-alpha(0.5); }
                if root.c.route != "": Text { text: root.c.route; font-size: 12px; color: Theme.text-2; overflow: elide; horizontal-stretch: 1; TipZone { tip: root.c.route; mouse-cursor: default; } }
                if root.c.route == "": Rectangle { horizontal-stretch: 1; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                HorizontalLayout {
                    spacing: 3px;
                    VerticalLayout { alignment: center; Icon { source: Icons.arrow-up; size: 13px; tint: Theme.upload-color; } }
                    Text { text: root.c.upload; font-size: 13px; color: Theme.text; TipZone { tip: T.t("connections.upload"); mouse-cursor: default; } }
                }
                HorizontalLayout {
                    spacing: 3px;
                    VerticalLayout { alignment: center; Icon { source: Icons.arrow-down; size: 13px; tint: Theme.download-color; } }
                    Text { text: root.c.download; font-size: 13px; color: Theme.text; TipZone { tip: T.t("connections.download"); mouse-cursor: default; } }
                }
            }
            if root.c.live: HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Text { text: "↑ " + root.c.up-speed + "/s"; font-size: 11px; font-weight: 700; color: Theme.upload-color; }
                Text { text: "↓ " + root.c.down-speed + "/s"; font-size: 11px; font-weight: 700; color: Theme.download-color; }
            }
            if !root.c.live: HorizontalLayout {
                alignment: end;
                Text { text: root.c.age; font-size: 11px; color: Theme.text-3; TipZone { tip: root.c.age-exact; mouse-cursor: default; } }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

component Panel inherits Rectangle {
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    background: Theme.input-bg;
    clip: true;
}

component Topology inherits VerticalLayout {
    spacing: 10px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 16px;
    HorizontalLayout {
        Text { text: T.t("connections.topology-view"); font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        Btn {
            kind: "chip";
            height: 30px;
            font-size: 12px;
            icon-size: 13px;
            icon: ConnP.topo-paused ? Icons.player-play-filled : Icons.player-pause-filled;
            text: ConnP.topo-paused ? T.t("resume") : T.t("pause");
            clicked => { ConnP.topo-toggle-pause(); }
        }
    }
    canvas := Rectangle {
        vertical-stretch: 1;
        min-height: 320px;
        changed width => { ConnP.topo-size(self.width, self.height); }
        changed height => { ConnP.topo-size(self.width, self.height); }
        init => { ConnP.topo-size(self.width, self.height); }
        if ConnP.topo-nodes.length == 0: Empty {
            width: canvas.width;
            height: canvas.height;
            alignment: start; // UiEmpty sits at the top of .conn-panel / .topology
            icon: Icons.wifi-off;
            title: T.t("empty.connections.title");
            text: T.t("empty.connections.text");
        }
        for l in ConnP.topo-links: Path {
            width: canvas.width;
            height: canvas.height;
            viewbox-width: canvas.width / 1px;
            viewbox-height: canvas.height / 1px;
            commands: l.path;
            fill: l.color.with-alpha(0.4);
            stroke-width: 0;
        }
        for n in ConnP.topo-nodes: Rectangle {
            x: n.x;
            y: n.y;
            width: n.w;
            height: max(2px, n.h);
            background: n.color;
            border-width: 1px;
            border-color: Theme.border;
            TipZone { tip: n.tip; mouse-cursor: default; }
            Text {
                x: parent.width + 5px;
                y: (parent.height - self.height) / 2;
                text: n.label;
                font-size: 12px;
                font-weight: 500;
                color: Theme.text;
                width: 260px;
                overflow: elide;
            }
        }
    }
}

export component ConnectionsTab inherits VerticalLayout {
    padding-left: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    spacing: 12px;
    // .conn-bar is a wrapping flex row: actions first, then the view tabs,
    // which drop to their own line (left-aligned) when the row is too narrow.
    bar := Rectangle {
        property <bool> wrap: actions.preferred-width + 10px + views.preferred-width > self.width;
        height: self.wrap ? actions.preferred-height + 10px + 36px : max(actions.preferred-height, 36px);
        actions := HorizontalLayout {
            x: 0;
            y: bar.wrap ? 0 : (bar.height - self.preferred-height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: 10px;
            Btn { kind: "chip"; text: T.t("connections.close"); clicked => { ConnP.close-all(); } }
            if ConnP.view == "list": Select {
                horizontal-stretch: 0;
                variant: "pill";
                prefix-icon: Icons.arrows-sort;
                menu-width: 220px;
                options: ConnP.sort-options;
                current: ConnP.sort-key;
                tip: T.t("connections.sort.label");
                select(v) => { ConnP.set-sort(v); }
            }
            if ConnP.view == "list": VerticalLayout {
                alignment: center;
                IconButton {
                    round: true;
                    soft: true;
                    size: 36px;
                    icon: Icons.arrow-down;
                    tip: ConnP.sort-desc ? T.t("connections.sort.desc") : T.t("connections.sort.asc");
                    transform-rotation: ConnP.sort-desc ? 0deg : 180deg;
                    clicked => { ConnP.toggle-dir(); }
                }
            }
            if ConnP.view == "list": Btn {
                kind: "chip";
                icon: ConnP.paused ? Icons.player-play-filled : Icons.player-pause-filled;
                text: ConnP.paused ? T.t("resume") : T.t("pause");
                clicked => { ConnP.toggle-pause(); }
            }
            if ConnP.view == "list": Text { text: T.t1("connections.count", "n", ConnP.count); font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
        }
        views := PillTabs {
            x: bar.wrap ? 0 : actions.width + 10px;
            y: bar.wrap ? actions.height + 10px : (bar.height - self.height) / 2;
            width: self.preferred-width;
            height: 36px;
            md: true;
            options: [
                { value: "list", label: T.t("connections.list"), icon: Icons.list },
                { value: "topology", label: T.t("connections.topology-view"), icon: Icons.chart-sankey },
                { value: "process", label: T.t("connections.process-view"), icon: Icons.app-window },
            ];
            current: ConnP.view;
            select(v) => { ConnP.set-view(v); }
        }
    }
    if ConnP.view != "topology": Input {
        pill: true;
        icon: Icons.search;
        text <=> ConnP.search;
        placeholder: T.t("connections.search");
        clearable: true;
        edited(t) => { ConnP.search-edited(t); }
    }
    if ConnP.view == "list": Panel {
        vertical-stretch: 1;
        if ConnP.rows.length == 0: Empty {
            alignment: start; // UiEmpty sits at the top of .conn-panel / .topology
            icon: Icons.wifi-off;
            title: T.t("empty.connections.title");
            text: T.t("empty.connections.text");
        }
        if ConnP.rows.length > 0: ListView {
            for c in ConnP.rows: ConnLine { c: c; }
        }
    }
    if ConnP.view == "topology": Panel {
        vertical-stretch: 1;
        Topology { }
    }
    if ConnP.view == "process": Panel {
        vertical-stretch: 1;
        if ConnP.selected-proc == "": VerticalLayout {
            if ConnP.procs.length == 0: Empty {
                vertical-stretch: 1;
                alignment: start;
                icon: Icons.wifi-off;
                title: T.t("empty.connections.title");
                text: T.t("empty.connections.text");
            }
            if ConnP.procs.length > 0: ListView {
                for p in ConnP.procs: Rectangle {
                    height: 61px;
                    background: pt.has-hover ? Theme.hover-bg : transparent;
                    pt := TouchArea { mouse-cursor: pointer; clicked => { ConnP.select-proc(p.key); } }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                if p.core: Image { width: 36px; height: 36px; source: Icons.mihomo-core; }
                                if !p.core && p.has-icon: Image { width: 32px; height: 32px; source: p.icon; image-fit: contain; }
                                if !p.core && !p.has-icon: Icon { source: Icons.app-window; size: 30px; tint: Theme.text-2; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: p.name; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; TipZone { tip: p.name; clicked => { ConnP.select-proc(p.key); } } }
                                VerticalLayout { alignment: center; Tag { text: T.t1("connections.connections-count", "count", p.count); tone: "accent"; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text {
                                text: T.t("connections.download") + ": " + p.download + "   " + T.t("connections.upload") + ": " + p.upload;
                                font-size: 13px;
                                color: Theme.text-2;
                            }
                        }
                        VerticalLayout { alignment: center; Icon { source: Icons.chevron-right; size: 20px; tint: Theme.text.with-alpha(0.4); } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
            }
        }
        if ConnP.selected-proc != "": VerticalLayout {
            Rectangle {
                height: 42px;
                background: bt.has-hover ? Theme.hover-bg : Theme.panel-soft;
                bt := TouchArea { mouse-cursor: pointer; clicked => { ConnP.select-proc(""); } }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    VerticalLayout { alignment: center; Icon { source: Icons.arrow-left; size: 18px; } }
                    Text { text: T.t("connections.back"); font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    Text { text: "— " + ConnP.selected-proc-name; font-size: 14px; color: Theme.text-2; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            if ConnP.rows.length == 0: Empty {
                vertical-stretch: 1;
                alignment: start;
                icon: Icons.wifi-off;
                title: T.t("empty.connections.title");
                text: T.t("empty.connections.text");
            }
            if ConnP.rows.length > 0: ListView {
                for c in ConnP.rows: ConnLine { c: c; }
            }
        }
    }
}

component KVValue inherits Rectangle {
    in property <LogKV> kv;
    height: vt.preferred-height;
    vt := Text {
        width: parent.width;
        text: root.kv.value;
        font-size: 13px;
        color: root.kv.kind == "text" ? Theme.text : Theme.accent;
        wrap: word-wrap;
    }
    if root.kv.kind != "text": TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0;
        y: vt.preferred-height + 4px;
        width: 210px;
        height: mcol.preferred-height + 10px;
        close-policy: close-on-click-outside;
        DdPanel {
            mcol := VerticalLayout {
                padding: 4px;
                spacing: 2px;
                DdItem { text: T.t("connections.copy-value"); icon: Icons.copy; clicked => { menu.close(); ConnP.kv-copy(root.kv.value); } }
                if root.kv.kind == "ip": DdItem { text: "ipinfo.io"; icon: Icons.external-link; clicked => { menu.close(); ConnP.kv-open("https://ipinfo.io/" + root.kv.value); } }
                if root.kv.kind == "host": DdItem { text: T.t("connections.open-in-browser"); icon: Icons.external-link; clicked => { menu.close(); ConnP.kv-open("https://" + root.kv.value); } }
                if (root.kv.kind == "process" || root.kv.kind == "path") && root.kv.path != "": DdItem { text: T.t("connections.show-in-explorer"); icon: Icons.folder-open; clicked => { menu.close(); ConnP.kv-folder(root.kv.path); } }
            }
        }
    }
}

export component ConnDialogs inherits Rectangle {
    Modal {
        open <=> ConnP.log-open;
        max-w: 600px;
        HorizontalLayout {
            padding-left: 22px;
            padding-right: 16px;
            padding-top: 18px;
            padding-bottom: 4px;
            spacing: 10px;
            Text { text: ConnP.log-title; font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            IconButton { round: true; icon: Icons.copy; icon-size: 17px; tip: T.t("connections.copy-log"); clicked => { ConnP.log-copy(); } }
            IconButton { size: 32px; round: true; icon: Icons.x; icon-size: 16px; tip: T.t("close"); clicked => { ConnP.log-open = false; } }
        }
        ScrollArea {
            height: min(600px, sec.preferred-height);
            content-height: sec.preferred-height;
            // stock .px-modal__body padding (14 22 4): :deep(.log-body) misses the teleported modal
            sec := VerticalLayout {
                padding-top: 14px;
                padding-bottom: 4px;
                for s in ConnP.log-sections: VerticalLayout {
                    padding-bottom: 6px;
                    Text { text: s.title; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; color: Theme.accent; height: self.preferred-height + 11px; vertical-alignment: bottom; x: 42px; }
                    for kv in s.rows: HorizontalLayout {
                        padding-left: 42px;
                        padding-right: 42px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 8px;
                        Text { width: (parent.width - 84px) * 0.42; text: kv.label; font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
                        KVValue { kv: kv; horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}

export component LogsTab inherits VerticalLayout {
    padding-left: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    spacing: 12px;
    HorizontalLayout {
        spacing: 10px;
        Input {
            pill: true;
            min-width: 200px;
            icon: Icons.search;
            text <=> LogsP.search;
            placeholder: T.t("logs.search");
            clearable: true;
            edited(t) => { LogsP.search-edited(t); }
        }
        Btn {
            kind: "chip";
            icon: LogsP.paused ? Icons.player-play-filled : Icons.player-pause-filled;
            text: LogsP.paused ? T.t("resume") : T.t("pause");
            clicked => { LogsP.toggle-pause(); }
        }
        Btn {
            kind: "chip";
            icon: Icons.arrow-bar-to-down;
            text: T.t("logs.autoscroll");
            border-width: LogsP.autoscroll ? 1px : 0px;
            border-color: Theme.accent.with-alpha(0.45);
            fg-override: LogsP.autoscroll ? Theme.accent : Theme.text;
            clicked => { LogsP.toggle-autoscroll(); }
        }
        Rectangle { horizontal-stretch: 1; min-width: 0; }
        IconButton { round: true; soft: true; size: 36px; icon: Icons.copy; icon-size: 16px; enabled: LogsP.lines.length > 0; tip: T.t("logs.copy-all"); clicked => { LogsP.copy-all(); } }
        IconButton { round: true; soft: true; size: 36px; icon: Icons.download; icon-size: 16px; enabled: LogsP.lines.length > 0; tip: T.t("logs.export"); clicked => { LogsP.export(); } }
        IconButton { round: true; soft: true; danger: true; size: 36px; icon: Icons.trash; icon-size: 16px; enabled: LogsP.has-any; tip: T.t("logs.clear"); clicked => { LogsP.clear(); } }
    }
    Panel {
        vertical-stretch: 1;
        if !LogsP.has-any: Empty { icon: Icons.file-text; title: T.t("empty.logs.title"); text: T.t("empty.logs.text"); }
        if LogsP.has-any && LogsP.lines.length == 0: Empty { icon: Icons.search-off; title: T.t("empty.search.title"); text: T.t("empty.search.text"); }
        if LogsP.lines.length > 0: lv := ListView {
            changed content-height => {
                if (LogsP.autoscroll) {
                    self.content-y = min(0px, self.visible-height - self.content-height);
                }
            }
            property <int> tick: LogsP.lines-tick;
            changed tick => {
                if (LogsP.autoscroll) {
                    self.content-y = min(0px, self.visible-height - self.content-height);
                }
            }
            for l in LogsP.lines: Rectangle {
                height: lr.preferred-height;
                background: lt.has-hover ? Theme.hover-bg : transparent;
                lt := TouchArea { }
                lr := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 10px;
                    Text { text: l.time; font-size: 12px; font-family: Theme.mono; color: Theme.text-3; line-height-factor: 1.5 / 1.16; }
                    Text {
                        min-width: 56px;
                        text: l.kind;
                        font-size: 11px;
                        line-height-factor: 18 / (11 * 1.16); // same 18px line box as the 12px text
                        font-weight: 700;
                        font-family: Theme.mono;
                        color: l.tone == 2 ? Theme.error : l.tone == 1 ? Theme.warning : l.tone == 3 ? Theme.text-3 : Theme.info;
                    }
                    if !l.has-marks: Text { text: l.payload; font-size: 12px; font-family: Theme.mono; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; line-height-factor: 1.5 / 1.16; }
                    // the whole line wraps, every match marked like <mark class="log-hit">
                    // (StyledText draws colour, not a background)
                    if l.has-marks: StyledText {
                        horizontal-stretch: 1;
                        text: l.marked;
                        default-font-size: 12px;
                        default-font-family: Theme.mono;
                        default-color: Theme.text;
                    }
                }
            }
        }
    }
}
