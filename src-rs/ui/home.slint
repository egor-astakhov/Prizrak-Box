// Home page — port of views/Home.vue, components/home/*.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { Icon, IconButton, Btn, Card, Divider, InfoTip, Spinner, TipZone, DdPanel, DdItem, ScrollArea, Modal, ModalBody, ModalFooter, TextArea, Input } from "components.slint";

export struct AnnounceSeg {
    text: string,
    color: color,
    colored: bool,
}

export struct AnnounceLine {
    segs: [AnnounceSeg],
}

export global HomeP {
    // Snapshot aid: bumping it opens the welcome "+" menu.
    in property <int> debug-open-welcome: 0;
    in property <bool> has-profiles: false;
    in property <bool> loaded: false;
    // active profile card
    in property <string> title;
    in property <bool> has-renew;
    in property <bool> has-home;
    in property <bool> has-support;
    in property <bool> refreshing;
    in property <string> used;
    in property <string> available;
    in property <string> expire;
    in property <string> update;
    in property <string> update-exact;
    in property <[AnnounceLine]> announce;
    in property <bool> announce-clickable;
    in property <bool> show-renew-button;
    callback go-renew();
    callback go-home();
    callback go-support();
    callback switch-profiles();
    callback refresh();
    callback open-announce();
    // ip card
    in property <string> ip;
    in property <string> city;
    in property <string> country;
    in property <string> isp;
    in property <string> asn;
    in property <string> timezone;
    in property <bool> ip-loading;
    callback refresh-ip();
    callback open-ip();
    callback open-asn();
    // system card
    in property <string> os;
    in property <string> runtime;
    in property <bool> startup;
    in property <bool> admin;
    in property <string> port;
    in property <string> version;
}

// "Add profile" flow shared by Home and Profiles (AddProfileDialog.vue).
export global AddProfile {
    in-out property <bool> open;
    in-out property <string> content;
    in-out property <bool> use-age;
    in-out property <string> age-key;
    in property <bool> busy;
    callback submit();
    callback paste();
    callback open-file();
    callback open-manual();
}

export component AddMenuItems inherits VerticalLayout {
    callback done();
    padding: 4px;
    spacing: 2px;
    DdItem {
        text: T.t("profiles.add");
        icon: Icons.pencil;
        bold: true;
        pad-v: 9px;
        pad-h: 12px;
        clicked => { root.done(); AddProfile.open-manual(); }
    }
    DdItem {
        text: T.t("profiles.paste");
        icon: Icons.clipboard;
        bold: true;
        pad-v: 9px;
        pad-h: 12px;
        clicked => { root.done(); AddProfile.paste(); }
    }
    DdItem {
        text: T.t("profiles.open");
        icon: Icons.folder-open;
        bold: true;
        pad-v: 9px;
        pad-h: 12px;
        clicked => { root.done(); AddProfile.open-file(); }
    }
}

export component AddProfileDialog inherits Modal {
    opened => { first-field.focus-input(); }
    open <=> AddProfile.open;
    title: T.t("profiles.add");
    divided: true;
    ModalBody {
        divided: true;
        first-field := TextArea {
            height: 130px;
            text <=> AddProfile.content;
            mono: false;
            placeholder: T.t("profiles.placeholder");
        }
        if AddProfile.use-age: Rectangle {
            height: 36px;
            border-radius: 8px;
            border-width: 1px;
            border-color: age-in.has-focus ? Theme.accent : Theme.border;
            background: Theme.input-bg;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon { source: Icons.key; size: 15px; tint: Theme.text-3; }
                }
                age-in := Input {
                    border-width: 0;
                    background: transparent;
                    text <=> AddProfile.age-key;
                    placeholder: T.t("age.profile.keyPlaceholder");
                }
            }
        }
    }
    Divider { }
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 8px;
        IconButton {
            size: 30px;
            icon: Icons.key;
            icon-size: 17px;
            tint-override: AddProfile.use-age ? Theme.accent : Theme.text-3;
            tip: AddProfile.use-age ? T.t("age.profile.toggleOn") : T.t("age.profile.toggleOff");
            clicked => { AddProfile.use-age = !AddProfile.use-age; }
        }
        Rectangle { horizontal-stretch: 1; }
        Btn { text: T.t("cancel"); clicked => { AddProfile.open = false; } }
        Btn {
            text: T.t("add");
            kind: "primary";
            loading: AddProfile.busy;
            enabled: AddProfile.content != "" && !AddProfile.busy;
            clicked => { AddProfile.submit(); }
        }
    }
}

// ---- welcome (WelcomeScreen.vue) ----
component Welcome inherits Rectangle {
    VerticalLayout {
        alignment: center;
        padding: 40px;
        spacing: 0px;
        Text {
            text: T.t("onboarding.welcome.title");
            font-size: 24px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Rectangle { height: 10px; }
        Text {
            text: T.t("onboarding.welcome.subtitle");
            font-size: 16px;
            color: Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { height: 48px; }
        HorizontalLayout {
            alignment: center;
            add-btn := Rectangle {
                width: 120px;
                height: 120px;
                border-radius: 60px;
                background: Theme.accent;
                drop-shadow-blur: 36px;
                drop-shadow-offset-y: 14px;
                drop-shadow-color: Theme.accent.with-alpha(0.45);
                property <float> s: wt.pressed ? 0.97 : (wt.has-hover ? 1.05 : 1);
                animate s { duration: 200ms; }
                Image {
                    source: Icons.plus;
                    colorize: Theme.on-accent;
                    width: 44px * add-btn.s;
                    height: 44px * add-btn.s;
                }
                wt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { menu.show(); }
                }
                property <int> dbg: HomeP.debug-open-welcome;
                changed dbg => { menu.show(); }
                menu := PopupWindow {
                    x: (add-btn.width - 240px) / 2;
                    y: 128px;
                    width: 240px;
                    height: 3 * 34px + 2 * 2px + 2 * 4px + 2px; // items, gaps, padding, border
                    close-policy: close-on-click-outside;
                    DdPanel {
                        AddMenuItems { done => { menu.close(); } }
                    }
                }
            }
        }
        Rectangle { height: 14px; }
        Text {
            text: T.t("onboarding.welcome.add-profile");
            font-size: 16px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
    }
}

component StatItem inherits HorizontalLayout {
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    in property <string> tip;
    alignment: center;
    spacing: 6px;
    VerticalLayout {
        alignment: center;
        Icon { source: root.icon; size: 15px; tint: Theme.text-2; }
    }
    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.text-2;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        max-width: self.preferred-width;
    }
    Text {
        text: root.value;
        font-size: 13px;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
        TipZone { tip: root.tip; mouse-cursor: default; }
    }
}

component ProfileCard inherits Card {
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 14px;
        // ProfileToolbar.vue
        HorizontalLayout {
            spacing: 10px;
            HorizontalLayout {
                width: 92px;
                spacing: 4px;
                alignment: start;
                if HomeP.has-renew: IconButton { size: 28px; icon: Icons.credit-card; tip: T.t("profiles.renew"); clicked => { HomeP.go-renew(); } }
                if HomeP.has-home: IconButton { size: 28px; icon: Icons.home-shield; tip: T.t("profiles.home"); clicked => { HomeP.go-home(); } }
                if HomeP.has-support: IconButton { size: 28px; icon: Icons.headphones; tip: T.t("profiles.support"); clicked => { HomeP.go-support(); } }
            }
            Text {
                text: HomeP.title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                TipZone { tip: HomeP.title; mouse-cursor: default; }
            }
            HorizontalLayout {
                width: 92px;
                spacing: 4px;
                alignment: end;
                IconButton { size: 28px; icon: Icons.arrows-left-right; tip: T.t("onboarding.active-profile.switch-profiles"); clicked => { HomeP.switch-profiles(); } }
                IconButton { size: 28px; icon: Icons.refresh; loading: HomeP.refreshing; tip: T.t("onboarding.active-profile.refresh-profile"); clicked => { HomeP.refresh(); } }
                add := IconButton {
                    size: 28px;
                    icon: Icons.plus;
                    tip: T.t("profiles.add");
                    clicked => { addmenu.show(); }
                    addmenu := PopupWindow {
                        x: 28px - 240px;
                        y: 36px;
                        width: 240px;
                        height: 3 * 34px + 2 * 2px + 2 * 4px + 2px; // items, gaps, padding, border
                        close-policy: close-on-click-outside;
                        DdPanel { AddMenuItems { done => { addmenu.close(); } } }
                    }
                }
            }
        }
        Divider { }
        // ProfileStats.vue
        if HomeP.used != "" || HomeP.available != "" || HomeP.expire != "" || HomeP.update != "": GridLayout {
            spacing-horizontal: 14px;
            spacing-vertical: 10px;
            min-height: 56px;
            Row {
                if HomeP.used != "": StatItem { icon: Icons.chart-line; label: T.t("onboarding.active-profile.stats.used"); value: HomeP.used; }
                if HomeP.available != "": StatItem { icon: Icons.database; label: T.t("onboarding.active-profile.stats.available"); value: HomeP.available; }
            }
            Row {
                if HomeP.expire != "": StatItem { icon: Icons.calendar-exclamation; label: T.t("onboarding.active-profile.stats.expire"); value: HomeP.expire; }
                if HomeP.update != "": StatItem { icon: Icons.clock-check; label: T.t("onboarding.active-profile.stats.update"); value: HomeP.update; tip: HomeP.update-exact; }
            }
        }
        // AnnounceText.vue: "#RRGGBBword" colour codes, one row per line
        if HomeP.announce.length > 0: VerticalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 2px;
            for line in HomeP.announce: HorizontalLayout {
                alignment: center;
                for seg in line.segs: Text {
                    text: seg.text;
                    color: seg.colored ? seg.color : (at.has-hover && HomeP.announce-clickable ? Theme.text : Theme.text-2);
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
            at := TouchArea {
                enabled: HomeP.announce-clickable;
                mouse-cursor: HomeP.announce-clickable ? pointer : default;
                clicked => { HomeP.open-announce(); }
            }
        }
        if HomeP.show-renew-button: Rectangle {
            height: 38px;
            border-radius: 19px;
            background: Theme.accent.with-alpha(rt.has-hover ? 0.26 : 0.16);
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon { source: Icons.credit-card; size: 15px; tint: Theme.text; }
                }
                Text { text: T.t("profiles.renew"); font-size: 13px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            }
            rt := TouchArea { mouse-cursor: pointer; clicked => { HomeP.go-renew(); } }
        }
    }
}

component InfoLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> right: false;
    in property <bool> link: false;
    callback link-clicked();
    alignment: self.right ? end : start;
    spacing: 4px;
    Text {
        text: root.label + ":";
        font-size: 13px;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        font-size: 13px;
        color: Theme.text-2;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: root.right ? 0 : 1;
        TipZone { tip: root.value; mouse-cursor: default; }
    }
    if root.link: VerticalLayout {
        alignment: center;
        lk := Rectangle {
            width: 17px;
            height: 17px;
            border-radius: 8px;
            background: lt.has-hover ? Theme.hover-bg : transparent;
            Icon { source: Icons.external-link; size: 13px; tint: lt.has-hover ? Theme.accent : Theme.text-3; }
            lt := TipZone { tip: "ipinfo.io"; clicked => { root.link-clicked(); } }
        }
    }
}

component IpCard inherits Card {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: T.t("home.ip.title"); font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            VerticalLayout { alignment: center; InfoTip { size: 14px; tip: T.t("home.ip.service-tip"); } }
            Rectangle { horizontal-stretch: 1; }
            IconButton { size: 22px; icon: Icons.refresh; icon-size: 14px; loading: HomeP.ip-loading; tip: T.t("refresh"); clicked => { HomeP.refresh-ip(); } }
        }
        Rectangle { height: 10px; }
        Divider { }
        Rectangle { height: 10px; }
        VerticalLayout {
            spacing: 7px;
            InfoLine { label: T.t("home.ip.real"); value: HomeP.ip; link: HomeP.ip != ""; link-clicked => { HomeP.open-ip(); } }
            InfoLine { label: T.t("home.ip.city"); value: HomeP.city; }
            InfoLine { label: T.t("home.ip.country"); value: HomeP.country; }
            InfoLine { label: T.t("home.ip.isp"); value: HomeP.isp; }
            InfoLine { label: T.t("home.ip.asn"); value: HomeP.asn; link: HomeP.asn != ""; link-clicked => { HomeP.open-asn(); } }
            InfoLine { label: T.t("home.ip.time-zone"); value: HomeP.timezone; }
        }
    }
}

component SystemCard inherits Card {
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 0px;
        Text { text: T.t("home.system.title"); font-size: 14px; font-weight: 700; color: Theme.text; horizontal-alignment: right; height: 22px; vertical-alignment: center; }
        Rectangle { height: 10px; }
        Divider { }
        Rectangle { height: 10px; }
        VerticalLayout {
            spacing: 7px;
            InfoLine { right: true; label: T.t("home.system.os"); value: HomeP.os; }
            InfoLine { right: true; label: T.t("home.system.runtime"); value: HomeP.runtime; }
            InfoLine { right: true; label: T.t("home.system.startup"); value: HomeP.startup ? T.t("on") : T.t("off"); }
            InfoLine { right: true; label: T.t("home.system.admin"); value: HomeP.admin ? T.t("on") : T.t("off"); }
            InfoLine { right: true; label: T.t("home.system.port"); value: HomeP.port; }
            InfoLine { right: true; label: T.t("home.system.version"); value: HomeP.version; }
        }
    }
}

export component HomePage inherits Rectangle {
    if !HomeP.has-profiles && HomeP.loaded: Welcome { }
    if HomeP.has-profiles: ScrollArea {
        content-height: max(self.height, body.preferred-height);
        body := VerticalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 24px;
            padding-bottom: 28px;
            spacing: 14px;
            // Cards keep their natural height; only the spacer takes the free
            // space (.home-bottom { margin-top: auto }).
            ProfileCard { vertical-stretch: 0; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 14px;
                IpCard { horizontal-stretch: 1; }
                SystemCard { horizontal-stretch: 1; }
            }
        }
    }
}
