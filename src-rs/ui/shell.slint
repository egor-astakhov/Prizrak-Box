// Window chrome: sidebar (App.vue .app-side), header (MySearch + MyTitleBar),
// and the global overlays (toasts, loading, confirm, notices).
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App, Search, DdEntry, Toast } from "state.slint";
import { Glass } from "glass.slint";
import { Icon, IconButton, Btn, TipZone, Spinner, DdPanel, DdItem, ScrollArea, Modal, ModalBody, ModalFooter, Notice, NoticeText, NoticeActions, Input, Backdrop, ScrimLayer, PopupTipLayer } from "components.slint";

// Background drag/double-click zone for frameless windows (".drag").
export component DragZone inherits TouchArea {
    mouse-cursor: default;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            App.start-drag();
        }
    }
    double-clicked => { App.titlebar-double-click(); }
}

// ---- brand ----
component Brand inherits VerticalLayout {
    alignment: start;
    spacing: 10px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 56px;
            height: 56px;
            // --logo-shadow over a background image: drop-shadow(0 2px 6px #0000 .35)
            if Theme.use-image: Rectangle {
                border-radius: 12px;
                drop-shadow-blur: 6px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000059;
            }
            Rectangle {
                border-radius: 12px;
                clip: true;
                Image {
                    width: 56px;
                    height: 56px;
                    source: App.top-logo;
                    image-fit: contain;
                }
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        Glass {
            enabled: Theme.side-glass;
            fill: Theme.title-bg;
            border-radius: 999px;
            height: title.preferred-height + 6px;
            width: min(200px, title.preferred-width + 24px);
            // --title-shadow over a background image (0 1px 3px): a soft copy
            // one pixel lower; Slint has no text-shadow.
            if Theme.use-image: Text {
                x: 12px;
                y: 1px;
                width: parent.width - 24px;
                height: parent.height;
                text: App.top-title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.dark ? #0000008c : #ffffffb3;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            title := Text {
                x: 12px;
                width: parent.width - 24px;
                text: App.top-title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TipZone { tip: App.top-title.character-count > 18 ? App.top-title : ""; mouse-cursor: default; }
        }
    }
}

// ---- nav (MyNav.vue) ----
component NavButton inherits Glass {
    in property <string> key;
    in property <string> label;
    in property <image> icon;
    property <bool> on: App.menu == self.key;
    enabled: Theme.side-glass;
    fill: self.on ? Theme.accent : (ta.has-hover ? Theme.hover-bg : Theme.side-bg);
    border-radius: 19px;
    height: 38px; // padding 10px + 14px text line (.nav-btn / .mode-button)
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: 18px; tint: root.on ? Theme.on-accent : Theme.text; }
        }
        Text {
            text: root.label;
            font-size: 14px;
            font-weight: 600;
            color: root.on ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.navigate(root.key); }
    }
}

// ---- mode pill (MyRule.vue) ----
component RulePill inherits Glass {
    enabled: Theme.side-glass;
    fill: Theme.side-bg;
    border-radius: 999px;
    height: 34px;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt in App.show-direct
            ? [{ value: "rule", label: T.t("rules.rule") }, { value: "global", label: T.t("rules.global") }, { value: "direct", label: T.t("rules.direct") }]
            : [{ value: "rule", label: T.t("rules.rule") }, { value: "global", label: T.t("rules.global") }]: Rectangle {
            horizontal-stretch: 1;
            min-width: 0;
            border-radius: 999px;
            background: App.rule == opt.value ? Theme.accent : transparent;
            Text {
                width: parent.width - 8px;
                text: opt.label;
                font-size: 12px;
                font-weight: 600;
                color: App.rule == opt.value ? Theme.on-accent : (rt.has-hover ? Theme.text : Theme.text-2);
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            rt := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.set-rule(opt.value); }
            }
        }
    }
}

// ---- proxy / TUN switches (MyProxy.vue) ----
component ModeButton inherits Glass {
    in property <bool> on;
    in property <string> label;
    in property <image> icon;
    in property <int> pulse;
    callback clicked();
    enabled: Theme.side-glass;
    fill: self.on ? Theme.accent : (ta.has-hover ? Theme.hover-bg : Theme.side-bg);
    border-radius: 19px;
    height: 38px; // padding 10px + 14px text line (.nav-btn / .mode-button)
    clip: false;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: 18px; tint: root.on ? Theme.on-accent : Theme.text; }
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            color: root.on ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                opacity: root.on ? 1 : 0;
                // three pulses of the ring when the mode turns on
                ring := Rectangle {
                    property <float> phase: 0;
                    width: 8px * (1 + 1.5 * self.phase);
                    height: self.width;
                    x: (8px - self.width) / 2;
                    y: (8px - self.height) / 2;
                    border-radius: self.width / 2;
                    background: Theme.on-accent.with-alpha(0.5 * (1 - self.phase));
                    opacity: root.on ? 1 : 0;
                }
                Rectangle {
                    border-radius: 4px;
                    background: Theme.on-accent;
                }
            }
        }
    }
    property <duration> pulse-start;
    timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            if (animation-tick() - root.pulse-start > 5400ms) {
                ring.phase = 0;
                self.running = false;
            } else {
                ring.phase = min(1, mod((animation-tick() - root.pulse-start) / 1ms, 1800) / 1260);
            }
        }
    }
    changed pulse => {
        root.pulse-start = animation-tick();
        timer.running = true;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---- language / theme / quit round buttons (MyBottom.vue) ----
component SideRound inherits Glass {
    in property <image> icon;
    in property <string> tip;
    in property <bool> danger;
    in property <bool> force-hover;
    callback clicked();
    out property <bool> hovered: ta.has-hover;
    enabled: Theme.side-glass;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 1px;
    border-color: Theme.border;
    property <bool> hov: ta.has-hover || self.force-hover;
    fill: self.danger && self.hov ? Theme.error : (self.hov ? Theme.hover-bg : Theme.side-bg);
    Icon {
        source: root.icon;
        size: 17px;
        tint: root.danger && root.hov ? #fff : (root.hov ? Theme.text : Theme.text-2);
    }
    ta := TipZone {
        tip: root.tip;
        clicked => { root.clicked(); }
    }
}

export global ThemeDialog {
    in-out property <bool> open;
}

component Bottom inherits HorizontalLayout {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    alignment: space-between;
    lang-btn := SideRound {
        icon: Icons.language;
        tip: T.t("ui.language");
        force-hover: lang-popup-shown;
        clicked => { lang-popup.show(); }
        changed hovered => {
            if (self.hovered) {
                lang-popup.show();
            }
        }
        property <bool> lang-popup-shown: false;
        lang-popup := PopupWindow {
            x: 0;
            y: -self.height - 8px;
            width: 160px;
            height: 3 * 34px + 4 * 2px + 8px;
            close-policy: close-on-click-outside;
            DdPanel {
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for l in [{ id: "zh", name: "简体中文" }, { id: "en", name: "English" }, { id: "ru", name: "Русский" }]: DdItem {
                        text: l.name;
                        selected: App.language == l.id;
                        check: true;
                        clicked => {
                            App.set-language(l.id);
                            lang-popup.close();
                        }
                    }
                }
            }
        }
    }
    SideRound {
        icon: Icons.palette;
        tip: T.t("theme.label");
        clicked => { ThemeDialog.open = true; }
    }
    SideRound {
        icon: Icons.power;
        tip: T.t("quit.label");
        danger: true;
        clicked => { App.quit-dialog = true; }
    }
}

export component Sidebar inherits Rectangle {
    DragZone { }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 52px;
        padding-bottom: 16px;
        spacing: 14px;
        // Only the spacer below takes the free height (.app-side__spacer).
        Brand { vertical-stretch: 0; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            NavButton { key: "Home"; label: T.t("nav.home"); icon: Icons.home; }
            NavButton { key: "Setting"; label: T.t("nav.setting"); icon: Icons.settings; }
            NavButton { key: "Proxies"; label: T.t("nav.proxies"); icon: Icons.rocket; }
            NavButton { key: "Profiles"; label: T.t("nav.profiles"); icon: Icons.user-cog; }
        }
        if !App.hide-mode-switch: RulePill { vertical-stretch: 0; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            ModeButton {
                on: App.proxy-on;
                label: T.t("proxy-switch");
                icon: Icons.access-point;
                pulse: App.proxy-pulse;
                clicked => { App.toggle-proxy(); }
            }
            ModeButton {
                on: App.tun-on;
                label: "TUN";
                icon: App.tun-on ? Icons.shield-lock : Icons.shield;
                pulse: App.tun-pulse;
                clicked => { App.toggle-tun(); }
            }
        }
        Rectangle { vertical-stretch: 1; }
        Bottom { vertical-stretch: 0; }
    }
}

// ---- header proxy selector (MySearch.vue) ----
component SearchSeg inherits Rectangle {
    in property <image> lead-icon;
    in property <image> lead-image;
    in property <bool> lead-is-image;
    in property <string> lead-tip;
    in property <string> label;
    in property <string> value;
    in property <color> dot: transparent;
    in property <bool> open;
    callback clicked();
    height: 30px;
    border-radius: 15px;
    max-width: 250px;
    horizontal-stretch: 0;
    background: ta.has-hover || self.open ? Theme.hover-bg : transparent;
    min-width: lay.min-width;
    preferred-width: lay.preferred-width;
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            if root.lead-is-image: Image {
                width: 18px;
                height: 18px;
                source: root.lead-image;
                image-fit: contain;
            }
            if !root.lead-is-image: Icon { source: root.lead-icon; size: 15px; tint: Theme.text-2; }
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.text-2;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            min-width: 20px;
            horizontal-stretch: 1;
        }
        if root.dot != transparent: VerticalLayout {
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.dot; }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.chevron-down;
                size: 14px;
                tint: Theme.text.with-alpha(0.7);
                transform-rotation: root.open ? 180deg : 0deg;
                animate transform-rotation { duration: 150ms; }
            }
        }
    }
    ta := TipZone {
        tip: root.value;
        clicked => { root.clicked(); }
    }
}

component EntryList inherits Rectangle {
    in property <[DdEntry]> entries;
    in property <bool> proxies-mode;
    callback picked(string);
    ScrollArea {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        content-height: col.preferred-height;
        col := VerticalLayout {
            spacing: 2px;
            for e in root.entries: Rectangle {
                height: 34px;
                border-radius: 8px;
                background: e.selected ? Theme.accent.with-alpha(0.14) : (et.has-hover || nt.has-hover ? Theme.hover-bg : transparent);
                // row click area under the content, so the name's tooltip
                // zone above it receives the hover
                et := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(e.name); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    if root.proxies-mode: VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.tone(e.delay-tone); }
                    }
                    if !root.proxies-mode: VerticalLayout {
                        alignment: center;
                        if e.has-icon: Image { width: 18px; height: 18px; source: e.icon; image-fit: contain; }
                        if !e.has-icon: Icon { source: e.icon; size: 15px; tint: Theme.text-2; }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            x: 0;
                            width: min(self.preferred-width, parent.width);
                            height: parent.height;
                            text: e.label;
                            font-size: 13px;
                            font-weight: e.selected ? 600 : 400;
                            color: e.selected ? Theme.accent : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            // v-tip sits on the name itself (MySearch.vue)
                            nt := TipZone {
                                tip: e.label;
                                in-popup: true;
                                clicked => { root.picked(e.name); }
                            }
                        }
                    }
                    if root.proxies-mode: Text {
                        text: e.delay-text;
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.tone(e.delay-tone);
                        vertical-alignment: center;
                    }
                    if !root.proxies-mode && e.selected: VerticalLayout {
                        alignment: center;
                        Icon { source: Icons.check; size: 14px; tint: Theme.accent; }
                    }
                }
            }
        }
    }
    // the header lists' tooltips are drawn inside the popup (PopupTip)
    PopupTipLayer { x: 0; y: 0; width: root.width; height: root.height; }
}

export component SearchPill inherits Glass {
    enabled: Theme.side-glass;
    fill: Theme.side-bg;
    height: 38px;
    border-radius: 19px;
    border-width: 1px;
    border-color: Theme.border;
    clip: false;
    property <bool> g-open;
    property <bool> p-open;
    // .search-pill: 3px padding inside a 1px border (box-sizing: border-box)
    // — Slint's padding starts at the outer edge, so 4px puts the 30px
    // segments exactly in the middle of the 38px pill.
    lay := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        alignment: start;
        g := SearchSeg {
            lead-is-image: Search.group-has-icon;
            lead-image: Search.group-icon;
            lead-icon: Search.group-type-icon;
            label: T.t("proxySelector.group");
            value: Search.group == "" ? "—" : Search.group;
            open: g-popup-open;
            property <bool> g-popup-open: false;
            clicked => {
                Search.open-groups();
                gp.show();
            }
            gp := PopupWindow {
                x: 0;
                y: 38px;
                width: max(230px, min(320px, parent.width));
                height: min(320px, Search.groups.length * 36px + 10px);
                close-policy: close-on-click-outside;
                DdPanel {
                    EntryList {
                        entries: Search.groups;
                        picked(n) => {
                            Search.pick-group(n);
                            gp.close();
                        }
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle { width: 1px; height: 18px; background: Theme.border; }
        }
        p := SearchSeg {
            lead-icon: Icons.world;
            label: T.t("proxySelector.proxy");
            value: Search.proxy == "" ? T.t("ui.not-selected") : Search.proxy;
            dot: Theme.tone(Search.proxy-tone);
            clicked => {
                Search.open-proxies();
                pp.show();
            }
            property <int> dbg: Search.debug-open-proxies;
            changed dbg => {
                Search.open-proxies();
                pp.show();
            }
            pp := PopupWindow {
                x: 0;
                y: 38px;
                width: max(260px, min(340px, parent.width));
                height: min(320px, Search.proxies.length * 36px + 10px);
                close-policy: close-on-click-outside;
                DdPanel {
                    EntryList {
                        entries: Search.proxies;
                        proxies-mode: true;
                        picked(n) => {
                            Search.pick-proxy(n);
                            pp.close();
                        }
                    }
                }
            }
        }
    }
    width: min(560px, lay.preferred-width);
}

// ---- window buttons (MyTitleBar.vue) ----
component TitleBtn inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> close-btn;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: ta.has-hover ? (self.close-btn ? Theme.error : Theme.hover-bg) : transparent;
    Icon {
        source: root.icon;
        size: 18px;
        tint: ta.has-hover ? (root.close-btn ? #fff : Theme.text) : Theme.text-2;
    }
    ta := TipZone {
        tip: root.tip;
        clicked => { root.clicked(); }
    }
}

component TitleSep inherits VerticalLayout {
    alignment: center;
    Rectangle { width: 1px; height: 18px; background: Theme.border; }
}

export component TitleBar inherits Glass {
    enabled: Theme.side-glass;
    fill: Theme.side-bg;
    height: 38px;
    border-radius: 19px;
    border-width: 1px;
    border-color: Theme.border;
    width: lay.preferred-width;
    // .titlebar: 3px padding inside the 1px border (border-box) = 4px here
    lay := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        // macOS keeps the native traffic lights, so only "to tray" is shown.
        if Theme.is-mac: TitleBtn {
            icon: Icons.layout-bottombar-collapse;
            tip: T.t("minus");
            clicked => { App.win-hide(); }
        }
        // Windows / Linux draw their own min / max / close (frameless window);
        // close hides to the tray, quitting is the power button / tray Quit.
        if !Theme.is-mac: TitleBtn {
            icon: Icons.minus;
            tip: T.t("mini");
            clicked => { App.win-min(); }
        }
        if !Theme.is-mac: TitleSep { }
        if !Theme.is-mac: TitleBtn {
            icon: App.maximized ? Icons.copy : Icons.square;
            tip: App.maximized ? T.t("restore") : T.t("max");
            clicked => { App.win-max(); }
        }
        if !Theme.is-mac: TitleSep { }
        if !Theme.is-mac: TitleBtn {
            icon: Icons.x;
            tip: T.t("minus");
            close-btn: true;
            clicked => { App.win-close(); }
        }
    }
}

export component Header inherits Rectangle {
    DragZone { }
    HorizontalLayout {
        padding-right: 14px;
        spacing: 12px;
        alignment: space-between;
        VerticalLayout {
            alignment: center;
            if App.menu != "Proxies": SearchPill { }
        }
        VerticalLayout {
            alignment: center;
            TitleBar { }
        }
    }
}

// ---- toasts + loading overlay (UiToast.vue) ----
export component ToastLayer inherits Rectangle {
    VerticalLayout {
        y: 74px;
        x: (root.width - self.width) / 2;
        width: min(560px, root.width - 32px);
        height: self.preferred-height;
        spacing: 8px;
        alignment: start;
        for t in App.toasts: HorizontalLayout {
            alignment: center;
            Rectangle {
                background: Theme.dialog-bg;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 12px;
                drop-shadow-blur: 30px;
                drop-shadow-offset-y: 12px;
                drop-shadow-color: #0000004d;
                width: min(560px, row.preferred-width);
                height: row.preferred-height;
                row := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 9px;
                    padding-bottom: 9px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            size: 16px;
                            source: t.kind == "success" ? Icons.circle-check : t.kind == "error" ? Icons.circle-x : t.kind == "warning" ? Icons.alert-triangle : Icons.info-circle;
                            tint: t.kind == "success" ? Theme.success : t.kind == "error" ? Theme.error : t.kind == "warning" ? Theme.warning : Theme.info;
                        }
                    }
                    Text {
                        text: t.text;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        max-width: 500px;
                    }
                }
                TouchArea { clicked => { App.dismiss-toast(t.id); } }
            }
        }
    }
}

export component LoadingLayer inherits Rectangle {
    property <bool> on: App.loading;
    visible: self.on && lscrim.ready && !lscrim.hidden-for-capture;
    lscrim := ScrimLayer { active: root.on; }
    TouchArea { mouse-cursor: progress; }
    Rectangle {
        width: lay.preferred-width;
        height: lay.preferred-height;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #00000059;
        lay := HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Spinner { size: 22px; tint: Theme.text; }
            }
            if App.loading-text != "": Text {
                text: App.loading-text;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
    }
}

// ---- global dialogs ----
export component GlobalDialogs inherits Rectangle {
    // service install offer (MyProxy.vue)
    Modal {
        open <=> App.service-dialog;
        title: T.t("service.dialog-title");
        icon: Icons.shield-lock;
        max-w: 450px;
        ModalBody {
            Text { text: T.t("service.dialog-message"); font-size: 14px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: T.t("service.dialog-description"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
            Text { text: T.t("service.dialog-restart-admin"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
        }
        ModalFooter {
            Btn { text: T.t("cancel"); clicked => { App.service-dialog = false; } }
            Btn { text: T.t("service.install-btn"); kind: "primary"; clicked => { App.install-service(); } }
        }
    }
    Modal {
        open <=> App.admin-choice-dialog;
        title: T.t("service.admin-title");
        icon: Icons.shield-lock;
        max-w: 450px;
        ModalBody {
            Text { text: T.t("service.admin-message"); font-size: 14px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: T.t("service.admin-description"); font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
        }
        ModalFooter {
            Btn { text: T.t("cancel"); clicked => { App.admin-choice-dialog = false; } }
            Btn { text: T.t("service.admin-run-btn"); clicked => { App.run-tun-without-service(); } }
            Btn { text: T.t("service.admin-install-btn"); kind: "primary"; clicked => { App.install-service(); } }
        }
    }
    // quit confirmation (Off.vue)
    Notice {
        open <=> App.quit-dialog;
        tone: "error";
        icon: Icons.power;
        title: T.t("quit.confirm.title");
        NoticeText { text: T.t("quit.confirm.text"); }
        NoticeActions {
            Btn { text: T.t("cancel"); stretch: true; clicked => { App.quit-dialog = false; } }
            Btn { text: T.t("quit.confirm.ok"); kind: "danger"; stretch: true; clicked => { App.quit-dialog = false; App.quit(); } }
        }
    }
    // update available (App.vue)
    Notice {
        open: App.update-dialog;
        tone: "accent";
        icon: Icons.download;
        title: T.t("updates.notification.title");
        closed => { App.update-dismiss(); }
        NoticeText { text: T.t1("updates.notification.message", "version", App.update-version); }
        NoticeActions {
            Btn { text: T.t("close"); stretch: true; clicked => { App.update-dismiss(); } }
            Btn { text: T.t("updates.actions.open"); kind: "primary"; stretch: true; clicked => { App.update-open(); } }
        }
    }
    // HWID (HwidNotSupportedDialog / HwidMaxDevicesDialog)
    Notice {
        open: App.hwid-error == "not-supported";
        tone: "warning";
        large-icon: true;
        max-w: 420px;
        icon: Icons.alert-circle;
        title: T.t("hwid.not-supported.title");
        closed => { App.hwid-close(); }
        NoticeText { text: T.t("hwid.not-supported.message"); font-size: 14px; line-height-factor: 1.6 / 1.16; }
        NoticeActions {
            Btn { text: T.t("cancel"); stretch: true; clicked => { App.hwid-close(); } }
            Btn {
                text: T.t("hwid.not-supported.go-settings");
                kind: "primary";
                stretch: true;
                clicked => {
                    App.hwid-close();
                    App.set-setting-tab("app");
                    App.navigate("Setting");
                }
            }
        }
    }
    Notice {
        open: App.hwid-error == "max-devices";
        tone: "error";
        large-icon: true;
        max-w: 420px;
        icon: Icons.alert-octagon;
        title: T.t("hwid.max-devices.title");
        closed => { App.hwid-close(); }
        NoticeText { text: T.t("hwid.max-devices.message"); font-size: 14px; line-height-factor: 1.6 / 1.16; }
        NoticeActions {
            Btn { text: T.t("cancel"); stretch: true; clicked => { App.hwid-close(); } }
            if App.hwid-support-url != "": Btn {
                text: T.t("hwid.max-devices.support");
                icon: Icons.headset;
                kind: "primary";
                stretch: true;
                clicked => { App.hwid-open-support(); }
            }
        }
    }
    // subscription alert (SubscriptionAlertModal.vue)
    Notice {
        open: App.sub-alert-open;
        tone: "warning";
        max-w: 380px;
        title: App.sub-alert-profile;
        top-image: App.sub-alert-logo;
        closed => { App.sub-alert-close(); }
        Rectangle {
            height: pill.preferred-height;
            border-radius: 12px;
            background: Theme.warning.with-alpha(0.14);
            pill := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Icon { source: Icons.bell; size: 17px; tint: Theme.warning; }
                }
                Text { text: App.sub-alert-title; font-size: 14px; font-weight: 600; color: Theme.warning; wrap: word-wrap; }
            }
        }
        if App.sub-alert-text != "": NoticeText { text: App.sub-alert-text; }
        NoticeActions {
            Btn { text: T.t("close"); stretch: true; clicked => { App.sub-alert-close(); } }
            if App.sub-alert-renew: Btn {
                text: T.t("profiles.renew");
                kind: "primary";
                stretch: true;
                clicked => { App.sub-alert-renew-clicked(); }
            }
        }
    }
    // first profile info (FirstProfileModal.vue)
    Notice {
        open <=> App.first-profile-info;
        tone: "info";
        max-w: 440px;
        icon: Icons.info-circle;
        close-on-overlay: false;
        close-on-esc: false;
        title: T.t("onboarding.first-profile-info.title");
        NoticeText { text: T.t("onboarding.first-profile-info.message"); font-size: 14px; line-height-factor: 1.6 / 1.16; }
        NoticeActions {
            alignment: center;
            // .first-profile-ok: padding 10px 24px, 14px text
            Btn {
                text: T.t("onboarding.first-profile-info.ok");
                kind: "primary";
                min-width: 120px;
                height: 38px;
                font-size: 14px;
                clicked => { App.first-profile-ok(); }
            }
        }
    }
    // confirm() (UiConfirm.vue)
    Notice {
        open: App.confirm-open;
        tone: "error";
        icon: App.confirm-icon;
        title: App.confirm-title;
        closed => { App.confirm-result(false); }
        if App.confirm-text != "": NoticeText { text: App.confirm-text; }
        NoticeActions {
            Btn { text: T.t("cancel"); stretch: true; clicked => { App.confirm-result(false); } }
            Btn { text: App.confirm-ok == "" ? T.t("confirm.label") : App.confirm-ok; kind: "danger"; stretch: true; clicked => { App.confirm-result(true); } }
        }
    }
    // deep-link import (DeepLinkImportOverlay.vue)
    if App.deeplink-importing: Rectangle {
        visible: dscrim.ready && !dscrim.hidden-for-capture;
        dscrim := ScrimLayer { }
        TouchArea { }
        Rectangle {
            width: min(400px, root.width - 48px);
            height: dl.preferred-height;
            background: Theme.dialog-bg;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 24px;
            drop-shadow-color: #00000066;
            dl := VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 34px;
                padding-bottom: 24px;
                spacing: 0px;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 22px;
                    Rectangle {
                        width: 60px;
                        height: 60px;
                        Rectangle { border-radius: 30px; border-width: 4px; border-color: Theme.border; }
                        Path {
                            width: 60px;
                            height: 60px;
                            viewbox-width: 60;
                            viewbox-height: 60;
                            stroke: Theme.accent;
                            stroke-width: 4px;
                            fill: transparent;
                            commands: "M 8.8 8.8 A 29 29 0 0 1 51.2 8.8";
                            transform-rotation: mod(animation-tick() / 1ms, 1000) * 360deg / 1000;
                        }
                    }
                }
                Text { text: App.deeplink-message; font-size: 16px; font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle { height: 8px; }
                Text { text: T.t("profiles.deeplink.cancel-hint"); font-size: 13px; color: Theme.text-2; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle { height: 20px; }
                Btn {
                    text: App.deeplink-cancel;
                    kind: "danger-soft";
                    stretch: true;
                    height: 40px;
                    font-size: 14px;
                    clicked => { App.deeplink-cancel-clicked(); }
                }
            }
        }
    }
}
