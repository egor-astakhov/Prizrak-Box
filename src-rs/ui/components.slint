// Building blocks — port of src/components/ui/* and src/styles/ui.css.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";

export struct PillOption {
    value: string,
    label: string,
    icon: image,
    tip: string,
}

export struct SelectOption {
    value: string,
    label: string,
}

// ---- tooltip (UiTooltip.vue / v-tip) ----
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> below: true;
    in-out property <bool> visible;
    in-out property <int> owner;
    in-out property <int> seq;
}

// Tooltip state for elements inside a PopupWindow: a popup has its own
// coordinate space (absolute-position is relative to the popup) and is drawn
// above the window, so its tooltips are drawn by a PopupTipLayer inside it.
// Only one popup is open at a time.
export global PopupTip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> top;
    in-out property <length> bottom;
    in-out property <bool> visible;
    in-out property <int> owner;
}

// Invisible hover tracker that shows `tip` for its parent after 300 ms —
// above it, or below when it is within 76 px of the window top (tooltip.ts).
export component TipZone inherits TouchArea {
    in property <string> tip;
    // Inside a PopupWindow: drawn by that popup's PopupTipLayer.
    in property <bool> in-popup: false;
    property <int> my-id: 0;
    mouse-cursor: pointer;
    timer := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.has-hover && root.tip != "") {
                Tip.seq += 1;
                root.my-id = Tip.seq;
                if (root.in-popup) {
                    PopupTip.owner = root.my-id;
                    PopupTip.text = root.tip;
                    PopupTip.x = root.absolute-position.x + root.width / 2;
                    PopupTip.top = root.absolute-position.y;
                    PopupTip.bottom = root.absolute-position.y + root.height;
                    PopupTip.visible = true;
                } else {
                    Tip.owner = root.my-id;
                    Tip.text = root.tip;
                    Tip.x = root.absolute-position.x + root.width / 2;
                    Tip.below = root.absolute-position.y < 76px;
                    Tip.y = Tip.below ? root.absolute-position.y + root.height + 9px : root.absolute-position.y - 9px;
                    Tip.visible = true;
                }
            }
        }
    }
    function hide-mine() {
        if (Tip.owner == self.my-id) {
            Tip.visible = false;
        }
        if (PopupTip.owner == self.my-id) {
            PopupTip.visible = false;
        }
    }
    changed has-hover => {
        if (self.has-hover) {
            timer.running = self.tip != "";
        } else {
            timer.running = false;
            self.hide-mine();
        }
    }
    changed pressed => {
        if (self.pressed) {
            self.hide-mine();
        }
    }
}

export component TooltipLayer inherits Rectangle {
    if Tip.visible && Tip.text != "": Rectangle {
        property <length> w: min(280px, label.preferred-width + 24px);
        x: max(8px, min(Tip.x - self.w / 2, root.width - self.w - 8px));
        y: Tip.below ? Tip.y : Tip.y - self.height;
        width: self.w;
        height: label.preferred-height + 16px;
        background: Theme.tip-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000059;
        label := Text {
            x: 12px;
            width: parent.width - 24px;
            text: Tip.text;
            color: #f2f2f4;
            font-size: 13px;
            font-weight: 500;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

// Tooltip bubble inside a PopupWindow (see PopupTip): above the element, or
// below it when there is no room above inside the popup.
export component PopupTipLayer inherits Rectangle {
    if PopupTip.visible && PopupTip.text != "": Rectangle {
        property <length> w: min(min(280px, root.width - 8px), label.preferred-width + 24px);
        property <length> h: label.preferred-height + 16px;
        // PopupTip holds popup coordinates; this layer may sit anywhere in it.
        property <length> ax: PopupTip.x - root.absolute-position.x;
        property <length> at: PopupTip.top - root.absolute-position.y;
        property <length> ab: PopupTip.bottom - root.absolute-position.y;
        property <bool> below: self.at - 9px - self.h < 4px;
        x: max(4px, min(self.ax - self.w / 2, root.width - self.w - 4px));
        y: self.below ? self.ab + 9px : self.at - 9px - self.h;
        width: self.w;
        height: self.h;
        background: Theme.tip-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000059;
        label := Text {
            x: 12px;
            width: parent.width - 24px;
            text: PopupTip.text;
            color: #f2f2f4;
            font-size: 13px;
            font-weight: 500;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

// ---- icon ----
export component Icon inherits Image {
    in property <length> size: 16px;
    in property <color> tint: Theme.text;
    width: self.size;
    height: self.size;
    colorize: self.tint;
    image-fit: contain;
}

// ---- spinner (UiSpinner.vue) ----
export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <color> tint: Theme.text-2;
    width: self.size;
    height: self.size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 12 2 A 10 10 0 1 1 2 12";
        transform-rotation: mod(animation-tick() / 0.7ms, 1000) * 360deg / 1000;
    }
}

// ---- icon button (UiIconButton.vue) ----
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 32px;
    in property <length> icon-size: 15px;
    in property <bool> round: false;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> soft: false;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    in property <string> tip;
    in property <color> tint-override: transparent;
    callback clicked();
    width: self.size;
    height: self.size;
    border-radius: self.round ? self.size / 2 : 8px;
    opacity: self.enabled ? 1 : 0.45;
    property <bool> hover: ta.has-hover && self.enabled;
    background: self.danger && self.hover ? Theme.error
        : self.active ? Theme.accent.with-alpha(0.16)
        : self.hover ? Theme.hover-bg
        : self.soft ? Theme.panel-soft : transparent;
    animate background { duration: 150ms; }
    property <color> fg: self.danger && self.hover ? #fff
        : self.active ? Theme.accent
        : self.tint-override != transparent ? self.tint-override
        : (self.hover || self.soft) ? Theme.text : Theme.text-2;
    if !root.loading: Icon {
        source: root.icon;
        size: root.icon-size;
        tint: root.fg;
    }
    if root.loading: Spinner {
        size: root.icon-size - 2px;
        tint: root.fg;
    }
    ta := TipZone {
        tip: root.tip;
        enabled: root.enabled;
        mouse-cursor: root.loading ? progress : pointer;
        clicked => {
            if (root.enabled && !root.loading) {
                root.clicked();
            }
        }
    }
}

// ---- button (.px-btn) ----
export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> kind: "normal"; // normal | primary | danger | danger-soft | soft | input | chip
    in property <bool> small: false;
    in property <bool> pill: false;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    in property <string> tip;
    in property <length> icon-size: 14px;
    in property <length> font-size: self.small ? 12px : 13px;
    in property <bool> stretch: false;
    callback clicked();
    property <bool> hover: ta.has-hover && self.enabled;
    height: self.kind == "chip" ? 36px : (self.small ? 28px : 34px);
    in property <image> trail-icon;
    // flex: 1 — stretched siblings share the row equally (Slint hands out
    // free space from the minimum, so the basis must be zero for both)
    min-width: self.stretch ? 0px : lay.min-width;
    max-width: self.stretch ? 100000px : lay.preferred-width;
    preferred-width: self.stretch ? 0px : lay.preferred-width;
    horizontal-stretch: self.stretch ? 1 : 0;
    border-radius: self.kind == "chip" || self.pill ? self.height / 2 : 8px;
    border-width: self.kind == "normal" || self.kind == "soft" || self.kind == "input" ? 1px : 0px;
    border-color: Theme.border;
    opacity: self.enabled ? 1 : 0.5;
    background: self.kind == "primary" ? (self.hover ? Theme.accent.mix(Theme.text, 0.88) : Theme.accent)
        : self.kind == "danger" ? (self.hover ? Theme.error.mix(#000, 0.88) : Theme.error)
        : self.kind == "danger-soft" ? Theme.error.with-alpha(self.hover ? 0.22 : 0.14)
        : self.hover ? Theme.hover-bg
        : self.kind == "soft" || self.kind == "chip" ? Theme.panel-soft
        : self.kind == "input" ? Theme.input-bg : transparent;
    animate background { duration: 150ms; }
    in property <color> fg-override: transparent;
    property <color> fg: self.fg-override != transparent ? self.fg-override
        : self.kind == "primary" ? Theme.on-accent
        : self.kind == "danger" ? #fff
        : self.kind == "danger-soft" ? Theme.error : Theme.text;
    lay := HorizontalLayout {
        padding-left: root.kind == "chip" ? 14px : (root.small ? 14px : 16px);
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;
        if root.loading: VerticalLayout {
            alignment: center;
            Spinner { size: 12px; tint: root.fg; }
        }
        if root.icon.width > 0 && !root.loading: VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: root.icon-size; tint: root.fg; }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.trail-icon.width > 0: VerticalLayout {
            alignment: center;
            Icon { source: root.trail-icon; size: 12px; tint: root.fg; }
        }
    }
    ta := TipZone {
        tip: root.tip;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if (root.enabled && !root.loading) {
                root.clicked();
            }
        }
    }
}

// ---- switch (UiSwitch.vue) ----
export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    callback toggled(bool);
    width: 42px;
    height: 24px;
    border-radius: 12px;
    border-width: self.checked ? 0px : 1px;
    border-color: Theme.border;
    background: self.checked ? Theme.accent : Theme.input-bg;
    opacity: !self.enabled ? 0.5 : (self.loading ? 0.7 : 1);
    animate background { duration: 150ms; }
    // .px-switch__knob: top/left 2px inside the 1px border (box-sizing:
    // border-box), i.e. 3px from every outer edge; 20px + border when on.
    Rectangle {
        x: root.checked ? 21px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #fff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000059;
        animate x { duration: 150ms; }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if (root.enabled && !root.loading) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

// ---- segmented pills (UiPillTabs.vue / .px-seg) ----
export component PillTabs inherits Rectangle {
    in property <[PillOption]> options;
    in property <string> current;
    in property <bool> md: false;
    in property <bool> stretch: false;
    in property <bool> enabled: true;
    callback select(string);
    background: Theme.panel-soft;
    border-radius: 999px;
    opacity: self.enabled ? 1 : 0.55;
    horizontal-stretch: self.stretch ? 1 : 0;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt in root.options: Rectangle {
            property <bool> on: opt.value == root.current;
            property <bool> icon-only: opt.label == "";
            border-radius: 999px;
            horizontal-stretch: root.stretch ? 1 : 0;
            height: root.md && !self.icon-only ? 30px : (self.icon-only ? 30px : 26px);
            min-width: self.icon-only ? 30px : inner.min-width;
            background: self.on ? Theme.accent : transparent;
            animate background { duration: 120ms; }
            inner := HorizontalLayout {
                padding-left: parent.icon-only ? 0px : 14px;
                padding-right: self.padding-left;
                spacing: 6px;
                alignment: center;
                if opt.icon.width > 0: VerticalLayout {
                    alignment: center;
                    Icon {
                        source: opt.icon;
                        size: root.md ? 16px : 14px;
                        tint: on ? Theme.on-accent : (pt.has-hover ? Theme.text : Theme.text-2);
                    }
                }
                if opt.label != "": Text {
                    text: opt.label;
                    font-size: root.md ? 13px : 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: on ? Theme.on-accent : (pt.has-hover ? Theme.text : Theme.text-2);
                }
            }
            pt := TipZone {
                tip: opt.tip;
                enabled: root.enabled;
                clicked => {
                    if (root.enabled && opt.value != root.current) {
                        root.select(opt.value);
                    }
                }
            }
        }
    }
}

// ---- tag (.px-tag) ----
export component Tag inherits Rectangle {
    in property <string> text;
    in property <string> tone: ""; // success | accent | warning | error
    in property <bool> spinner: false;
    in property <length> font-size: 11px;
    property <color> fg: self.tone == "success" ? Theme.success
        : self.tone == "accent" ? Theme.accent
        : self.tone == "warning" ? Theme.warning
        : self.tone == "error" ? Theme.error : Theme.text-2;
    background: self.tone == "" ? Theme.panel-soft : self.fg.with-alpha(self.tone == "accent" ? 0.18 : 0.16);
    border-radius: 999px;
    height: lay.preferred-height;
    min-width: lay.min-width;
    horizontal-stretch: 0;
    lay := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 5px;
        if root.spinner: VerticalLayout {
            alignment: center;
            Spinner { size: 10px; tint: root.fg; }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// ---- card / divider ----
export component Card inherits Rectangle {
    background: Theme.input-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component VDivider inherits Rectangle {
    width: 1px;
    height: 20px;
    background: Theme.border;
}

// ---- info "i" with tooltip (.px-info) ----
export component InfoTip inherits Rectangle {
    in property <string> tip;
    in property <length> size: 13px;
    width: self.size;
    height: self.size;
    Icon { source: Icons.info-circle; size: root.size; tint: Theme.text-3; }
    TipZone { tip: root.tip; mouse-cursor: help; }
}

// ---- text input (.px-input) ----
export component Input inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> small: false;
    in property <bool> pill: false;
    in property <bool> mono: false;
    in property <bool> password: false;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> accent-border: false;
    in property <bool> read-only: false;
    in property <bool> clearable: false;
    callback edited(string);
    callback accepted(string);
    callback escape();
    // true: Esc is this field's own (cancel editing); otherwise it bubbles up
    // (an open dialog closes, as with the web shells' global Esc handler).
    in property <bool> handles-escape: false;
    in property <length> text-size: self.small ? 12px : 13px;
    in property <int> text-weight: 400;
    in property <TextHorizontalAlignment> text-align: left;
    callback focused-changed(bool);
    out property <bool> has-focus: ti.has-focus;
    public function focus-input() { ti.focus(); }
    public function select-all() { ti.select-all(); }
    height: self.pill ? 36px : (self.small ? 28px : 36px);
    border-radius: self.pill ? 18px : 8px;
    border-width: 1px;
    border-color: ti.has-focus || self.accent-border ? Theme.accent : Theme.border;
    background: Theme.input-bg;
    opacity: self.enabled ? 1 : 0.5;
    horizontal-stretch: 1;
    property <length> pad-l: self.icon.width > 0 ? 34px : (self.pill ? 16px : (self.small ? 10px : 12px));
    if root.icon.width > 0: Icon {
        x: 12px;
        source: root.icon;
        size: 15px;
        tint: Theme.text-3;
    }
    Rectangle {
        x: root.pad-l;
        width: root.width - root.pad-l - (root.clearable && root.text != "" ? 30px : (root.pill ? 16px : 10px));
        clip: true;
        ti := TextInput {
            width: 100%;
            height: 100%;
            text <=> root.text;
            color: Theme.text;
            font-size: root.text-size;
            font-weight: root.text-weight;
            horizontal-alignment: root.text-align;
            font-family: root.mono ? Theme.mono : "";
            vertical-alignment: center;
            single-line: true;
            enabled: root.enabled;
            read-only: root.read-only;
            input-type: root.password ? InputType.password : InputType.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            changed has-focus => { root.focused-changed(self.has-focus); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.escape();
                    return root.handles-escape ? accept : reject;
                }
                return reject;
            }
        }
        if root.text == "": Text {
            text: root.placeholder;
            color: Theme.text-3;
            font-size: root.small ? 12px : 13px;
            vertical-alignment: center;
            height: 100%;
            overflow: elide;
            width: 100%;
        }
    }
    if root.clearable && root.text != "": IconButton {
        x: root.width - 30px;
        size: 24px;
        round: true;
        icon: Icons.x;
        icon-size: 13px;
        clicked => {
            root.text = "";
            root.edited("");
        }
    }
}

// ---- multi-line text area (.px-textarea) ----
// Line numbers for the code editor gutter (Rust: "1\n2\n…" for the text).
export global CodeHelper {
    pure callback gutter(string) -> string;
    pure callback digits(string) -> int;
}

// px-textarea, or (code: true) the Ace YAML editor of MyEditor/Group/Providers:
// tomorrow / tomorrow_night colours, a line-number gutter, no soft wrap.
export component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: true;
    in property <bool> read-only: false;
    in property <bool> code: false;
    // CSS line-height of the web control (px-textarea 1.6, MyEditor 1.7 …).
    in property <float> line-height: 1.6;
    callback edited(string);
    public function focus-input() { ti.focus(); }
    // Select [start, end) (UTF-8 offsets) and scroll its line into view
    // (code mode: no wrap, so a line is one line box).
    public function select-range(start: int, end: int, line: int) {
        ti.set-selection-offsets(start, end);
        if (line >= 0) {
            fl.content-y = max(min(0px, fl.height - fl.content-height), min(0px, -(line * root.line-px) + fl.height / 3));
        }
    }
    public function clear-selection() { ti.clear-selection(); }
    // CSS line-height is relative to the font size, Slint's factor to the
    // font's natural line height (≈ 1.16 × size for Menlo / SF).
    property <float> lh-factor: root.line-height / 1.16;
    // height of one line box (Menlo's natural line ≈ 1.16 × size)
    property <length> line-px: 13px * 1.16 * root.lh-factor;
    property <color> code-bg: Theme.dark ? #1d1f21 : #ffffff;
    property <color> code-fg: Theme.dark ? #c5c8c6 : #4d4d4c;
    // Ace gutter: the numbers right-aligned before the fold-widget column.
    property <length> gutter-w: root.code ? max(2, CodeHelper.digits(root.text)) * 8px + 30px : 0px;
    border-radius: 12px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.border;
    background: root.code ? root.code-bg : Theme.input-bg;
    clip: true;
    if root.code: Rectangle {
        x: 0;
        y: 0;
        width: root.gutter-w;
        height: root.height;
        background: Theme.dark ? #25282c : #f6f6f6;
    }
    gutter := Text {
        visible: root.code;
        x: 0;
        y: fl.y + fl.content-y;
        width: root.gutter-w - 14px;
        text: root.code ? CodeHelper.gutter(root.text) : "";
        horizontal-alignment: right;
        color: root.code-fg;
        font-size: 13px;
        font-family: Theme.mono;
        line-height-factor: root.lh-factor;
    }
    fl := Flickable {
        x: root.code ? root.gutter-w + 4px : 16px;
        y: root.code ? 4px : 14px;
        width: root.width - self.x - (root.code ? 4px : 16px);
        height: root.height - self.y - (root.code ? 4px : 14px);
        content-height: max(self.height, ti.preferred-height + 4px);
        content-width: root.code ? max(self.width, ti.preferred-width + 8px) : self.width;
        ti := TextInput {
            width: root.code ? fl.content-width : fl.width;
            height: max(fl.height, self.preferred-height);
            text <=> root.text;
            wrap: root.code ? no-wrap : word-wrap;
            single-line: false;
            read-only: root.read-only;
            color: root.code ? root.code-fg : Theme.text;
            font-size: 13px;
            font-family: root.mono || root.code ? Theme.mono : "";
            line-height-factor: root.lh-factor;
            selection-background-color: root.code ? (Theme.dark ? #373b41 : #d6d6d6) : Theme.accent.with-alpha(0.35);
            selection-foreground-color: root.code ? root.code-fg : Theme.text;
            edited => { root.edited(self.text); }
        }
        if root.text == "": Text {
            y: 0;
            width: fl.width;
            text: root.placeholder;
            color: Theme.text-3;
            font-size: 13px;
            wrap: word-wrap;
            font-family: root.mono ? Theme.mono : "";
            line-height-factor: root.lh-factor;
        }
    }
}

// ---- scroll area with thin overlay scrollbar ----
export component ScrollArea inherits Rectangle {
    in property <length> pad-left: 0px;
    in property <length> pad-right: 0px;
    in-out property <length> scroll-y <=> fl.content-y;
    out property <length> visible-height: fl.height;
    in property <length> content-height;
    callback scrolled();
    clip: true;
    fl := Flickable {
        width: root.width;
        height: root.height;
        content-height: root.content-height;
        content-width: root.width;
        mouse-drag-pan-enabled: false;
        flicked => { root.scrolled(); }
        @children
    }
    property <bool> overflow: fl.content-height > fl.height + 1px;
    property <length> thumb-h: max(30px, fl.height * fl.height / max(1px, fl.content-height));
    property <length> track: fl.height - self.thumb-h - 4px;
    if root.overflow: Rectangle {
        x: root.width - 9px;
        y: 2px + (fl.content-height > fl.height ? (-fl.content-y / (fl.content-height - fl.height)) * root.track : 0px);
        width: 6px;
        height: root.thumb-h;
        border-radius: 3px;
        background: Theme.text.with-alpha(sb.has-hover || sb.pressed ? 0.6 : (outer.has-hover ? 0.5 : 0.38));
        sb := TouchArea {
            property <length> start-y;
            property <length> start-vp;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.start-vp = fl.content-y;
                }
            }
            moved => {
                if (self.pressed) {
                    fl.content-y = max(fl.height - fl.content-height, min(0px, self.start-vp - (self.mouse-y - self.pressed-y) * (fl.content-height - fl.height) / max(1px, root.track)));
                }
            }
        }
    }
    outer := TouchArea {
        width: 0;
        height: 0;
    }
    public function scroll-to-top() { fl.content-y = 0; }
}

// ---- blurred scrim (--scrim + --scrim-blur: blur(4px)) ----
// Slint cannot blur what is drawn below an element, so when an overlay opens
// Rust renders the window without that overlay (and anything opened after
// it), blurs the picture and publishes it with the request's id. Each overlay
// keeps its own copy: a dialog opened over another one blurs that dialog too,
// as backdrop-filter does, without the lower dialog losing its own backdrop.
export global Backdrop {
    in property <image> image;
    in property <int> image-id: 0;
    in property <bool> capturing: false;
    // While capturing, overlays whose request id is >= this one are hidden.
    in property <int> capture-id: 0;
    // Bumped by Rust when the look behind an open theme dialog changed.
    in property <int> refresh-tick: 0;
    callback request() -> int;
}

// Blurred window picture under the scrim colour, aligned to the window. The
// overlay that contains it shows itself once `ready` and hides while its
// backdrop (or a later one) is being captured.
export component ScrimLayer inherits Rectangle {
    in property <bool> blur: true;
    // The overlay is open (wants to be shown).
    in property <bool> active: true;
    // Re-capture the backdrop while open when this changes.
    in property <int> refresh-key: 0;
    out property <bool> ready: !root.blur || root.got-first;
    out property <bool> hidden-for-capture: root.blur && root.req-id > 0 && Backdrop.capturing && root.req-id >= Backdrop.capture-id;
    property <int> req-id: 0;
    property <bool> got-first: false;
    property <image> pic;
    function ask() {
        if (root.active && root.blur) {
            root.req-id = Backdrop.request();
        }
    }
    init => {
        root.ask();
    }
    changed active => {
        if (root.active) {
            root.got-first = false;
            root.ask();
        }
    }
    changed refresh-key => {
        root.ask();
    }
    property <bool> mine: root.req-id > 0 && Backdrop.image-id == root.req-id;
    changed mine => {
        if (root.mine) {
            root.pic = Backdrop.image;
            root.got-first = true;
        }
    }
    // Zero-size anchor, as in Glass: keeps the window-sized picture out of
    // this element's layout constraints.
    if root.blur && root.pic.width > 0: Rectangle {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        Image {
            x: -root.absolute-position.x;
            y: -root.absolute-position.y;
            width: Theme.win-w;
            height: Theme.win-h;
            source: root.pic;
            image-fit: fill;
        }
    }
    Rectangle { background: Theme.scrim; }
}

// ---- modal shell (UiModal.vue) ----
export component Modal inherits Rectangle {
    in-out property <bool> open;
    in property <string> title;
    in property <image> icon;
    in property <string> tone: "accent";
    in property <length> max-w: 480px;
    in property <bool> close-on-overlay: true;
    in property <bool> show-close: true;
    in property <bool> divided: false;
    in property <bool> has-footer: false;
    in property <bool> scrim-blur: true;
    in property <bool> close-on-esc: true;
    callback closed();
    // The dialog became visible: focus its first field here (a11y.ts focuses
    // the first editable input of a newly opened dialog).
    callback opened();
    callback footer-left-placeholder();
    // Re-capture the blurred backdrop while open (theme dialog).
    in property <int> refresh-key: 0;
    property <bool> shown: self.open && scrim.ready && !scrim.hidden-for-capture;
    visible: self.shown;
    property <bool> appeared: self.open && scrim.ready;
    changed appeared => {
        if (self.appeared) {
            esc.focus();
            root.opened();
        }
    }
    property <color> tone-c: self.tone == "warning" ? Theme.warning : self.tone == "error" ? Theme.error : self.tone == "info" ? Theme.info : self.tone == "success" ? Theme.success : Theme.accent;
    scrim := ScrimLayer { blur: root.scrim-blur; active: root.open; refresh-key: root.refresh-key; }
    // Esc closes the dialog (UiModal registerModal / handleModalEscape) — also
    // from inside a field: the dialog's content lives in this scope, so key
    // events a field does not handle bubble up here.
    esc := FocusScope {
    key-pressed(e) => {
        if (e.text == Key.Escape && root.close-on-esc) {
            root.open = false;
            root.closed();
            return accept;
        }
        return reject;
    }
    TouchArea {
        clicked => {
            if (root.close-on-overlay) {
                root.open = false;
                root.closed();
            }
        }
    }
    card := Rectangle {
        width: min(root.max-w, root.width - 40px);
        height: min(lay.preferred-height, min(780px, root.height - 40px));
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 24px;
        drop-shadow-color: #00000066;
        clip: true;
        TouchArea { }
        lay := VerticalLayout {
            if root.title != "" || root.icon.width > 0: HorizontalLayout {
                padding-left: 22px;
                padding-right: 16px;
                padding-top: root.divided ? 16px : 18px;
                padding-bottom: root.divided ? 14px : 4px;
                spacing: 12px;
                if root.icon.width > 0: Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: root.tone-c.with-alpha(0.16);
                    Icon { source: root.icon; size: 20px; tint: root.tone-c; }
                }
                Text {
                    text: root.title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.show-close: VerticalLayout {
                    alignment: center;
                    IconButton {
                        size: 32px;
                        round: true;
                        icon: Icons.x;
                        icon-size: 16px;
                        tip: T.t("close");
                        clicked => {
                            root.open = false;
                            root.closed();
                        }
                    }
                }
            }
            if root.divided: Divider { }
            @children
        }
    }
    }
}

// Body / footer helpers used inside Modal.
export component ModalBody inherits VerticalLayout {
    in property <bool> divided: false;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: self.divided ? 20px : 14px;
    padding-bottom: self.divided ? 20px : 4px;
    spacing: 12px;
}

export component ModalFooter inherits HorizontalLayout {
    in property <bool> divided: false;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: self.divided ? 14px : 18px;
    padding-bottom: self.divided ? 14px : 20px;
    spacing: 8px;
    alignment: end;
}

// ---- centered notice (UiNotice.vue) ----
export component Notice inherits Rectangle {
    in-out property <bool> open;
    in property <string> title;
    in property <image> icon;
    in property <string> tone: "error";
    in property <length> max-w: 400px;
    in property <bool> close-on-overlay: true;
    in property <bool> large-icon: false;
    in property <bool> close-on-esc: true;
    // <slot name="top">: e.g. the profile logo of SubscriptionAlertModal.
    in property <image> top-image;
    callback closed();
    property <bool> shown: self.open && nscrim.ready && !nscrim.hidden-for-capture;
    visible: self.shown;
    nesc := FocusScope {
        width: 0;
        height: 0;
        key-pressed(e) => {
            if (e.text == Key.Escape && root.close-on-esc) {
                root.open = false;
                root.closed();
                return accept;
            }
            return reject;
        }
    }
    property <bool> appeared: self.open && nscrim.ready;
    changed appeared => {
        if (self.appeared) {
            nesc.focus();
        }
    }
    nscrim := ScrimLayer { active: root.open; }
    property <color> tone-c: self.tone == "warning" ? Theme.warning : self.tone == "error" ? Theme.error : self.tone == "info" ? Theme.info : self.tone == "success" ? Theme.success : Theme.accent;
    TouchArea {
        clicked => {
            if (root.close-on-overlay) {
                root.open = false;
                root.closed();
            }
        }
    }
    Rectangle {
        width: min(root.max-w, root.width - 40px);
        height: min(lay.preferred-height, root.height - 40px);
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 24px;
        drop-shadow-color: #00000066;
        clip: true;
        TouchArea { }
        lay := VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px;
            padding-bottom: 20px;
            spacing: 6px;
            alignment: start;
            // .sub-alert-logo: 30×30, radius 8, contain, 4px below
            if root.top-image.width > 0: HorizontalLayout {
                alignment: center;
                padding-bottom: 4px;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 8px;
                    clip: true;
                    Image { width: 30px; height: 30px; source: root.top-image; image-fit: contain; }
                }
            }
            if root.icon.width > 0: HorizontalLayout {
                alignment: center;
                padding-bottom: 8px;
                Rectangle {
                    width: root.large-icon ? 56px : 48px;
                    height: self.width;
                    border-radius: 12px;
                    background: root.tone-c.with-alpha(0.16);
                    Icon { source: root.icon; size: root.large-icon ? 30px : 24px; tint: root.tone-c; }
                }
            }
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            @children
        }
    }
}

export component NoticeText inherits Text {
    color: Theme.text-2;
    font-size: 13px;
    line-height-factor: 1.5 / 1.16; // .px-notice__text line-height
    horizontal-alignment: center;
    wrap: word-wrap;
}

export component NoticeActions inherits HorizontalLayout {
    padding-top: 16px;
    spacing: 8px;
}

// ---- dropdown items (.px-dd-item) ----
export component DdItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <image> trail-icon;
    in property <bool> selected: false;
    in property <bool> bold: false;
    in property <bool> enabled: true;
    in property <length> pad-v: 8px;
    in property <length> pad-h: 10px;
    in property <color> icon-tint: Theme.text-2;
    in property <bool> check: false;
    callback clicked();
    height: max(32px, lay.preferred-height);
    border-radius: 8px;
    background: self.selected ? Theme.accent.with-alpha(0.14) : (ta.has-hover ? Theme.hover-bg : transparent);
    opacity: self.enabled ? 1 : 0.5;
    lay := HorizontalLayout {
        padding-left: root.pad-h;
        padding-right: root.pad-h;
        padding-top: root.pad-v;
        padding-bottom: root.pad-v;
        spacing: root.bold ? 10px : 8px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: 16px; tint: root.icon-tint; }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.accent : Theme.text;
            font-size: 13px;
            font-weight: root.selected || root.bold ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.trail-icon.width > 0: VerticalLayout {
            alignment: center;
            Icon { source: root.trail-icon; size: 13px; tint: Theme.text-3; }
        }
        if root.check && root.selected: VerticalLayout {
            alignment: center;
            Icon { source: Icons.check; size: 14px; tint: Theme.accent; }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DdSep inherits Rectangle {
    height: 5px;
    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        height: 1px;
        background: Theme.border;
    }
}

// Dropdown panel frame (.px-dd-panel) for PopupWindow contents.
export component DdPanel inherits Rectangle {
    background: Theme.dialog-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    drop-shadow-blur: 40px;
    drop-shadow-offset-y: 16px;
    drop-shadow-color: #00000059;
}

// ---- select (UiSelect.vue) ----
export component Select inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> current;
    in property <string> variant: "field"; // field | pill
    in property <string> placeholder: "—";
    in property <length> menu-width: self.width;
    in property <length> max-menu-height: 260px;
    in property <bool> enabled: true;
    in property <bool> menu-right: false;
    in property <bool> small: false;
    in property <string> tip;
    // UiSelect #prefix slot (e.g. the sort icon in the connections bar).
    in property <image> prefix-icon;
    callback select(string);
    height: self.variant == "pill" ? 36px : (self.small ? 28px : 36px);
    border-radius: self.variant == "pill" ? 18px : 8px;
    border-width: self.variant == "field" ? 1px : 0px;
    border-color: (ta.has-hover || popup-open) && self.enabled ? Theme.accent : Theme.border;
    background: self.variant == "pill" ? (ta.has-hover ? Theme.hover-bg : Theme.panel-soft) : Theme.input-bg;
    opacity: self.enabled ? 1 : 0.55;
    property <bool> popup-open: false;
    HorizontalLayout {
        padding-left: root.variant == "pill" ? 16px : (root.small ? 10px : 12px);
        padding-right: root.variant == "pill" ? 12px : 10px;
        spacing: 8px;
        if root.prefix-icon.width > 0: VerticalLayout {
            alignment: center;
            Icon { source: root.prefix-icon; size: 14px; tint: Theme.text-2; }
        }
        Text {
            text: SelectHelper.label-of(root.options, root.current, root.placeholder);
            color: Theme.text;
            font-size: root.small ? 12px : 13px;
            font-weight: root.variant == "pill" ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.variant == "field" ? Icons.selector : Icons.chevron-down;
                size: root.variant == "field" ? 15px : 14px;
                tint: Theme.text-2;
            }
        }
    }
    ta := TipZone {
        tip: root.tip;
        enabled: root.enabled;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: root.menu-right ? root.width - root.menu-width : 0;
        y: root.height + 8px;
        width: root.menu-width;
        height: min(root.max-menu-height, items.preferred-height + 10px);
        close-policy: close-on-click-outside;
        DdPanel {
            ScrollArea {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: items.preferred-height;
                items := VerticalLayout {
                    spacing: 2px;
                    for o in root.options: DdItem {
                        text: o.label;
                        selected: o.value == root.current;
                        check: true;
                        clicked => {
                            popup.close();
                            if (o.value != root.current) {
                                root.select(o.value);
                            }
                        }
                    }
                }
            }
        }
    }
}

export global SelectHelper {
    pure callback label-of([SelectOption], string, string) -> string;
}

// ---- empty state (UiEmpty.vue) ----
export component Empty inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    in property <string> action-label;
    in property <image> action-icon;
    callback action();
    alignment: center;
    spacing: 8px;
    padding-top: 40px;
    padding-bottom: 40px;
    padding-left: 16px;
    padding-right: 16px;
    HorizontalLayout {
        alignment: center;
        padding-bottom: 4px;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: Theme.panel-soft;
            Icon { source: root.icon; size: 26px; tint: Theme.text-3; }
        }
    }
    Text {
        text: root.title;
        font-size: 14px;
        font-weight: 700;
        color: Theme.text;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.text != "": HorizontalLayout {
        alignment: center;
        Text {
            text: root.text;
            font-size: 13px;
            color: Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 320px;
            line-height-factor: 1.5 / 1.16; // .px-empty__text
        }
    }
    if root.action-label != "": HorizontalLayout {
        alignment: center;
        padding-top: 6px;
        Btn {
            text: root.action-label;
            icon: root.action-icon;
            kind: "primary";
            pill: true;
            clicked => { root.action(); }
        }
    }
}

// ---- skeleton (UiSkeleton.vue) ----
export component Skel inherits Rectangle {
    border-radius: 8px;
    background: Theme.panel-soft;
    opacity: 0.45 + 0.45 * (0.5 + 0.5 * sin(animation-tick() / 1.2s * 360deg));
}

// ---- field label (.px-field) ----
export component FieldLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-2;
}

export component FieldHint inherits Text {
    font-size: 12px;
    color: Theme.text-3;
    wrap: word-wrap;
    line-height-factor: 1.45 / 1.19;
}

// ---- alert (.px-alert) ----
export component Alert inherits Rectangle {
    in property <string> tone: "warning";
    in property <string> text;
    in property <image> icon: Icons.alert-triangle;
    property <color> c: self.tone == "info" ? Theme.info : self.tone == "error" ? Theme.error : Theme.warning;
    background: self.c.with-alpha(0.14);
    border-radius: 8px;
    height: lay.preferred-height;
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon { source: root.icon; size: 15px; tint: root.c; }
        }
        Text {
            text: root.text;
            color: root.c;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
            line-height-factor: 1.5 / 1.19; // .px-alert line-height
        }
    }
}

// ---- settings row (.px-row) ----
export component RowLabel inherits HorizontalLayout {
    in property <string> text;
    in property <string> tip;
    width: 150px;
    spacing: 5px;
    alignment: start;
    Text {
        text: root.text;
        font-size: 13px;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    if root.tip != "": VerticalLayout {
        alignment: center;
        InfoTip { tip: root.tip; }
    }
}
