// Proxies page — port of views/Proxies.vue (full view: one collapsible card
// per group, a grid of node cards inside).
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { Icon, IconButton, TipZone, Spinner, DdPanel, ScrollArea, Empty, Skel } from "components.slint";

export struct ProxyNodeView {
    name: string,
    label: string,
    type-icon: image,
    type-tip: string,
    desc: string,
    desc-tip: string,
    has-weight: bool,
    weight-icon: image,
    weight-tone: int,
    weight-tip: string,
    delay-text: string,
    delay-tone: int,
    selected: bool,
}

export struct ProxyGroupView {
    name: string,
    label: string,
    has-icon: bool,
    icon: image,
    type-icon: image,
    type-tip: string,
    selected: string,
    expanded: bool,
    testing: bool,
    loaded: bool,
    count: int,
    hidden: int,
    nodes: [ProxyNodeView],
}

export global ProxiesP {
    in property <bool> loaded;
    in property <bool> direct;
    in property <[ProxyGroupView]> groups;
    in property <bool> any-open;
    in property <bool> bulk-testing;
    in property <bool> is-hide;
    in property <bool> is-sort;
    callback toggle-all();
    callback test-all();
    callback toggle-hide();
    callback toggle-sort();
    callback toggle-group(string);
    callback test-group(string);
    callback pick(string, string);
    callback show-more(string);
    callback jump(string);
    in-out property <length> scroll-y;
    // jump(): the group to scroll to, applied by its card on the next tick
    in-out property <string> jump-to;
    in-out property <int> jump-tick;
}

component NodeCard inherits Rectangle {
    in property <ProxyNodeView> node;
    callback clicked();
    border-radius: 12px;
    border-width: 1px;
    border-color: self.node.selected ? Theme.accent : (ta.has-hover ? Theme.accent.mix(Theme.border, 0.5) : Theme.border);
    background: self.node.selected ? Theme.accent.mix(Theme.input-bg, 0.14) : Theme.input-bg;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // Fixed rows like the .node flex column: the name line, 8px gap, and a
    // 14px meta row whose items are all centred on the same axis (Slint does
    // not stretch them by the card's spare height this way).
    Text {
        x: 13px;
        y: 11px;
        width: parent.width - 26px;
        height: 15px;
        text: root.node.label;
        font-size: 13px;
        font-weight: 600;
        color: Theme.text;
        overflow: elide;
        vertical-alignment: center;
        TipZone { tip: root.node.label; clicked => { root.clicked(); } }
    }
    HorizontalLayout {
        x: 13px;
        y: 11px + 15px + 8px;
        width: parent.width - 26px;
        height: 14px;
        spacing: 6px;
        Rectangle {
            width: 14px;
            Icon { source: root.node.type-icon; size: 14px; tint: Theme.text-3; }
            TipZone { tip: root.node.type-tip; mouse-cursor: help; }
        }
        if root.node.desc != "": Rectangle {
            horizontal-stretch: 1;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.node.desc;
                font-size: 11px;
                color: Theme.text-3;
                overflow: elide;
                vertical-alignment: center;
                TipZone { tip: root.node.desc-tip; clicked => { root.clicked(); } }
            }
        }
        if root.node.desc == "": Rectangle { horizontal-stretch: 1; }
        if root.node.has-weight: Rectangle {
            width: 13px;
            Icon { source: root.node.weight-icon; size: 13px; tint: Theme.tone(root.node.weight-tone); }
            TipZone { tip: root.node.weight-tip; mouse-cursor: help; }
        }
        Rectangle {
            width: dt.preferred-width;
            dt := Text {
                height: parent.height;
                text: root.node.delay-text;
                font-size: 11px;
                font-weight: 700;
                color: Theme.tone(root.node.delay-tone);
                vertical-alignment: center;
            }
        }
    }
}

component GroupCard inherits Rectangle {
    in property <ProxyGroupView> group;
    in property <length> max-nodes-height;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    background: Theme.input-bg;
    clip: true;
    property <length> gap: 10px;
    property <int> cols: max(1, floor((self.width - 22px + self.gap) / (240px + self.gap)));
    property <length> cw: (self.width - 22px - (self.cols - 1) * self.gap) / self.cols;
    property <length> ch: 61px; // .node: 11 + 15 (name) + 8 + 14 (meta) + 11 + borders
    property <int> items: self.group.nodes.length + (self.group.hidden > 0 ? 1 : 0);
    property <int> rows: ceil(self.items / self.cols);
    property <length> grid-h: self.rows * self.ch + max(0, self.rows - 1) * self.gap;
    property <length> body-h: !self.group.expanded ? 0px : (!self.group.loaded ? 38px : min(self.max-nodes-height, self.grid-h + 18px));
    height: 54px + self.body-h;
    // header
    head := Rectangle {
        y: 0;
        height: 54px;
        background: ht.has-hover ? Theme.hover-bg : transparent;
        ht := TouchArea {
            mouse-cursor: pointer;
            clicked => { ProxiesP.toggle-group(root.group.name); }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 12px;
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 8px;
                        background: Theme.panel-soft;
                        if root.group.has-icon: Image { width: 22px; height: 22px; source: root.group.icon; image-fit: contain; }
                        if !root.group.has-icon: Icon { source: root.group.type-icon; size: 17px; tint: Theme.text-2; }
                        if !root.group.has-icon: TipZone { tip: root.group.type-tip; clicked => { ProxiesP.toggle-group(root.group.name); } }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.group.label;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    if root.group.selected != "": Text {
                        text: T.t("proxies.selected-label") + ": " + root.group.selected;
                        font-size: 12px;
                        color: Theme.text-2;
                        overflow: elide;
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        size: 26px;
                        icon: Icons.brand-speedtest;
                        icon-size: 16px;
                        loading: root.group.testing;
                        tip: T.t("proxies.test-group");
                        clicked => { ProxiesP.test-group(root.group.name); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.chevron-down;
                        size: 16px;
                        tint: Theme.text-2;
                        transform-rotation: root.group.expanded ? 0deg : -90deg;
                        animate transform-rotation { duration: 150ms; }
                    }
                }
            }
        }
    }
    if root.group.expanded && !root.group.loaded: HorizontalLayout {
        y: 54px;
        height: 34px;
        padding-left: 16px;
        spacing: 8px;
        alignment: start;
        VerticalLayout { alignment: center; Spinner { } }
        Text { text: T.t("proxies.loading"); font-size: 13px; color: Theme.text-2; vertical-alignment: center; }
    }
    if root.group.expanded && root.group.loaded: ScrollArea {
        y: 54px;
        x: 16px;
        width: root.width - 22px;
        height: root.body-h;
        content-height: root.grid-h + 18px;
        Rectangle {
            y: 2px;
            height: root.grid-h;
            for node[i] in root.group.nodes: NodeCard {
                x: mod(i, root.cols) * (root.cw + root.gap);
                y: floor(i / root.cols) * (root.ch + root.gap);
                width: root.cw;
                height: root.ch;
                node: node;
                clicked => { ProxiesP.pick(root.group.name, node.name); }
            }
            if root.group.hidden > 0: Rectangle {
                x: mod(root.group.nodes.length, root.cols) * (root.cw + root.gap);
                y: floor(root.group.nodes.length / root.cols) * (root.ch + root.gap);
                width: root.cols * root.cw + (root.cols - 1) * root.gap - self.x;
                height: 36px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                background: mt.has-hover ? Theme.hover-bg : transparent;
                Text {
                    text: T.t1("proxies.show-more", "n", root.group.hidden);
                    font-size: 13px;
                    font-weight: 600;
                    color: mt.has-hover ? Theme.text : Theme.text-2;
                }
                mt := TouchArea { mouse-cursor: pointer; clicked => { ProxiesP.show-more(root.group.name); } }
            }
        }
    }
}

export component ProxiesPage inherits Rectangle {
    VerticalLayout {
        // .px-page-head
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 24px;
            padding-bottom: 12px;
            spacing: 12px;
            Text {
                text: T.t("proxies.title");
                font-size: 24px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                spacing: 6px;
                IconButton {
                    icon: ProxiesP.any-open ? Icons.fold : Icons.selector;
                    icon-size: 17px;
                    tip: ProxiesP.any-open ? T.t("proxies.collapse-all") : T.t("proxies.expand-all");
                    clicked => { ProxiesP.toggle-all(); }
                }
                IconButton {
                    icon: Icons.brand-speedtest;
                    icon-size: 17px;
                    loading: ProxiesP.bulk-testing;
                    tip: T.t("proxies.test");
                    clicked => { ProxiesP.test-all(); }
                }
                IconButton {
                    icon: ProxiesP.is-hide ? Icons.eye-off : Icons.eye;
                    icon-size: 17px;
                    active: ProxiesP.is-hide;
                    tip: ProxiesP.is-hide ? T.t("proxies.hide-on") : T.t("proxies.hide-off");
                    clicked => { ProxiesP.toggle-hide(); }
                }
                IconButton {
                    icon: ProxiesP.is-sort ? Icons.sort-descending : Icons.arrows-sort;
                    icon-size: 17px;
                    active: ProxiesP.is-sort;
                    tip: ProxiesP.is-sort ? T.t("proxies.sort-on") : T.t("proxies.sort-off");
                    clicked => { ProxiesP.toggle-sort(); }
                }
                if ProxiesP.groups.length > 7: VerticalLayout {
                    alignment: center;
                    jb := Rectangle {
                        height: 32px;
                        width: jl.preferred-width;
                        border-radius: 16px;
                        background: jt.has-hover ? Theme.hover-bg : Theme.panel-soft;
                        jl := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout { alignment: center; Icon { source: Icons.list; size: 15px; } }
                            Text { text: T.t("proxies.jump-to-group"); font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                            VerticalLayout { alignment: center; Icon { source: Icons.chevron-down; size: 13px; tint: Theme.text.with-alpha(0.7); } }
                        }
                        jt := TouchArea { mouse-cursor: pointer; clicked => { jp.show(); } }
                        jp := PopupWindow {
                            x: jb.width - 280px;
                            y: 40px;
                            width: 280px;
                            height: min(360px, ProxiesP.groups.length * 36px + 10px);
                            close-policy: close-on-click-outside;
                            DdPanel {
                                ScrollArea {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    content-height: jcol.preferred-height;
                                    jcol := VerticalLayout {
                                        spacing: 2px;
                                        for g in ProxiesP.groups: Rectangle {
                                            height: 34px;
                                            border-radius: 8px;
                                            background: it.has-hover ? Theme.hover-bg : transparent;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                Text { text: g.label; font-size: 13px; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                                Text { text: g.count; font-size: 12px; color: Theme.text-3; vertical-alignment: center; }
                                            }
                                            it := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    jp.close();
                                                    ProxiesP.jump(g.name);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // .proxies-body
        body := ScrollArea {
            vertical-stretch: 1;
            content-height: col.preferred-height;
            scroll-y <=> ProxiesP.scroll-y;
            col := VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 8px;
                padding-bottom: 28px;
                spacing: 12px;
                if !ProxiesP.loaded && !ProxiesP.direct: VerticalLayout {
                    spacing: 12px;
                    for i in 3: Rectangle {
                        height: 60px;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;
                        background: Theme.input-bg;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout { alignment: center; Skel { width: 30px; height: 30px; } }
                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                horizontal-stretch: 1;
                                Rectangle { height: 12px; Skel { x: 0; height: 12px; width: parent.width * 0.32; } }
                                Rectangle { height: 10px; Skel { x: 0; height: 10px; width: parent.width * 0.2; } }
                            }
                            VerticalLayout { alignment: center; Skel { width: 26px; height: 26px; } }
                        }
                    }
                }
                if ProxiesP.direct: Empty {
                    icon: Icons.arrow-right;
                    title: T.t("proxies.direct");
                }
                if ProxiesP.loaded && !ProxiesP.direct && ProxiesP.groups.length == 0: Empty {
                    icon: Icons.rocket;
                    title: T.t("empty.proxies.title");
                    text: T.t("empty.proxies.text");
                }
                if ProxiesP.loaded && !ProxiesP.direct: grp := VerticalLayout {
                    spacing: 12px;
                    for g in ProxiesP.groups: GroupCard {
                        group: g;
                        max-nodes-height: max(180px, body.height - 150px);
                        // box.scrollTo({top: el.offsetTop - 8})
                        property <int> jt: ProxiesP.jump-tick;
                        changed jt => {
                            if (ProxiesP.jump-to == g.name) {
                                ProxiesP.scroll-y = max(min(0px, -(grp.y + self.y - 8px)), min(0px, body.height - col.preferred-height));
                            }
                        }
                    }
                }
            }
        }
    }
}
