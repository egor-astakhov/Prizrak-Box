// Settings → Rule tab — port of views/rule/{Now,Group,Providers,Ignore}.vue.
import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { ListView } from "std-widgets.slint";
import { Icon, IconButton, Btn, TipZone, Spinner, ScrollArea, Modal, ModalBody, ModalFooter, Divider, Input, Select, SelectOption, PillTabs, PillOption, Tag, Card, InfoTip, FieldLabel, TextArea, Empty, Skel, VDivider } from "components.slint";

export struct RuleRow {
    kind: string,
    payload: string,
    proxy: string,
}

export struct ProviderView {
    name: string,
    vehicle: string,
    behavior: string,
    count: string,
    updated: string,
    updated-exact: string,
    updating: bool,
}

export global RulesP {
    in-out property <string> sub: "Now";
    // Now
    in property <[RuleRow]> rules;
    in property <bool> rules-loading;
    in-out property <string> query;
    callback query-edited(string);
    // Group (templates)
    in property <[SelectOption]> templates;
    in property <string> template-id;
    in property <bool> template-on;
    in property <bool> can-delete;
    in-out property <string> template-yaml;
    callback pick-template(string);
    callback save-template();
    callback delete-template();
    callback set-template-on(bool);
    in-out property <bool> add-open;
    in-out property <string> add-title;
    callback add-template();
    // Providers
    in property <[ProviderView]> providers;
    in property <bool> providers-first-load: true;
    in property <bool> providers-loading;
    in property <bool> updating-all;
    in property <string> providers-view: "cards";
    callback set-providers-view(string);
    callback refresh-providers();
    callback update-all();
    callback update-provider(string);
    callback view-provider(string);
    in-out property <bool> viewer-open;
    in property <string> viewer-title;
    in property <bool> viewer-loading;
    in property <string> viewer-content;
    in-out property <string> viewer-search;
    in property <string> viewer-found;
    callback viewer-search-edited(string);
    callback viewer-find(bool);
    in property <int> viewer-sel-start: -1;
    in property <int> viewer-sel-end: -1;
    in property <int> viewer-sel-line: -1;
    in property <int> viewer-sel-tick: 0;
    // Ignore
    in-out property <string> ignore;
    callback save-ignore();
}

component RuleTab inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <image> icon;
    in property <string> tip;
    property <bool> on: RulesP.sub == self.key;
    height: 32px;
    width: l.preferred-width;
    border-radius: 8px;
    border-width: self.on ? 0px : 1px;
    border-color: Theme.border;
    background: self.on ? Theme.accent : Theme.input-bg;
    l := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        VerticalLayout { alignment: center; Icon { source: root.icon; size: 15px; tint: root.on ? Theme.on-accent : (t.has-hover ? Theme.text : Theme.text-2); } }
        Text { text: root.label; font-size: 13px; font-weight: 600; color: root.on ? Theme.on-accent : (t.has-hover ? Theme.text : Theme.text-2); vertical-alignment: center; }
    }
    t := TipZone {
        tip: root.tip;
        clicked => { RulesP.sub = root.key; }
    }
}

component RuleNow inherits VerticalLayout {
    padding-left: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    spacing: 10px;
    HorizontalLayout {
        Input {
            max-width: 340px;
            icon: Icons.search;
            text <=> RulesP.query;
            placeholder: T.t("rule.now.search");
            clearable: true;
            edited(t) => { RulesP.query-edited(t); }
        }
        Rectangle { width: (parent.width - 52px) * 1 / 4.8; }
    }
    Rectangle {
        vertical-stretch: 1;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;
        clip: true;
        VerticalLayout {
            Rectangle {
                height: 36px;
                background: Theme.input-bg;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    Text { width: (parent.width - 52px) * 1.4 / 4.8; text: T.t("rule.now.type").to-uppercase(); font-size: 12px; font-weight: 700; color: Theme.text-3; letter-spacing: 0.48px; vertical-alignment: center; }
                    Text { width: (parent.width - 52px) * 2.4 / 4.8; text: T.t("rule.now.payload").to-uppercase(); font-size: 12px; font-weight: 700; color: Theme.text-3; letter-spacing: 0.48px; vertical-alignment: center; }
                    Text { width: (parent.width - 52px) * 1 / 4.8; text: T.t("rule.now.proxy").to-uppercase(); font-size: 12px; font-weight: 700; color: Theme.text-3; letter-spacing: 0.48px; vertical-alignment: center; }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            if RulesP.rules-loading: HorizontalLayout {
                alignment: center;
                padding: 24px;
                Spinner { }
            }
            ListView {
                vertical-stretch: 1;
                for r[i] in RulesP.rules: Rectangle {
                    height: 35px;
                    background: rt.has-hover ? Theme.hover-bg : (mod(i, 2) == 1 ? Theme.input-bg : transparent);
                    rt := TouchArea { }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        // fixed column widths like grid-template-columns: 1.4fr 2.4fr 1fr —
                        // Slint would size a column by its text otherwise
                        Text { width: (parent.width - 52px) * 1.4 / 4.8; text: r.kind; font-size: 13px; color: Theme.text-2; vertical-alignment: center; overflow: elide; }
                        Text {
                            width: (parent.width - 52px) * 2.4 / 4.8;
                                                        text: r.payload;
                            font-size: 13px;
                            font-family: Theme.mono;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            TipZone { tip: r.payload.character-count > 40 ? r.payload : ""; mouse-cursor: default; }
                        }
                        Text { width: (parent.width - 52px) * 1 / 4.8; text: r.proxy; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; overflow: elide; TipZone { tip: r.proxy; mouse-cursor: default; } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
            }
        }
    }
}

component RuleGroup inherits VerticalLayout {
    padding-left: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    spacing: 10px;
    HorizontalLayout {
        spacing: 10px;
        Select {
            width: 200px;
            options: RulesP.templates;
            current: RulesP.template-id;
            select(v) => { RulesP.pick-template(v); }
        }
        VerticalLayout { alignment: center; VDivider { } }
        Btn { text: T.t("save"); kind: "primary"; clicked => { RulesP.save-template(); } }
        Btn { text: T.t("add"); kind: "input"; clicked => { RulesP.add-title = ""; RulesP.add-open = true; } }
        if RulesP.can-delete: Btn { text: T.t("delete"); kind: "input"; clicked => { RulesP.delete-template(); } }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            PillTabs {
                options: [{ value: "off", label: T.t("off") }, { value: "on", label: T.t("on") }];
                current: RulesP.template-on ? "on" : "off";
                select(v) => { RulesP.set-template-on(v == "on"); }
            }
        }
    }
    TextArea {
        vertical-stretch: 1;
        min-height: 280px;
        code: true;
        line-height: 1.6;
        text <=> RulesP.template-yaml;
    }
}

component ProviderCard inherits Card {
    in property <ProviderView> p;
    // .provider: padding 14px 16px inside the 1px border; tags 8px below the
    // head, divider with 10px margins, rows 4px apart (Providers.vue)
    VerticalLayout {
        padding-left: 17px;
        padding-right: 17px;
        padding-top: 15px;
        padding-bottom: 15px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 8px;
            IconButton { size: 26px; icon: Icons.eye; tip: T.t("rule.providers.viewRules"); clicked => { RulesP.view-provider(root.p.name); } }
            Text { text: root.p.name; font-size: 14px; font-weight: 700; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; TipZone { tip: root.p.name; mouse-cursor: default; } }
            IconButton { size: 26px; icon: Icons.refresh; icon-size: 14px; loading: root.p.updating; tip: T.t("rule.providers.update"); clicked => { RulesP.update-provider(root.p.name); } }
        }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 6px;
            alignment: start;
            if root.p.vehicle != "": Tag { text: root.p.vehicle; }
            if root.p.behavior != "": Tag { text: root.p.behavior; tone: "success"; }
        }
        VerticalLayout { padding-top: 10px; padding-bottom: 10px; Divider { } }
        HorizontalLayout {
            padding-top: 4px;
            Text { text: T.t("rule.providers.ruleCount"); font-size: 12px; color: Theme.text-2; horizontal-stretch: 1; }
            Text { text: root.p.count; font-size: 12px; font-weight: 600; color: Theme.text; }
        }
        HorizontalLayout {
            padding-top: 4px;
            Text { text: T.t("rule.providers.lastUpdate"); font-size: 12px; color: Theme.text-2; horizontal-stretch: 1; }
            Text { text: root.p.updated; font-size: 12px; font-weight: 600; color: Theme.text; TipZone { tip: root.p.updated-exact; mouse-cursor: default; } }
        }
    }
}

component RuleProviders inherits VerticalLayout {
    padding-left: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    spacing: 12px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Btn { text: T.t("rule.providers.refresh"); icon: Icons.refresh; kind: "input"; pill: true; loading: RulesP.providers-loading; enabled: !RulesP.providers-loading; clicked => { RulesP.refresh-providers(); } }
        Btn { text: T.t("rule.providers.updateAll"); icon: Icons.cloud-download; kind: "input"; pill: true; loading: RulesP.updating-all; enabled: !RulesP.updating-all && RulesP.providers.length > 0; clicked => { RulesP.update-all(); } }
    }
    body := ScrollArea {
        vertical-stretch: 1;
        property <length> gap: 14px;
        property <int> cols: max(1, floor((self.width + self.gap) / (240px + self.gap)));
        property <length> cw: (self.width - (self.cols - 1) * self.gap) / self.cols;
        property <length> ch: 133px;
        property <int> n: RulesP.providers-first-load ? 3 : RulesP.providers.length;
        content-height: RulesP.providers-view == "table" && !RulesP.providers-first-load ? tbl.preferred-height : ceil(self.n / self.cols) * (self.ch + self.gap);
        if RulesP.providers-first-load: Rectangle {
            for i in 3: Rectangle {
                x: mod(i, body.cols) * (body.cw + body.gap);
                y: floor(i / body.cols) * (body.ch + body.gap);
                width: body.cw;
                height: body.ch;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 12px;
                background: Theme.input-bg;
                Skel { x: 16px; y: 16px; width: (parent.width - 32px) * 0.55; height: 14px; }
                Skel { x: 16px; y: 40px; width: (parent.width - 32px) * 0.35; height: 10px; }
                Skel { x: 16px; y: parent.height - 36px; width: (parent.width - 32px) * 0.6; height: 10px; }
            }
        }
        if !RulesP.providers-first-load && RulesP.providers.length == 0: Empty {
            width: body.width;
            icon: Icons.list;
            title: T.t("empty.providers.title");
            text: T.t("empty.providers.text");
        }
        if !RulesP.providers-first-load && RulesP.providers-view == "cards": Rectangle {
            for p[i] in RulesP.providers: ProviderCard {
                x: mod(i, body.cols) * (body.cw + body.gap);
                y: floor(i / body.cols) * (body.ch + body.gap);
                width: body.cw;
                height: body.ch;
                p: p;
            }
        }
        tbl := VerticalLayout {
            visible: !RulesP.providers-first-load && RulesP.providers-view == "table" && RulesP.providers.length > 0;
            width: body.width;
            Rectangle {
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 12px;
                clip: true;
                height: tcol.preferred-height;
                tcol := VerticalLayout {
                    Rectangle {
                        height: 36px;
                        background: Theme.input-bg;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            Text { width: (parent.width - 136px) * 2 / 5.4; text: T.t("rule.providers.name").to-uppercase(); font-size: 12px; font-weight: 700; color: Theme.text-3; letter-spacing: 0.48px; vertical-alignment: center; }
                            Rectangle { width: (parent.width - 136px) * 1.4 / 5.4; }
                            Text { width: (parent.width - 136px) * 0.8 / 5.4; text: T.t("rule.providers.ruleCountShort").to-uppercase(); font-size: 12px; font-weight: 700; color: Theme.text-3; letter-spacing: 0.48px; vertical-alignment: center; }
                            Text { width: (parent.width - 136px) * 1.2 / 5.4; text: T.t("rule.providers.updatedAt").to-uppercase(); font-size: 12px; font-weight: 700; color: Theme.text-3; letter-spacing: 0.48px; vertical-alignment: center; }
                            Rectangle { width: 60px; }
                        }
                    }
                    for p in RulesP.providers: Rectangle {
                        height: 42px;
                        Rectangle { y: 0; height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            Text { width: (parent.width - 136px) * 2 / 5.4; text: p.name; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; overflow: elide; }
                            HorizontalLayout {
                                width: (parent.width - 136px) * 1.4 / 5.4;
                                spacing: 6px;
                                alignment: start;
                                if p.vehicle != "": VerticalLayout { alignment: center; Tag { text: p.vehicle; } }
                                if p.behavior != "": VerticalLayout { alignment: center; Tag { text: p.behavior; tone: "success"; } }
                            }
                            Text { width: (parent.width - 136px) * 0.8 / 5.4; text: p.count; font-size: 13px; color: Theme.text; vertical-alignment: center; }
                            Text { width: (parent.width - 136px) * 1.2 / 5.4; text: p.updated; font-size: 13px; color: Theme.text; vertical-alignment: center; TipZone { tip: p.updated-exact; mouse-cursor: default; } }
                            HorizontalLayout {
                                width: 60px;
                                spacing: 4px;
                                VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.eye; icon-size: 14px; tip: T.t("rule.providers.viewRules"); clicked => { RulesP.view-provider(p.name); } } }
                                VerticalLayout { alignment: center; IconButton { size: 26px; icon: Icons.refresh; icon-size: 14px; loading: p.updating; tip: T.t("rule.providers.update"); clicked => { RulesP.update-provider(p.name); } } }
                            }
                        }
                    }
                }
            }
        }
    }
}

component RuleIgnore inherits VerticalLayout {
    padding-left: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    spacing: 10px;
    HorizontalLayout {
        spacing: 10px;
        Btn { text: T.t("save"); kind: "primary"; clicked => { RulesP.save-ignore(); } }
        Text { text: T.t("rule.ignore.tip"); font-size: 12px; color: Theme.text-3; vertical-alignment: center; }
        VerticalLayout { alignment: center; InfoTip { size: 15px; tip: T.t("rule.ignore.info"); } }
        Rectangle { horizontal-stretch: 1; }
    }
    TextArea {
        vertical-stretch: 1;
        min-height: 280px;
        line-height: 1.7;
        text <=> RulesP.ignore;
        placeholder: T.t("rule.ignore.place");
    }
}

export component RulesTab inherits VerticalLayout {
    HorizontalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 14px;
        spacing: 8px;
        RuleTab { key: "Now"; label: T.t("rule.tabs.now"); icon: Icons.list-details; tip: T.t("rule.now.title"); }
        RuleTab { key: "Group"; label: T.t("rule.tabs.group"); icon: Icons.adjustments; tip: T.t("rule.group.title"); }
        RuleTab { key: "Providers"; label: T.t("rule.tabs.providers"); icon: Icons.list; tip: T.t("rule.providers.title"); }
        RuleTab { key: "Ignore"; label: T.t("rule.tabs.ignore"); icon: Icons.ban; tip: T.t("rule.ignore.title"); }
        Rectangle { horizontal-stretch: 1; }
        if RulesP.sub == "Providers": VerticalLayout {
            alignment: center;
            PillTabs {
                options: [{ value: "cards", icon: Icons.layout-grid, tip: T.t("rule.providers.viewCards") }, { value: "table", icon: Icons.list, tip: T.t("rule.providers.viewTable") }];
                current: RulesP.providers-view;
                select(v) => { RulesP.set-providers-view(v); }
            }
        }
    }
    if RulesP.sub == "Now": RuleNow { vertical-stretch: 1; }
    if RulesP.sub == "Group": RuleGroup { vertical-stretch: 1; }
    if RulesP.sub == "Providers": RuleProviders { vertical-stretch: 1; }
    if RulesP.sub == "Ignore": RuleIgnore { vertical-stretch: 1; }
}

export component RulesDialogs inherits Rectangle {
    Modal {
        opened => { first-field-1.focus-input(); }
        open <=> RulesP.add-open;
        title: T.t("rule.group.add.new");
        max-w: 420px;
        ModalBody {
            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: T.t("rule.group.add.title"); }
                first-field-1 := Input { text <=> RulesP.add-title; placeholder: T.t("rule.group.add.placeholder"); accepted => { RulesP.add-template(); } }
            }
        }
        ModalFooter {
            Btn { text: T.t("cancel"); clicked => { RulesP.add-open = false; } }
            Btn { text: T.t("add"); kind: "primary"; clicked => { RulesP.add-template(); } }
        }
    }
    Modal {
        opened => { first-field-2.focus-input(); }
        open <=> RulesP.viewer-open;
        max-w: 640px;
        HorizontalLayout {
            padding-left: 22px;
            padding-right: 16px;
            padding-top: 18px;
            padding-bottom: 4px;
            spacing: 10px;
            Text { text: RulesP.viewer-title; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            first-field-2 := Input {
                width: 200px;
                horizontal-stretch: 0;
                small: true;
                icon: Icons.search;
                text <=> RulesP.viewer-search;
                placeholder: T.t("rule.providers.rulesSearch");
                edited(t) => { RulesP.viewer-search-edited(t); }
                accepted => { RulesP.viewer-find(true); }
            }
            if RulesP.viewer-found != "": Text { text: RulesP.viewer-found; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
            VerticalLayout { alignment: center; IconButton { size: 28px; icon: Icons.chevron-up; enabled: RulesP.viewer-search != ""; tip: T.t("rule.providers.prevMatch"); clicked => { RulesP.viewer-find(false); } } }
            VerticalLayout { alignment: center; IconButton { size: 28px; icon: Icons.chevron-down; enabled: RulesP.viewer-search != ""; tip: T.t("rule.providers.nextMatch"); clicked => { RulesP.viewer-find(true); } } }
            VerticalLayout { alignment: center; IconButton { size: 32px; round: true; icon: Icons.x; icon-size: 16px; tip: T.t("close"); clicked => { RulesP.viewer-open = false; } } }
        }
        // stock .px-modal__body padding: :deep(.rules-body) misses the teleported modal
        ModalBody {
            if RulesP.viewer-loading: HorizontalLayout { alignment: center; padding-top: 40px; padding-bottom: 40px; Spinner { size: 18px; } }
            if !RulesP.viewer-loading && RulesP.viewer-content == "": Text { text: T.t("rule.providers.rulesEmpty"); font-size: 13px; color: Theme.text-2; horizontal-alignment: center; height: 99px; vertical-alignment: center; }
            if !RulesP.viewer-loading && RulesP.viewer-content != "": TextArea {
                height: 460px;
                code: true;
                line-height: 1.3;
                text: RulesP.viewer-content;
                read-only: true;
                // the match picked by viewer search (editor.find)
                property <int> sel-tick: RulesP.viewer-sel-tick;
                changed sel-tick => {
                    if (RulesP.viewer-sel-start >= 0) {
                        self.select-range(RulesP.viewer-sel-start, RulesP.viewer-sel-end, RulesP.viewer-sel-line);
                    } else {
                        self.clear-selection();
                    }
                }
            }
        }
    }
}
